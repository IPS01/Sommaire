// toutes visent la ligne 36 et l'en-tête les recouvre.
table.cell(info, 0, 36, "Les vingt savanes (tendance / bruit → score / seuil)", text_size = size.small, bgcolor = color.new(color.gray, 80))
table.cell(info, 1, 36, (tabCompact ? "détail replié · " : "") + str.tostring(nSurv) + " surveillées · migration : " + migrTxt, text_size = size.small, bgcolor = color.new(color.gray, 80))

// ============================================================================
// LA BANQUE D'ALERTES DU SOUVERAIN
// ============================================================================
alertcondition(doPlus, "Roi : poussée haussière", "Le Roi de la Savane augmente son exposition haussière")
alertcondition(doMoins, "Roi : poussée baissière", "Le Roi de la Savane réduit ou inverse son exposition")
alertcondition(naissance, "Roi : naissance d'une espèce", "Une espèce est morte de faim, son enfant muté vient de naître")
alertcondition(choc, "Roi : choc immunitaire", "Mouvement anormal détecté, bouclier levé, exposition réduite de moitié")
alertcondition(savaneOk and not savaneOk[1], "Roi : la savane redevient propice", "Le territoire local redevient chassable")
alertcondition(not savaneOk and savaneOk[1], "Roi : la savane devient stérile", "Le territoire local se referme, migration conseillée dans le tableau")
alertcondition(torpeurLibre < 0.5 and torpeurLibre[1] >= 0.5, "Roi : torpeur profonde", "La perte depuis le sommet dépasse la moitié de la borne mortelle")
alertcondition(torpeurLibre <= 0 and torpeurLibre[1] > 0, "Roi : borne mortelle franchie", "Perte maximale atteinte : la chasse tombe à son plancher, elle ne s'arrête pas — sinon le capital ne pourrait plus jamais remonter")
alertcondition(eteint and not eteint[1], "Roi : EXTINCTION DÉFINITIVE", "Plancher de survie franchi : plus aucune exposition, pour toujours")
alertcondition(dirChasse != 0 and dirChasse[1] == 0, "Roi : la meute charge", "Quorum atteint et proie suffisante : la meute charge")
alertcondition(dirChasse == 0 and dirChasse[1] != 0, "Roi : retour à l'affût", "Quorum perdu ou proie trop maigre : la meute cesse de chasser")
alertcondition(not quorumOk and quorumOk[1], "Roi : la meute se divise", "Les deux camps s'équilibrent : plus aucun avis collectif, la chasse s'arrête")
alertcondition(sig11 > 0 and sig11[1] <= 0, "Roi : festin de la Hyène", "Capitulation détectée : la Hyène entre sur la carcasse")
alertcondition(sig16 > 0 and sig16[1] <= 0, "Roi : le Vautour descend", "Effondrement profond : le Vautour descend sur le grand charnier")
alertcondition(fourmisAlerte and not fourmisAlerte[1], "Roi : les fourmis sentent l'orage", "Le bruit court dépasse 1,5 fois le bruit de fond : un choc approche statistiquement")
alertcondition(abeillesAlerte and not abeillesAlerte[1], "Roi : les abeilles fuient la ruche", "Tempête systémique : les savanes surveillées tremblent ensemble")
alertcondition(decroche and not decroche[1], "Roi : le miroir décroche", "Le présent ne tient plus la promesse du passé : convoquer le conseil, geler toute montée en charge")
alertcondition(srBest > 0 and srBest[1] <= 0, "Roi : une savane redevient grasse", "Au moins un territoire surveillé repasse au-dessus de son propre seuil")
alertcondition(alarmeProfil and not alarmeProfil[1], "Roi : profil incohérent", "Des réglages d'action sont appliqués à un actif qui n'en est pas un : lisez la ligne rouge du tableau")
alertcondition(freinOnE and freinReel < 1.0 and freinReel[1] >= 1.0, "Roi : le frein réel mord", "Le facteur de profit réalisé est passé sous 1 : la colonie est bridée. Vérifiez la commission réglée dans Propriétés.")
alertcondition(desertOn and not desertOn[1], "Roi : la meute entre dans le désert", "Savane jugée stérile : la meute chasse quand même, à exposition réduite")
alertcondition(not desertOn and desertOn[1], "Roi : la meute sort du désert", "La savane redevient grasse : la meute reprend sa pleine exposition")

// ============================================================================
// LA CORRECTION DE POUSSÉE — UN SEUL BLOC, UNE SEULE LIGNE INDENTÉE
//
// POURQUOI UN SEUL : la version précédente avait DEUX blocs « if », l'un pour
// acheter, l'autre pour vendre. Collée depuis un téléphone, l'indentation du
// second a glissé et « if doMoins » s'est retrouvé IMBRIQUÉ dans « if doPlus ».
// Or les deux sont mutuellement exclusifs : imbriqué, l'ordre de vente ne peut
// JAMAIS s'exécuter. La colonie ne pouvait plus qu'acheter — jamais alléger,
// jamais sortir, jamais inverser. Test NVIDIA 1W : cinq trades clôturés en dix
// ans, position jamais réduite, -13 496 € et fonds propres négatifs, pendant
// que la meute affichait des formes de +90 pb par bougie. La main était
// paralysée, pas l'écosystème.
//
// Désormais : UN bloc, UNE ligne indentée, et c'est la DERNIÈRE du fichier.
// Il n'y a plus rien après elle qui puisse s'y imbriquer. Le sens de l'ordre
// est porté par une ternaire à l'intérieur de la ligne, pas par la structure.
// doPlus et doMoins ne peuvent pas être vrais en même temps (l'un exige
// diffQty > seuil, l'autre -diffQty > seuil, avec seuil > 0).
// ============================================================================
if doPlus or doMoins
    strategy.order(doPlus ? "Pousse+" : "Pousse-", doPlus ? strategy.long : strategy.short, qty = math.abs(diffQty), comment = "cap " + str.tostring(100 * fCible, "#") + "%", alert_message = "RoiSavane " + (doPlus ? "HAUSSE" : "BAISSE") + " exposition vers " + str.tostring(100 * fCible, "#.#") + "% " + syminfo.ticker)
