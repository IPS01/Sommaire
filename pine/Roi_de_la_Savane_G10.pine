eauCol = eauCum > 0.2 * math.max(strategy.netprofit, 1.0) ? color.new(color.orange, 75) : color.new(color.gray, 85)
miroirTxt = "présent " + str.tostring(100 * retPresent, "#.#") + " % / fenêtre · rythme historique " + str.tostring(100 * retRythme, "#.#") + " %" + (decroche ? " ⚠ DÉCROCHAGE" : " ✓ cohérent")
miroirCol = decroche ? color.new(color.red, 70) : color.new(color.teal, 82)
essaimTxt = "fourmis " + (fourmisAlerte ? "⚡ orage" : "calmes") + (fourmisOn ? "" : " (obs.)") + " · abeilles " + (abeillesAlerte ? "⚡ tempête" : "calmes") + (abeillesOn ? "" : " (obs.)") + " · sol " + (solTraitre ? "traître" : "sain") + " · anticorps " + str.tostring(anticorps, "#.#") + (immAcqOn ? " (armés)" : " (obs.)")
essaimCol = fourmisAlerte or abeillesAlerte or solTraitre ? color.new(color.orange, 75) : color.new(color.gray, 85)

