var table info = table.new(position.top_right, 2, 57, border_width = 1)
table.cell(info, 0, 0, "État de l'écosystème", text_size = size.small, bgcolor = color.new(color.orange, 80))
table.cell(info, 1, 0, diagTxt, text_size = size.small, bgcolor = diagCol)
table.cell(info, 0, 1, "Exposition cible / réelle", text_size = size.small, bgcolor = color.new(color.blue, 80))
table.cell(info, 1, 1, pousseTxt, text_size = size.small, bgcolor = pousseCol)
table.cell(info, 0, 2, "Espèce (rythme · génération · forme · part)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 2, "vivante = verte, affamée = grise", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 0, 3, "Tendance", text_size = size.small, bgcolor = c12c)
table.cell(info, 1, 3, e12, text_size = size.small, bgcolor = c12c)
table.cell(info, 0, 4, "Tendance", text_size = size.small, bgcolor = c1c)
table.cell(info, 1, 4, e1, text_size = size.small, bgcolor = c1c)
table.cell(info, 0, 5, "Tendance", text_size = size.small, bgcolor = c2c)
table.cell(info, 1, 5, e2, text_size = size.small, bgcolor = c2c)
table.cell(info, 0, 6, "Tendance", text_size = size.small, bgcolor = c13c)
table.cell(info, 1, 6, e13, text_size = size.small, bgcolor = c13c)
table.cell(info, 0, 7, "Tendance", text_size = size.small, bgcolor = c3c)
table.cell(info, 1, 7, e3, text_size = size.small, bgcolor = c3c)
table.cell(info, 0, 8, "Tendance", text_size = size.small, bgcolor = c4c)
table.cell(info, 1, 8, e4, text_size = size.small, bgcolor = c4c)
table.cell(info, 0, 9, "Tendance", text_size = size.small, bgcolor = c14c)
table.cell(info, 1, 9, e14, text_size = size.small, bgcolor = c14c)
table.cell(info, 0, 10, "Tendance", text_size = size.small, bgcolor = c5c)
table.cell(info, 1, 10, e5, text_size = size.small, bgcolor = c5c)
table.cell(info, 0, 11, "Contraire", text_size = size.small, bgcolor = c6c)
table.cell(info, 1, 11, e6, text_size = size.small, bgcolor = c6c)
table.cell(info, 0, 12, "Contraire", text_size = size.small, bgcolor = c15c)
table.cell(info, 1, 12, e15, text_size = size.small, bgcolor = c15c)
table.cell(info, 0, 13, "Contraire", text_size = size.small, bgcolor = c7c)
table.cell(info, 1, 13, e7, text_size = size.small, bgcolor = c7c)
table.cell(info, 0, 14, "Contraire", text_size = size.small, bgcolor = c8c)
table.cell(info, 1, 14, e8, text_size = size.small, bgcolor = c8c)
table.cell(info, 0, 15, "Fossile", text_size = size.small, bgcolor = c9c)
table.cell(info, 1, 15, e9, text_size = size.small, bgcolor = c9c)
table.cell(info, 0, 16, "Fossile", text_size = size.small, bgcolor = c10c)
table.cell(info, 1, 16, e10, text_size = size.small, bgcolor = c10c)
table.cell(info, 0, 17, "Charognard", text_size = size.small, bgcolor = c11c)
table.cell(info, 1, 17, e11, text_size = size.small, bgcolor = c11c)
table.cell(info, 0, 18, "Charognard", text_size = size.small, bgcolor = c16c)
table.cell(info, 1, 18, e16, text_size = size.small, bgcolor = c16c)
table.cell(info, 0, 19, "Système immunitaire", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 19, immTxt, text_size = size.small, bgcolor = immCol)
table.cell(info, 0, 20, "État civil (naissances / doyenne)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 20, str.tostring(naissances) + " naissances · doyenne " + str.tostring(doyenne) + " bougies", text_size = size.small)
table.cell(info, 0, 21, "Volatilité réalisée → levier", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 21, str.tostring(100 * sigA, "#.#") + " % → ×" + str.tostring(levVol, "#.##") + " (plafond ×" + str.tostring(expoMaxE, "#.#") + ")", text_size = size.small)
table.cell(info, 0, 22, "Trades / réussite", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 22, str.tostring(strategy.closedtrades) + " / " + str.tostring(winRate, "#.#") + " %", text_size = size.small)
table.cell(info, 0, 23, "Profit factor", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 23, na(pf) ? "—" : str.tostring(pf, "#.##"), text_size = size.small)
table.cell(info, 0, 24, "Profit net · frein réel", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 24, str.tostring(strategy.netprofit, "#.##") + " · " + (not freinOnE ? "frein désarmé" : strategy.closedtrades < 30 ? "frein en attente (" + str.tostring(strategy.closedtrades) + "/30 trades)" : freinReel >= 1.0 ? "✓ la colonie gagne" : freinReel >= 0.5 ? "⚠ BRIDÉE de moitié (PF " + str.tostring(pfReel, "#.##") + ")" : "✗ RÉDUITE AU QUART (PF " + str.tostring(pfReel, "#.##") + ")"), text_size = size.small, bgcolor = freinOnE and strategy.closedtrades >= 30 and freinReel < 1.0 ? color.new(color.red, 70) : color.new(color.gray, 85))
table.cell(info, 0, 25, "Température (perte / borne " + str.tostring(ddMaxE, "#") + " %)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 25, tempTxt, text_size = size.small, bgcolor = tempCol)
table.cell(info, 0, 26, "Tendance de fond", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 26, fondTxt, text_size = size.small, bgcolor = color.new(color.blue, 85))
table.cell(info, 0, 27, "Le lion (alpha, part ^" + str.tostring(hierarchieE, "#.#") + ")", text_size = size.small, bgcolor = color.new(color.orange, 75))
table.cell(info, 1, 27, alphaNom, text_size = size.small, bgcolor = color.new(color.orange, 85))
table.cell(info, 0, 28, "Météo de la savane locale", text_size = size.small, bgcolor = color.new(color.orange, 75))
table.cell(info, 1, 28, meteoTxt, text_size = size.small, bgcolor = meteoCol)
table.cell(info, 0, 29, "L'Homme (souverain)", text_size = size.small, bgcolor = color.new(color.purple, 70))
table.cell(info, 1, 29, pacteAbri ? "a ordonné l'abri — la savane attend son retour" : "laisse régner ses lois : il légifère, il alloue, il n'intervient pas", text_size = size.small, bgcolor = color.new(color.purple, 85))
table.cell(info, 0, 30, "L'eau (financement du levier)", text_size = size.small, bgcolor = eauCol)
table.cell(info, 1, 30, eauTxt, text_size = size.small, bgcolor = eauCol)
table.cell(info, 0, 31, "Le miroir (présent vs passé)", text_size = size.small, bgcolor = miroirCol)
table.cell(info, 1, 31, miroirTxt, text_size = size.small, bgcolor = miroirCol)
table.cell(info, 0, 32, "L'essaim (sentinelles)", text_size = size.small, bgcolor = essaimCol)
table.cell(info, 1, 32, essaimTxt, text_size = size.small, bgcolor = essaimCol)
table.cell(info, 0, 33, "Profil de chasse", text_size = size.small, bgcolor = profCol)
table.cell(info, 1, 33, profTxt, text_size = size.small, bgcolor = profCol)
table.cell(info, 0, 34, "Conviction de la meute", text_size = size.small, bgcolor = convCol)
table.cell(info, 1, 34, convTxt, text_size = size.small, bgcolor = convCol)
table.cell(info, 0, 35, "Le désert (chasser quand même)", text_size = size.small, bgcolor = bipCol)
table.cell(info, 1, 35, bipTxt, text_size = size.small, bgcolor = bipCol)
table.cell(info, 0, rs1, sym1, text_size = size.small, bgcolor = sc1c)
table.cell(info, 1, rs1, s1t, text_size = size.small, bgcolor = sc1c)
table.cell(info, 0, rs2, sym2, text_size = size.small, bgcolor = sc2c)
