// ------------------------------------------------------ Période de backtest
startDate = input.time(timestamp("1 Jan 2016 00:00 +0000"), "Début", group = "Période de backtest")
endDate = input.time(timestamp("1 Jan 2035 00:00 +0000"), "Fin", group = "Période de backtest")

inDate = time >= startDate and time <= endDate

// ============================================================================
// LA CLASSE D'ACTIF, PUIS LE PROFIL : LE ROI SAIT SUR QUELLE TERRE IL EST POSÉ
// ============================================================================
tick = str.upper(syminfo.ticker)
estMetal = str.contains(tick, "XAU") or str.contains(tick, "XAG") or str.contains(tick, "XPT") or str.contains(tick, "XPD") or str.contains(tick, "GOLD") or str.contains(tick, "SILVER")
estEnergie = str.contains(tick, "OIL") or str.contains(tick, "BRENT") or str.contains(tick, "NGAS") or str.contains(tick, "WTI")
estCrypto = syminfo.type == "crypto" or str.contains(tick, "BTC") or str.contains(tick, "ETH")
estIndice = syminfo.type == "index" or str.contains(tick, "SPX") or str.contains(tick, "NDX") or str.contains(tick, "DXY")
estForex = (syminfo.type == "forex" or syminfo.type == "cfd") and not estMetal and not estEnergie and not estIndice and not estCrypto
classeAuto = estMetal ? "métaux" : estCrypto ? "crypto" : estEnergie ? "énergie" : estForex ? "forex" : estIndice ? "indices" : "actions"
classe = classeMan == "automatique" ? classeAuto : classeMan
profAuto = classe == "forex" ? "Forex" : classe == "métaux" ? "Or & métaux" : "Actions & indices (réglage NVIDIA)"
prof = legacy ? "Manuel (mes réglages ci-dessous)" : profil == "Automatique (selon la classe d'actif)" ? profAuto : profil
pAct = prof == "Actions & indices (réglage NVIDIA)"
pMet = prof == "Or & métaux"
pFx = prof == "Forex"

// ============================================================================
// LES TROIS PROFILS
//
// ACTIONS & INDICES — le réglage NVIDIA, tel qu'il est en production. Terrain
//   exigeant (score 0,99) mais dérive haussière structurelle respectée, lion
//   tyrannique, pas de Bip-Bip : la meute attend la vraie tendance et charge
//   fort quand elle vient. Ces valeurs sont AUSSI les valeurs par défaut des
//   groupes de réglages : passer en Manuel, c'est partir d'ici.
//
// OR & MÉTAUX — l'or tend fort mais a passé 2013-2015 en baisse de 40 % : le
//   filtre de tendance de fond saute, le seuil de savane descend à 0,45, et le
//   Bip-Bip prend le relais quand le territoire se ferme. Frais de sélection
//   ramenés au spread réel du CFD (0,04 %).
//
// FOREX — le terrain le plus pauvre en tendance et le moins cher en frais.
//   Seuil de savane à 0,25, jauge d'entropie coupée, filtre de fond coupé
//   (une devise n'a pas de dérive structurelle), frais de sélection au spread
//   réel (0,015 %), et la meute chasse aussi dans le désert.
//
//   LE LEVIER Y EST BRIDÉ, et c'est délibéré. Une cible de volatilité se
//   traduit en levier par « cible / volatilité de l'actif » : 60 % de cible
//   sur un EURJPY qui respire à 6,4 % donnait x9,4, soit 940 % du capital
//   exposé sur une paire de devises à pleine conviction. La cible tombe à
//   25 % et le plafond à x4 : sur une paire à 6-8 % de volatilité, cela donne
//   x3 à x4 — un vrai programme de change, pas un pari.
//
//   LE PLAFOND CONTRARIEN REDESCEND À 65 %. Je l'avais monté à 95 % sur la foi
//   d'une seule capture EURUSD où les contrariennes gagnaient. Sur l'EURJPY,
//   résultat : Serpent 32 %, Chouette 32 %, Renard 28 % — la meute entière
//   devenue un banc de contrariennes vendant à découvert un marché qui monte.
//   À 65 %, les espèces de tendance gardent toujours un tiers de la table.
// ============================================================================
savaneMinE = pFx ? 0.25 : pMet ? 0.45 : pAct ? 0.99 : savaneMin
entMaxE = pFx ? 1.0 : pMet ? 1.0 : pAct ? 0.995 : entMax
targetVolE = pFx ? 25.0 : pMet ? 40.0 : pAct ? 100.0 : targetVol
expoMaxE = pFx ? 4.0 : pMet ? 5.0 : pAct ? 10.0 : expoMax
proieMinE = pFx ? 0.12 : pMet ? 0.20 : pAct ? 0.35 : proieMin
fraisE = pFx ? 0.015 : pMet ? 0.04 : pAct ? 0.1 : frais
respectFondE = pFx ? false : pMet ? false : pAct ? true : respectFond
contMaxE = pFx ? 65.0 : pMet ? 70.0 : pAct ? 80.0 : contMax
hierarchieE = pFx ? 3.0 : pMet ? 3.5 : pAct ? 4.0 : hierarchie
// LE PROFIL ACTIONS EST VOTRE CONFIGURATION NVIDIA DE PRODUCTION, ET RIEN
// D'AUTRE. Tout organe inventé par la G10 — quorum, voix de la meute, frein
// réel, désert, Bip-Bip, normalisation — y est NEUTRE. Vous ne m'avez pas
// demandé de les y ajouter, et le chiffre de référence des 9 M a été obtenu
// sans eux. Ils s'arment sur les profils où le problème se posait : le forex
// et les métaux. Sur actions, à vous de les cocher si vous le voulez.
voixE = legacy ? false : pFx ? true : pMet ? true : pAct ? false : voixMeute
freinOnE = legacy ? false : pAct ? false : freinOn
memSommetE = legacy ? 500 : pAct ? 500 : pFx or pMet ? 0 : memSommet
convNormE = legacy ? false : pFx ? true : pMet ? true : pAct ? false : convNorm
swapE = pFx ? 2.0 : pMet ? 3.0 : pAct ? 3.0 : swapAnnuel
respireE = pFx ? 5 : pMet ? 4 : pAct ? 5 : respire
ddMaxE = pFx ? 50.0 : pMet ? 50.0 : pAct ? 50.0 : ddMax
chocDureeE = pFx ? 1 : pMet ? 1 : pAct ? 1 : chocDuree
// Le quorum et la voix de la meute mesurent la MÊME grandeur : |camp pour -
// camp contre| / total. Quand la voix décide, c'est la proie minimale qui
// sert de porte unique — sinon la même condition serait testée deux fois avec
// deux seuils différents, et le plus haut des deux gagnerait en silence.
quorumMinE = legacy or voixE ? 0.0 : pFx ? 15.0 : pMet ? 15.0 : pAct ? 0.0 : quorumMin
chasseDesertE = legacy ? false : pFx ? true : pMet ? true : pAct ? false : chasseDesert
bipOnE = legacy ? false : pFx ? true : pMet ? true : pAct ? false : bipOn
bipDesertE = (pFx ? 100.0 : pMet ? 75.0 : pAct ? 0.0 : bipDesert) / 100
bipGainE = pFx ? 3.5 : pMet ? 3.0 : pAct ? 3.0 : bipGain
bipLibreE = pFx or pMet ? true : pAct ? false : bipLibre

// ============================================================================
// LE CALENDRIER : COMBIEN DE BOUGIES DANS UNE ANNÉE ?
// La G9 supposait 252 partout et annualisait la volatilité en jours
// calendaires. Deux erreurs opposées qui se compensaient mal.
// ============================================================================
lbAn = timeframe.ismonthly ? 12 : timeframe.isweekly ? 52 : 252
// ============================================================================
// LA FENÊTRE LONGUE : MÊME NOMBRE, AUTRE GRANDEUR — ET C'EST LE TROU DE NVDA.
// La G9 comptait 252 bougies quelle que soit l'unité de temps. La G10 ramène
// la fenêtre à une année RÉELLE (52 en hebdomadaire) pour que le score soit un
// vrai t-statistique, comparable d'une unité de temps à l'autre. En soi c'est
// plus juste. Mais ça change l'ÉCHELLE du score, donc le SENS de votre seuil.
//
//   NVIDIA 1W, fenêtre G9 (252 bougies = 5 ans de hausse) :
//     tendance ~ +2000 %, bruit ~ 1,1  ->  score ~ 18
//     seuil 0,99 : franchi en permanence, la meute chasse tout le temps.
//   NVIDIA 1W, fenêtre G10 (52 bougies = 1 an) :
//     tendance ~ log(2) = 0,69, bruit ~ 0,50  ->  score ~ 1,4
//     seuil 0,99 : une vraie porte, qui se referme une semaine sur deux.
//     Votre capture le montre en clair : score 0,72 < 0,99, savane STÉRILE,
//     exposition +0 % — sur NVIDIA, en pleine tendance haussière.
//
// Votre 0,99 a été validé sur l'échelle de la G9. Je l'ai laissé tel quel en
// changeant l'échelle sous lui : le nombre est resté, le réglage a disparu.
// Le profil actions garde donc la fenêtre G9. Le forex et les métaux gardent
// le t-statistique, parce que leurs seuils (0,25 et 0,45) ont été posés sur
// CETTE échelle-là. Un seuil ne veut rien dire sans la grandeur qu'il mesure.
lbSav = legacy or pAct ? 252 : lbAn
lbFond = legacy or pAct ? 252 : lbAn
barsAn = timeframe.ismonthly ? 12.0 : timeframe.isweekly ? 52.0 : timeframe.isdaily ? 252.0 : 252.0 * 86400.0 / math.max(60.0, timeframe.in_seconds())
annuF = legacy ? 31536000.0 / math.max(60.0, timeframe.in_seconds()) : barsAn

// ============================================================================
// LE TERRAIN DE CHASSE : MESURES DE BASE
// ============================================================================
v = math.log(close / nz(close[1], close))
sdBar = ta.stdev(v, 50)
lamF = math.pow(0.5, 1.0 / fitMem)
fr = fraisE / 100
ready = bar_index > 300

// ============================================================================
// LE GÉNOME : RYTHME DE CHAQUE ESPÈCE (mutable, borné par son habitat)
// ============================================================================
var int L1 = 10
var int L2 = 21
var int L3 = 63
var int L4 = 126
var int L5 = 252
var int L6 = 2
var int L7 = 5
var int L8 = 10
var int g1 = 1
var int g2 = 1
var int g3 = 1
var int g4 = 1
var int g5 = 1
var int g6 = 1
var int g7 = 1
var int g8 = 1
var int age1 = 0
var int age2 = 0
var int age3 = 0
var int age4 = 0
var int age5 = 0
var int age6 = 0
var int age7 = 0
var int age8 = 0
var float stv1 = 0.0
var float stv2 = 0.0
var float stv3 = 0.0
var float stv4 = 0.0
var float stv5 = 0.0
var float stv6 = 0.0
var float stv7 = 0.0
var float stv8 = 0.0
var int L12 = 8
var int L13 = 30
var int L14 = 150
var int L15 = 3
var int g12 = 1
var int g13 = 1
var int g14 = 1
var int g15 = 1
var int age12 = 0
var int age13 = 0
var int age14 = 0
var int age15 = 0
var int L17 = 3
var int g17 = 1
var int age17 = 0
var float stv17 = 0.0
var float stv12 = 0.0
var float stv13 = 0.0
var float stv14 = 0.0
var float stv15 = 0.0

// ============================================================================
// L'INSTINCT GRADUÉ : conviction = mouvement / bruit, bornée à ±1
// ============================================================================
d1 = sdBar * math.sqrt(L1)
d2 = sdBar * math.sqrt(L2)
d3 = sdBar * math.sqrt(L3)
d4 = sdBar * math.sqrt(L4)
d5 = sdBar * math.sqrt(L5)
d6 = sdBar * math.sqrt(L6)
d7 = sdBar * math.sqrt(L7)
d8 = sdBar * math.sqrt(L8)
sig1 = d1 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L1], close)) / d1)) : 0.0
sig2 = d2 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L2], close)) / d2)) : 0.0
sig3 = d3 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L3], close)) / d3)) : 0.0
sig4 = d4 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L4], close)) / d4)) : 0.0
sig5 = d5 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L5], close)) / d5)) : 0.0
sig6 = d6 > 0 ? -math.max(-1.0, math.min(1.0, math.log(close / nz(close[L6], close)) / d6)) : 0.0
sig7 = d7 > 0 ? -math.max(-1.0, math.min(1.0, math.log(close / nz(close[L7], close)) / d7)) : 0.0
sig8 = d8 > 0 ? -math.max(-1.0, math.min(1.0, math.log(close / nz(close[L8], close)) / d8)) : 0.0

// ---------------- LES FOSSILES : DEUX CHASSEURS ANCIENS, EXEMPTS D'ÉVOLUTION
// NOTE : l'Aigle lit sym10 (l'indice dollar par défaut) parce que c'est SON
// instinct, pas parce que c'est une savane. Décocher la savane 10 la retire
// de la migration et de la ruche, mais n'aveugle pas l'Aigle : une espèce et
// un territoire sont deux choses distinctes.
cAigle = request.security(sym10, timeframe.period, close)
vAigle = math.log(cAigle / nz(cAigle[1], cAigle))
sdAigle = ta.stdev(vAigle, 50)
dAigle = sdAigle * math.sqrt(lbFond)
sig9 = dAigle > 0 ? -math.max(-1.0, math.min(1.0, math.log(cAigle / nz(cAigle[lbFond], cAigle)) / dAigle)) : 0.0
hCroco = ta.highest(close, 55)
lCroco = ta.lowest(close, 55)
sig10 = (hCroco - lCroco) > 0 ? math.max(-1.0, math.min(1.0, (close - (hCroco + lCroco) / 2) / ((hCroco - lCroco) / 2))) : 0.0
hHyene = ta.highest(close, 20)
chuteH = sdBar > 0 ? math.log(close / hHyene) / (sdBar * math.sqrt(20)) : 0.0
sig11 = math.max(0.0, math.min(1.0, (-chuteH - 1.5) / 1.5))

// ---------------- LA GRANDE MEUTE : QUATRE CHASSEURS MUTABLES DE PLUS
d12 = sdBar * math.sqrt(L12)
d13 = sdBar * math.sqrt(L13)
d14 = sdBar * math.sqrt(L14)
d15 = sdBar * math.sqrt(L15)
sig12 = d12 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L12], close)) / d12)) : 0.0
sig13 = d13 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L13], close)) / d13)) : 0.0
sig14 = d14 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L14], close)) / d14)) : 0.0
sig15 = d15 > 0 ? -math.max(-1.0, math.min(1.0, math.log(close / nz(close[L15], close)) / d15)) : 0.0
// ---------------- LE BIP-BIP : LE MOMENTUM ULTRA-COURT
// Pas de dosage, pas de nuance : le gain multiplie la conviction avant la
// saturation, si bien qu'un tiers d'écart-type suffit à l'engager à fond.
// Ça monte, il achète. Ça descend, il vend. Il ne réfléchit pas, il court.
// Une espèce parmi les autres : il ne reçoit du capital que si sa forme est
// positive. Sur l'EURUSD elle ne l'est pas — il s'y tait, et c'est très bien.
d17 = sdBar * math.sqrt(L17)
sig17 = d17 > 0 ? math.max(-1.0, math.min(1.0, bipGainE * math.log(close / nz(close[L17], close)) / d17)) : 0.0
hVautour = ta.highest(close, 40)
chuteV = sdBar > 0 ? math.log(close / hVautour) / (sdBar * math.sqrt(40)) : 0.0
sig16 = math.max(0.0, math.min(1.0, (-chuteV - 2.5) / 2.0))

// ============================================================================
// LA CHASSE VIRTUELLE : GAIN RÉEL DE CHAQUE ESPÈCE, FRAIS DÉDUITS
// ============================================================================
p1 = nz(sig1[1], 0.0) * v - math.abs(sig1 - nz(sig1[1], sig1)) * 0.5 * fr
p2 = nz(sig2[1], 0.0) * v - math.abs(sig2 - nz(sig2[1], sig2)) * 0.5 * fr
p3 = nz(sig3[1], 0.0) * v - math.abs(sig3 - nz(sig3[1], sig3)) * 0.5 * fr
p4 = nz(sig4[1], 0.0) * v - math.abs(sig4 - nz(sig4[1], sig4)) * 0.5 * fr
p5 = nz(sig5[1], 0.0) * v - math.abs(sig5 - nz(sig5[1], sig5)) * 0.5 * fr
p6 = nz(sig6[1], 0.0) * v - math.abs(sig6 - nz(sig6[1], sig6)) * 0.5 * fr
p7 = nz(sig7[1], 0.0) * v - math.abs(sig7 - nz(sig7[1], sig7)) * 0.5 * fr
p8 = nz(sig8[1], 0.0) * v - math.abs(sig8 - nz(sig8[1], sig8)) * 0.5 * fr
p9 = nz(sig9[1], 0.0) * v - math.abs(sig9 - nz(sig9[1], sig9)) * 0.5 * fr
p10 = nz(sig10[1], 0.0) * v - math.abs(sig10 - nz(sig10[1], sig10)) * 0.5 * fr
p11 = nz(sig11[1], 0.0) * v - math.abs(sig11 - nz(sig11[1], sig11)) * 0.5 * fr
p12 = nz(sig12[1], 0.0) * v - math.abs(sig12 - nz(sig12[1], sig12)) * 0.5 * fr
p13 = nz(sig13[1], 0.0) * v - math.abs(sig13 - nz(sig13[1], sig13)) * 0.5 * fr
p14 = nz(sig14[1], 0.0) * v - math.abs(sig14 - nz(sig14[1], sig14)) * 0.5 * fr
p15 = nz(sig15[1], 0.0) * v - math.abs(sig15 - nz(sig15[1], sig15)) * 0.5 * fr
p16 = nz(sig16[1], 0.0) * v - math.abs(sig16 - nz(sig16[1], sig16)) * 0.5 * fr
p17 = nz(sig17[1], 0.0) * v - math.abs(sig17 - nz(sig17[1], sig17)) * 0.5 * fr
// Le Bip-Bip désarmé n'existe pas : il ne pèse ni dans l'écosystème, ni dans
// la meute. Le moteur redevient alors rigoureusement celui des seize espèces.
pEco = (p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9 + p10 + p11 + p12 + p13 + p14 + p15 + p16 + (bipOnE ? p17 : 0.0)) / (bipOnE ? 17.0 : 16.0)

// ============================================================================
// LA FORME : VIGUEUR DE CHAQUE ESPÈCE (mémoire exponentielle, oubli)
// ============================================================================
var float fit1 = 0.0
var float fit2 = 0.0
var float fit3 = 0.0
var float fit4 = 0.0
var float fit5 = 0.0
var float fit6 = 0.0
var float fit7 = 0.0
var float fit8 = 0.0
fit1 := barstate.isconfirmed ? lamF * fit1 + (1 - lamF) * p1 : fit1
fit2 := barstate.isconfirmed ? lamF * fit2 + (1 - lamF) * p2 : fit2
fit3 := barstate.isconfirmed ? lamF * fit3 + (1 - lamF) * p3 : fit3
fit4 := barstate.isconfirmed ? lamF * fit4 + (1 - lamF) * p4 : fit4
fit5 := barstate.isconfirmed ? lamF * fit5 + (1 - lamF) * p5 : fit5
fit6 := barstate.isconfirmed ? lamF * fit6 + (1 - lamF) * p6 : fit6
fit7 := barstate.isconfirmed ? lamF * fit7 + (1 - lamF) * p7 : fit7
fit8 := barstate.isconfirmed ? lamF * fit8 + (1 - lamF) * p8 : fit8
var float fit9 = 0.0
var float fit10 = 0.0
fit9 := barstate.isconfirmed ? lamF * fit9 + (1 - lamF) * p9 : fit9
fit10 := barstate.isconfirmed ? lamF * fit10 + (1 - lamF) * p10 : fit10
var float fit11 = 0.0
fit11 := barstate.isconfirmed ? lamF * fit11 + (1 - lamF) * p11 : fit11
var float fit12 = 0.0
var float fit13 = 0.0
var float fit14 = 0.0
var float fit15 = 0.0
var float fit16 = 0.0
fit12 := barstate.isconfirmed ? lamF * fit12 + (1 - lamF) * p12 : fit12
fit13 := barstate.isconfirmed ? lamF * fit13 + (1 - lamF) * p13 : fit13
fit14 := barstate.isconfirmed ? lamF * fit14 + (1 - lamF) * p14 : fit14
fit15 := barstate.isconfirmed ? lamF * fit15 + (1 - lamF) * p15 : fit15
fit16 := barstate.isconfirmed ? lamF * fit16 + (1 - lamF) * p16 : fit16
var float fit17 = 0.0
fit17 := barstate.isconfirmed ? lamF * fit17 + (1 - lamF) * p17 : fit17

// ============================================================================
// NICHES ÉCOLOGIQUES : LA DIFFÉRENCE EST RÉCOMPENSÉE (décorrélation)
// ============================================================================
q1 = nz(ta.correlation(p1, pEco, 100), 1.0)
q2 = nz(ta.correlation(p2, pEco, 100), 1.0)
q3 = nz(ta.correlation(p3, pEco, 100), 1.0)
q4 = nz(ta.correlation(p4, pEco, 100), 1.0)
q5 = nz(ta.correlation(p5, pEco, 100), 1.0)
q6 = nz(ta.correlation(p6, pEco, 100), 1.0)
q7 = nz(ta.correlation(p7, pEco, 100), 1.0)
q8 = nz(ta.correlation(p8, pEco, 100), 1.0)
q9 = nz(ta.correlation(p9, pEco, 100), 1.0)
q10 = nz(ta.correlation(p10, pEco, 100), 1.0)
q11 = nz(ta.correlation(p11, pEco, 100), 1.0)
q12 = nz(ta.correlation(p12, pEco, 100), 1.0)
q13 = nz(ta.correlation(p13, pEco, 100), 1.0)
q14 = nz(ta.correlation(p14, pEco, 100), 1.0)
q15 = nz(ta.correlation(p15, pEco, 100), 1.0)
q16 = nz(ta.correlation(p16, pEco, 100), 1.0)
q17 = nz(ta.correlation(p17, pEco, 100), 1.0)

// ============================================================================
// LA MEUTE : LE LION MANGE LE PREMIER (forme ^ hiérarchie, normalisée)
// ============================================================================
bestRef = math.max(bipOnE ? fit17 : -1e9, math.max(fit1, math.max(fit2, math.max(fit3, math.max(fit4, math.max(fit5, math.max(fit6, math.max(fit7, math.max(fit8, math.max(fit9, math.max(fit10, math.max(fit11, math.max(fit12, math.max(fit13, math.max(fit14, math.max(fit15, fit16))))))))))))))))
fitRef = math.max(bestRef, 1e-12)
w1 = math.pow(math.max(0.0, fit1) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q1))
w2 = math.pow(math.max(0.0, fit2) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q2))
w3 = math.pow(math.max(0.0, fit3) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q3))
w4 = math.pow(math.max(0.0, fit4) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q4))
w5 = math.pow(math.max(0.0, fit5) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q5))
w6r = math.pow(math.max(0.0, fit6) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q6))
w7r = math.pow(math.max(0.0, fit7) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q7))
w8r = math.pow(math.max(0.0, fit8) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q8))
w9 = math.pow(math.max(0.0, fit9) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q9))
w10 = math.pow(math.max(0.0, fit10) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q10))
w11r = math.pow(math.max(0.0, fit11) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q11))
w12 = math.pow(math.max(0.0, fit12) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q12))
w13 = math.pow(math.max(0.0, fit13) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q13))
w14 = math.pow(math.max(0.0, fit14) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q14))
w15r = math.pow(math.max(0.0, fit15) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q15))
w16r = math.pow(math.max(0.0, fit16) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q16))
w17 = bipOnE ? math.pow(math.max(0.0, fit17) / fitRef, hierarchieE) * (1.0 + divBonus * (1.0 - q17)) : 0.0

// PLAFOND DES CONTRARIENNES : elles ne peuvent pas rafler tout le capital.
wT = w1 + w2 + w3 + w4 + w5 + w9 + w10 + w12 + w13 + w14 + w17
wCr = w6r + w7r + w8r + w11r + w15r + w16r
cC = contMaxE / 100
scaleC = wCr > 0 and cC < 1 ? math.min(1.0, cC * wT / math.max(1e-12, (1 - cC) * wCr)) : 1.0
w6 = w6r * scaleC
w7 = w7r * scaleC
w8 = w8r * scaleC
w11 = w11r * scaleC
w15 = w15r * scaleC
w16 = w16r * scaleC
wTot = wT + w6 + w7 + w8 + w11 + w15 + w16
dir = wTot > 0 ? (w1 * sig1 + w2 * sig2 + w3 * sig3 + w4 * sig4 + w5 * sig5 + w6 * sig6 + w7 * sig7 + w8 * sig8 + w9 * sig9 + w10 * sig10 + w11 * sig11 + w12 * sig12 + w13 * sig13 + w14 * sig14 + w15 * sig15 + w16 * sig16 + w17 * sig17) / wTot : 0.0
vivantes = (w1 > 0 ? 1 : 0) + (w2 > 0 ? 1 : 0) + (w3 > 0 ? 1 : 0) + (w4 > 0 ? 1 : 0) + (w5 > 0 ? 1 : 0) + (w6 > 0 ? 1 : 0) + (w7 > 0 ? 1 : 0) + (w8 > 0 ? 1 : 0) + (w9 > 0 ? 1 : 0) + (w10 > 0 ? 1 : 0) + (w11 > 0 ? 1 : 0) + (w12 > 0 ? 1 : 0) + (w13 > 0 ? 1 : 0) + (w14 > 0 ? 1 : 0) + (w15 > 0 ? 1 : 0) + (w16 > 0 ? 1 : 0) + (w17 > 0 ? 1 : 0)

// LE QUORUM : la meute est-elle D'ACCORD, ou seulement moyennée ?
// La direction collective est une moyenne pondérée. Cinquante pour cent de la
// meute qui pousse vers le haut et cinquante-et-un vers le bas donnent une
// moyenne quasi nulle — dont le SIGNE est un pile ou face. On mesure donc
// l'écart réel entre les deux camps, et la meute ne charge que s'il est franc.
wPour = (sig1 > 0 ? w1 : 0.0) + (sig2 > 0 ? w2 : 0.0) + (sig3 > 0 ? w3 : 0.0) + (sig4 > 0 ? w4 : 0.0) + (sig5 > 0 ? w5 : 0.0) + (sig6 > 0 ? w6 : 0.0) + (sig7 > 0 ? w7 : 0.0) + (sig8 > 0 ? w8 : 0.0) + (sig9 > 0 ? w9 : 0.0) + (sig10 > 0 ? w10 : 0.0) + (sig11 > 0 ? w11 : 0.0) + (sig12 > 0 ? w12 : 0.0) + (sig13 > 0 ? w13 : 0.0) + (sig14 > 0 ? w14 : 0.0) + (sig15 > 0 ? w15 : 0.0) + (sig16 > 0 ? w16 : 0.0) + (sig17 > 0 ? w17 : 0.0)
wContre = (sig1 < 0 ? w1 : 0.0) + (sig2 < 0 ? w2 : 0.0) + (sig3 < 0 ? w3 : 0.0) + (sig4 < 0 ? w4 : 0.0) + (sig5 < 0 ? w5 : 0.0) + (sig6 < 0 ? w6 : 0.0) + (sig7 < 0 ? w7 : 0.0) + (sig8 < 0 ? w8 : 0.0) + (sig9 < 0 ? w9 : 0.0) + (sig10 < 0 ? w10 : 0.0) + (sig11 < 0 ? w11 : 0.0) + (sig12 < 0 ? w12 : 0.0) + (sig13 < 0 ? w13 : 0.0) + (sig14 < 0 ? w14 : 0.0) + (sig15 < 0 ? w15 : 0.0) + (sig16 < 0 ? w16 : 0.0) + (sig17 < 0 ? w17 : 0.0)
quorum = wTot > 0 ? math.abs(wPour - wContre) / wTot : 0.0
quorumOk = quorumMinE <= 0 or 100 * quorum >= quorumMinE
// LA VOIX DE LA MEUTE : signée. Le quorum en est la valeur absolue ; celle-ci
// garde le sens du camp majoritaire. C'est « quelle part du capital nourri
// pousse dans quel sens », et non « que vaut la moyenne de tous les signaux ».
// Deux familles qui se nourrissent à des horizons opposés — un retour à la
// moyenne à 7 bougies et une tendance à 25 — s'annulent dans une moyenne et
// se comptent dans un vote.
dirVote = wTot > 0 ? (wPour - wContre) / wTot : 0.0

// ============================================================================
// ÉVOLUTION : FAMINE, MORT, CROISEMENT DES 2 MEILLEURES, MUTATION
// ============================================================================
bestFit = bestRef
bestL = bestFit == fit1 ? L1 : bestFit == fit2 ? L2 : bestFit == fit3 ? L3 : bestFit == fit4 ? L4 : bestFit == fit5 ? L5 : bestFit == fit6 ? L6 : bestFit == fit7 ? L7 : bestFit == fit8 ? L8 : bestFit == fit9 ? lbFond : bestFit == fit10 ? 55 : bestFit == fit11 ? 20 : bestFit == fit12 ? L12 : bestFit == fit13 ? L13 : bestFit == fit14 ? L14 : bestFit == fit15 ? L15 : bipOnE and bestFit == fit17 ? L17 : 40
m2f1 = bestFit == fit1 ? -1e9 : fit1
m2f2 = bestFit == fit2 ? -1e9 : fit2
m2f3 = bestFit == fit3 ? -1e9 : fit3
m2f4 = bestFit == fit4 ? -1e9 : fit4
m2f5 = bestFit == fit5 ? -1e9 : fit5
m2f6 = bestFit == fit6 ? -1e9 : fit6
m2f7 = bestFit == fit7 ? -1e9 : fit7
m2f8 = bestFit == fit8 ? -1e9 : fit8
m2f9 = bestFit == fit9 ? -1e9 : fit9
m2f10 = bestFit == fit10 ? -1e9 : fit10
m2f11 = bestFit == fit11 ? -1e9 : fit11
m2f12 = bestFit == fit12 ? -1e9 : fit12
m2f13 = bestFit == fit13 ? -1e9 : fit13
m2f14 = bestFit == fit14 ? -1e9 : fit14
m2f15 = bestFit == fit15 ? -1e9 : fit15
m2f16 = bestFit == fit16 ? -1e9 : fit16
m2f17 = bestFit == fit17 or not bipOnE ? -1e9 : fit17
scndFit = math.max(m2f17, math.max(m2f1, math.max(m2f2, math.max(m2f3, math.max(m2f4, math.max(m2f5, math.max(m2f6, math.max(m2f7, math.max(m2f8, math.max(m2f9, math.max(m2f10, math.max(m2f11, math.max(m2f12, math.max(m2f13, math.max(m2f14, math.max(m2f15, m2f16))))))))))))))))
scndL = scndFit == m2f1 ? L1 : scndFit == m2f2 ? L2 : scndFit == m2f3 ? L3 : scndFit == m2f4 ? L4 : scndFit == m2f5 ? L5 : scndFit == m2f6 ? L6 : scndFit == m2f7 ? L7 : scndFit == m2f8 ? L8 : scndFit == m2f9 ? lbFond : scndFit == m2f10 ? 55 : scndFit == m2f11 ? 20 : scndFit == m2f12 ? L12 : scndFit == m2f13 ? L13 : scndFit == m2f14 ? L14 : scndFit == m2f15 ? L15 : scndFit == m2f17 ? L17 : 40
croise = math.sqrt(math.max(2, bestL) * math.max(2, scndL))
heritage = math.max(bestFit, 0.0) * soinParent / 100
stv1 := barstate.isconfirmed ? (fit1 <= 0 ? stv1 + 1 : 0.0) : stv1
stv2 := barstate.isconfirmed ? (fit2 <= 0 ? stv2 + 1 : 0.0) : stv2
stv3 := barstate.isconfirmed ? (fit3 <= 0 ? stv3 + 1 : 0.0) : stv3
stv4 := barstate.isconfirmed ? (fit4 <= 0 ? stv4 + 1 : 0.0) : stv4
stv5 := barstate.isconfirmed ? (fit5 <= 0 ? stv5 + 1 : 0.0) : stv5
stv6 := barstate.isconfirmed ? (fit6 <= 0 ? stv6 + 1 : 0.0) : stv6
stv7 := barstate.isconfirmed ? (fit7 <= 0 ? stv7 + 1 : 0.0) : stv7
stv8 := barstate.isconfirmed ? (fit8 <= 0 ? stv8 + 1 : 0.0) : stv8
stv12 := barstate.isconfirmed ? (fit12 <= 0 ? stv12 + 1 : 0.0) : stv12
stv13 := barstate.isconfirmed ? (fit13 <= 0 ? stv13 + 1 : 0.0) : stv13
stv14 := barstate.isconfirmed ? (fit14 <= 0 ? stv14 + 1 : 0.0) : stv14
stv15 := barstate.isconfirmed ? (fit15 <= 0 ? stv15 + 1 : 0.0) : stv15
stv17 := barstate.isconfirmed ? (fit17 <= 0 ? stv17 + 1 : 0.0) : stv17
mut1 = barstate.isconfirmed and stv1 > starveMax
mut2 = barstate.isconfirmed and stv2 > starveMax
mut3 = barstate.isconfirmed and stv3 > starveMax
mut4 = barstate.isconfirmed and stv4 > starveMax
mut5 = barstate.isconfirmed and stv5 > starveMax
mut6 = barstate.isconfirmed and stv6 > starveMax
mut7 = barstate.isconfirmed and stv7 > starveMax
mut8 = barstate.isconfirmed and stv8 > starveMax
mut12 = barstate.isconfirmed and stv12 > starveMax
mut13 = barstate.isconfirmed and stv13 > starveMax
mut14 = barstate.isconfirmed and stv14 > starveMax
mut15 = barstate.isconfirmed and stv15 > starveMax
mut17 = bipOnE and barstate.isconfirmed and stv17 > starveMax
fmut = 0.5 + math.abs(math.sin(bar_index * 12.9898)) * 1.0
L1 := mut1 ? math.max(5, math.min(20, math.round(croise * fmut))) : L1
L2 := mut2 ? math.max(15, math.min(40, math.round(croise * fmut * 1.13))) : L2
L3 := mut3 ? math.max(40, math.min(100, math.round(croise * fmut * 0.87))) : L3
L4 := mut4 ? math.max(90, math.min(200, math.round(croise * fmut * 1.29))) : L4
L5 := mut5 ? math.max(180, math.min(400, math.round(croise * fmut * 0.71))) : L5
L6 := mut6 ? math.max(2, math.min(6, math.round(croise * fmut * 0.2))) : L6
L7 := mut7 ? math.max(4, math.min(12, math.round(croise * fmut * 0.3))) : L7
L8 := mut8 ? math.max(8, math.min(30, math.round(croise * fmut * 0.4))) : L8
L12 := mut12 ? math.max(5, math.min(15, math.round(croise * fmut * 0.35))) : L12
L13 := mut13 ? math.max(25, math.min(60, math.round(croise * fmut * 0.55))) : L13
L14 := mut14 ? math.max(120, math.min(300, math.round(croise * fmut * 1.5))) : L14
L15 := mut15 ? math.max(2, math.min(8, math.round(croise * fmut * 0.15))) : L15
L17 := mut17 ? math.max(1, math.min(8, math.round(croise * fmut * 0.12))) : L17
fit1 := mut1 ? heritage : fit1
fit2 := mut2 ? heritage : fit2
fit3 := mut3 ? heritage : fit3
fit4 := mut4 ? heritage : fit4
fit5 := mut5 ? heritage : fit5
fit6 := mut6 ? heritage : fit6
fit7 := mut7 ? heritage : fit7
fit8 := mut8 ? heritage : fit8
fit12 := mut12 ? heritage : fit12
fit13 := mut13 ? heritage : fit13
fit14 := mut14 ? heritage : fit14
fit15 := mut15 ? heritage : fit15
fit17 := mut17 ? heritage : fit17
stv1 := mut1 ? 0.0 : stv1
stv2 := mut2 ? 0.0 : stv2
stv3 := mut3 ? 0.0 : stv3
stv4 := mut4 ? 0.0 : stv4
stv5 := mut5 ? 0.0 : stv5
stv6 := mut6 ? 0.0 : stv6
stv7 := mut7 ? 0.0 : stv7
stv8 := mut8 ? 0.0 : stv8
stv12 := mut12 ? 0.0 : stv12
stv13 := mut13 ? 0.0 : stv13
stv14 := mut14 ? 0.0 : stv14
stv15 := mut15 ? 0.0 : stv15
stv17 := mut17 ? 0.0 : stv17
g1 := mut1 ? g1 + 1 : g1
g2 := mut2 ? g2 + 1 : g2
g3 := mut3 ? g3 + 1 : g3
g4 := mut4 ? g4 + 1 : g4
g5 := mut5 ? g5 + 1 : g5
g6 := mut6 ? g6 + 1 : g6
g7 := mut7 ? g7 + 1 : g7
g8 := mut8 ? g8 + 1 : g8
g12 := mut12 ? g12 + 1 : g12
g13 := mut13 ? g13 + 1 : g13
g14 := mut14 ? g14 + 1 : g14
g15 := mut15 ? g15 + 1 : g15
g17 := mut17 ? g17 + 1 : g17
age1 := mut1 ? 0 : barstate.isconfirmed ? age1 + 1 : age1
age2 := mut2 ? 0 : barstate.isconfirmed ? age2 + 1 : age2
age3 := mut3 ? 0 : barstate.isconfirmed ? age3 + 1 : age3
age4 := mut4 ? 0 : barstate.isconfirmed ? age4 + 1 : age4
age5 := mut5 ? 0 : barstate.isconfirmed ? age5 + 1 : age5
age6 := mut6 ? 0 : barstate.isconfirmed ? age6 + 1 : age6
age7 := mut7 ? 0 : barstate.isconfirmed ? age7 + 1 : age7
age8 := mut8 ? 0 : barstate.isconfirmed ? age8 + 1 : age8
age12 := mut12 ? 0 : barstate.isconfirmed ? age12 + 1 : age12
age13 := mut13 ? 0 : barstate.isconfirmed ? age13 + 1 : age13
age14 := mut14 ? 0 : barstate.isconfirmed ? age14 + 1 : age14
age15 := mut15 ? 0 : barstate.isconfirmed ? age15 + 1 : age15
age17 := mut17 ? 0 : barstate.isconfirmed and bipOnE ? age17 + 1 : age17

// ============================================================================
// RÉ-ENSEMENCEMENT : APRÈS 100 BOUGIES D'EXTINCTION, LES SPORES PRIMORDIALES
// ============================================================================
var float extN = 0.0
extN := barstate.isconfirmed ? (ready and wTot == 0 ? extN + 1 : 0.0) : extN
resem = barstate.isconfirmed and extN > 100
L1 := resem ? 10 : L1
L2 := resem ? 21 : L2
L3 := resem ? 63 : L3
L4 := resem ? 126 : L4
L5 := resem ? 252 : L5
L6 := resem ? 2 : L6
L7 := resem ? 5 : L7
L8 := resem ? 8 : L8
fit1 := resem ? 0.0 : fit1
fit2 := resem ? 0.0 : fit2
fit3 := resem ? 0.0 : fit3
fit4 := resem ? 0.0 : fit4
fit5 := resem ? 0.0 : fit5
fit6 := resem ? 0.0 : fit6
fit7 := resem ? 0.0 : fit7
fit8 := resem ? 0.0 : fit8
fit9 := resem ? 0.0 : fit9
fit10 := resem ? 0.0 : fit10
fit11 := resem ? 0.0 : fit11
fit12 := resem ? 0.0 : fit12
fit13 := resem ? 0.0 : fit13
fit14 := resem ? 0.0 : fit14
fit15 := resem ? 0.0 : fit15
fit16 := resem ? 0.0 : fit16
L12 := resem ? 8 : L12
L13 := resem ? 30 : L13
L14 := resem ? 150 : L14
L15 := resem ? 3 : L15
L17 := resem ? 3 : L17
fit17 := resem ? 0.0 : fit17
stv17 := resem ? 0.0 : stv17
stv12 := resem ? 0.0 : stv12
stv13 := resem ? 0.0 : stv13
stv14 := resem ? 0.0 : stv14
stv15 := resem ? 0.0 : stv15
stv1 := resem ? 0.0 : stv1
stv2 := resem ? 0.0 : stv2
stv3 := resem ? 0.0 : stv3
stv4 := resem ? 0.0 : stv4
stv5 := resem ? 0.0 : stv5
stv6 := resem ? 0.0 : stv6
stv7 := resem ? 0.0 : stv7
stv8 := resem ? 0.0 : stv8
extN := resem ? 0.0 : extN

naissance = mut1 or mut2 or mut3 or mut4 or mut5 or mut6 or mut7 or mut8 or mut12 or mut13 or mut14 or mut15 or mut17 or resem
naissances = g1 + g2 + g3 + g4 + g5 + g6 + g7 + g8 + g12 + g13 + g14 + g15 + g17 - 13
doyenne = math.max(age1, math.max(age2, math.max(age3, math.max(age4, math.max(age5, math.max(age6, math.max(age7, math.max(age8, math.max(age12, math.max(age13, math.max(age14, math.max(age15, age17))))))))))))

// ============================================================================
// SYSTÈME IMMUNITAIRE : BOUCLIER APRÈS CHOC ANORMAL
// ============================================================================
var float immun = 0.0
choc = ready and math.abs(v) > chocSeuil * nz(sdBar[1], 1e9)
immun := choc and barstate.isconfirmed ? chocDureeE : math.max(0.0, immun - (barstate.isconfirmed ? 1.0 : 0.0))
bouclier = immun > 0 ? 0.5 : 1.0

// IMMUNITÉ ACQUISE : la mémoire des chocs, demi-vie d'un an.
var float anticorps = 0.0
lamA = math.pow(0.5, 1.0 / lbAn)
anticorps := barstate.isconfirmed ? anticorps * lamA + (choc ? 1.0 : 0.0) : anticorps
immAcqF = math.max(0.5, 1.0 / (1.0 + 0.25 * anticorps))

// ============================================================================
// HOMÉOSTASIE : CIBLAGE DE VOLATILITÉ
// CORRECTION G10 : la G9 annualisait en jours CALENDAIRES (√365) une série de
// bougies de BOURSE. La volatilité mesurée était 23 % trop haute, le levier
// 23 % trop bas — sur seize ans, cela seul divise le résultat par ~1,5.
// ============================================================================
sigA = ta.stdev(v, volWin) * math.sqrt(annuF)
levVol = sigA > 0 ? math.min(expoMaxE, (targetVolE / 100) / sigA) : 0.0

// ============================================================================
// RÉGULATION THERMIQUE : TORPEUR, HIBERNATION, PLANCHER DE SURVIE
// ============================================================================
// LA PERTE SE MESURE DEPUIS LE PLUS HAUT ABSOLU, et l'oubli du sommet a été
// SUPPRIMÉ — pas rendu optionnel. Il n'avait aucun usage légitime et un mode
// de défaillance mortel : le sommet mémorisé perdait 29 % par an, si bien
// qu'une colonie saignant moins vite le voyait descendre avec elle et
// affichait « 0 % de perte · métabolisme normal » jusqu'à l'extinction. Test
// EURUSD : -52 % de capital, aucune alerte. Rendu optionnel derrière une case
// étiquetée « DANGEREUX », il a été coché au test suivant — une case à cocher
// reste une case à cocher. Le sommet absolu ne ment pas, et la remontée du
// capital rouvre le frein d'elle-même : c'est la seule guérison nécessaire.
// MODE HÉRITAGE : la G9 laissait le sommet mémorisé S'EFFACER (demi-vie 500
// bougies, soit -29 % par an). C'était sa soupape : eqMax redescendait vers
// l'équité, la perte fondait, le frein se rouvrait. Un témoin de contrôle qui
// ne restitue pas ça n'est pas un témoin — il ne peut pas reproduire les
// backtests de la G9, donc il ne peut rien prouver. Il le restitue maintenant.
// Une seule formule pour les deux régimes : à mémoire nulle lamPic vaut 1 et
// l'expression redevient exactement le sommet absolu, sans branche séparée.
lamPic = memSommetE > 0 ? math.pow(0.5, 1.0 / memSommetE) : 1.0
var float eqMax = na
eqMax := math.max(strategy.equity, nz(eqMax, strategy.equity) * lamPic)
dd = eqMax > 0 ? 1.0 - strategy.equity / eqMax : 0.0
// LE VERROU MORTEL DE LA G10, ET LA RAISON DES -15 000 SUR NVIDIA.
// La chaîne est mécanique, elle ne demande aucun backtest pour être vue :
//   perte >= borne (50 %)  ->  torpeur = 0
//   torpeur = 0            ->  fCible = 0  (ligne de la charge du lion)
//   fCible = 0             ->  la position se solde, l'équité devient du cash
//   équité figée           ->  eqMax figé, donc dd figé à 50 %
//   dd figé                ->  torpeur reste 0. POUR TOUJOURS.
// La G9 s'en sortait parce que son sommet mémorisé S'EFFAÇAIT : eqMax
// redescendait vers l'équité, dd fondait, la torpeur se rouvrait toute seule.
// J'ai supprimé cet oubli en le traitant comme un bug, et j'ai écrit dans
// l'en-tête que « la remontée du capital rouvre le frein d'elle-même ». C'est
// faux : le capital ne peut pas remonter à exposition nulle. J'avais pourtant
// identifié EXACTEMENT ce piège pour le frein réel quelques lignes plus bas,
// où j'ai posé un plancher à 0,25 — et je ne l'ai pas appliqué ici.
// Sur NVIDIA à levier x10 et 100 % de volatilité cible, une perte de 50 %
// depuis le sommet arrive forcément une fois en dix ans. La première fois
// qu'elle arrive, la colonie meurt définitivement.
// Le sommet absolu reste (il ne ment pas). Mais le frein garde un plancher :
// il freine, il ne condamne pas.
torpeurLibre = math.max(0.0, math.min(1.0, 1.0 - dd / (ddMaxE / 100)))
torpeur = math.max(legacy ? 0.0 : 0.15, torpeurLibre)

// PLANCHER DE SURVIE : le point de non-retour. Pas de perte mortelle.
var bool eteint = false
eteint := eteint or (ready and strategy.equity < plancher / 100 * strategy.initial_capital)

// ============================================================================
// LA SAVANE LOCALE : LE ROI JAUGE SON TERRITOIRE AVANT DE CHASSER
// CORRECTION G10 : le score est désormais un vrai t-statistique — la tendance
// sur une année divisée par le bruit sur cette même année — donc identique en
// journalier, hebdomadaire et mensuel. La G9 comparait 252 bougies de tendance
// à une année de bruit : en hebdomadaire le score était gonflé 2,2 fois.
// ============================================================================
momLoc = legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close))
bruitLoc = ta.stdev(v, volWin) * math.sqrt(lbSav)
scoreLocal = bruitLoc > 0 ? math.abs(momLoc) / bruitLoc : 0.0
seuLoc = savaneMinLoc > 0 ? savaneMinLoc : savaneMinE
up = close > close[1]
patId = (up ? 1 : 0) + (up[1] ? 2 : 0) + (up[2] ? 4 : 0)
c0 = math.sum(patId == 0 ? 1.0 : 0.0, wEnt)
c1 = math.sum(patId == 1 ? 1.0 : 0.0, wEnt)
c2 = math.sum(patId == 2 ? 1.0 : 0.0, wEnt)
c3 = math.sum(patId == 3 ? 1.0 : 0.0, wEnt)
c4 = math.sum(patId == 4 ? 1.0 : 0.0, wEnt)
c5 = math.sum(patId == 5 ? 1.0 : 0.0, wEnt)
c6 = math.sum(patId == 6 ? 1.0 : 0.0, wEnt)
c7 = math.sum(patId == 7 ? 1.0 : 0.0, wEnt)
tot = c0 + c1 + c2 + c3 + c4 + c5 + c6 + c7
t0 = c0 > 0 ? (c0 / tot) * math.log(c0 / tot) : 0.0
t1 = c1 > 0 ? (c1 / tot) * math.log(c1 / tot) : 0.0
t2 = c2 > 0 ? (c2 / tot) * math.log(c2 / tot) : 0.0
t3 = c3 > 0 ? (c3 / tot) * math.log(c3 / tot) : 0.0
t4 = c4 > 0 ? (c4 / tot) * math.log(c4 / tot) : 0.0
t5 = c5 > 0 ? (c5 / tot) * math.log(c5 / tot) : 0.0
t6 = c6 > 0 ? (c6 / tot) * math.log(c6 / tot) : 0.0
t7 = c7 > 0 ? (c7 / tot) * math.log(c7 / tot) : 0.0
entropie = tot > 0 ? -(t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7) / math.log(2.0) / 3.0 : 1.0
ordreOk = entropie <= entMaxE
savaneOk = (seuLoc <= 0 or scoreLocal >= seuLoc) and ordreOk

// ============================================================================
// LES VINGT SAVANES : CHACUNE JAUGÉE SELON SON PROPRE SEUIL
// Chaque appel renvoie [tendance sur un an, bruit sur un an] ; le score en est
// le rapport, calculé juste après. C'est le même t-statistique que celui de la
// savane locale : les vingt territoires et celui sous les pattes du roi sont
// enfin comparables entre eux.
// ============================================================================
[mo1, vo1] = request.security(sym1, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo2, vo2] = request.security(sym2, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo3, vo3] = request.security(sym3, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo4, vo4] = request.security(sym4, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo5, vo5] = request.security(sym5, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo6, vo6] = request.security(sym6, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo7, vo7] = request.security(sym7, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo8, vo8] = request.security(sym8, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo9, vo9] = request.security(sym9, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo10, vo10] = request.security(sym10, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo11, vo11] = request.security(sym11, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo12, vo12] = request.security(sym12, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo13, vo13] = request.security(sym13, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo14, vo14] = request.security(sym14, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo15, vo15] = request.security(sym15, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo16, vo16] = request.security(sym16, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo17, vo17] = request.security(sym17, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo18, vo18] = request.security(sym18, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo19, vo19] = request.security(sym19, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])
[mo20, vo20] = request.security(sym20, timeframe.period, [legacy ? close / nz(close[252], close) - 1 : math.log(close / nz(close[lbSav], close)), ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(lbSav)])

// Le score de chaque savane : la tendance de l'année divisée par son bruit.
sc1 = nz(vo1, 0) > 0 ? math.abs(nz(mo1, 0)) / vo1 : 0.0
sc2 = nz(vo2, 0) > 0 ? math.abs(nz(mo2, 0)) / vo2 : 0.0
sc3 = nz(vo3, 0) > 0 ? math.abs(nz(mo3, 0)) / vo3 : 0.0
sc4 = nz(vo4, 0) > 0 ? math.abs(nz(mo4, 0)) / vo4 : 0.0
sc5 = nz(vo5, 0) > 0 ? math.abs(nz(mo5, 0)) / vo5 : 0.0
sc6 = nz(vo6, 0) > 0 ? math.abs(nz(mo6, 0)) / vo6 : 0.0
sc7 = nz(vo7, 0) > 0 ? math.abs(nz(mo7, 0)) / vo7 : 0.0
sc8 = nz(vo8, 0) > 0 ? math.abs(nz(mo8, 0)) / vo8 : 0.0
sc9 = nz(vo9, 0) > 0 ? math.abs(nz(mo9, 0)) / vo9 : 0.0
sc10 = nz(vo10, 0) > 0 ? math.abs(nz(mo10, 0)) / vo10 : 0.0
sc11 = nz(vo11, 0) > 0 ? math.abs(nz(mo11, 0)) / vo11 : 0.0
sc12 = nz(vo12, 0) > 0 ? math.abs(nz(mo12, 0)) / vo12 : 0.0
sc13 = nz(vo13, 0) > 0 ? math.abs(nz(mo13, 0)) / vo13 : 0.0
sc14 = nz(vo14, 0) > 0 ? math.abs(nz(mo14, 0)) / vo14 : 0.0
sc15 = nz(vo15, 0) > 0 ? math.abs(nz(mo15, 0)) / vo15 : 0.0
sc16 = nz(vo16, 0) > 0 ? math.abs(nz(mo16, 0)) / vo16 : 0.0
sc17 = nz(vo17, 0) > 0 ? math.abs(nz(mo17, 0)) / vo17 : 0.0
sc18 = nz(vo18, 0) > 0 ? math.abs(nz(mo18, 0)) / vo18 : 0.0
sc19 = nz(vo19, 0) > 0 ? math.abs(nz(mo19, 0)) / vo19 : 0.0
sc20 = nz(vo20, 0) > 0 ? math.abs(nz(mo20, 0)) / vo20 : 0.0

// SEUILS INDÉPENDANTS : chaque savane a le sien ; 0 = hérite de la classe.
sv1 = seu1 > 0 ? seu1 : savaneMinE
sv2 = seu2 > 0 ? seu2 : savaneMinE
sv3 = seu3 > 0 ? seu3 : savaneMinE
sv4 = seu4 > 0 ? seu4 : savaneMinE
sv5 = seu5 > 0 ? seu5 : savaneMinE
sv6 = seu6 > 0 ? seu6 : savaneMinE
sv7 = seu7 > 0 ? seu7 : savaneMinE
sv8 = seu8 > 0 ? seu8 : savaneMinE
sv9 = seu9 > 0 ? seu9 : savaneMinE
sv10 = seu10 > 0 ? seu10 : savaneMinE
sv11 = seu11 > 0 ? seu11 : savaneMinE
sv12 = seu12 > 0 ? seu12 : savaneMinE
sv13 = seu13 > 0 ? seu13 : savaneMinE
sv14 = seu14 > 0 ? seu14 : savaneMinE
sv15 = seu15 > 0 ? seu15 : savaneMinE
sv16 = seu16 > 0 ? seu16 : savaneMinE
sv17 = seu17 > 0 ? seu17 : savaneMinE
sv18 = seu18 > 0 ? seu18 : savaneMinE
sv19 = seu19 > 0 ? seu19 : savaneMinE
sv20 = seu20 > 0 ? seu20 : savaneMinE

// MIGRATION : on classe par EXCÉDENT au-dessus du seuil PROPRE de la savane,
// pas par score brut — sinon un territoire exigeant paraît meilleur qu'un
// territoire tolérant qui, lui, est réellement chassable. Une savane décochée
// est écartée du classement (bug de la G9 : elle y restait).
sr1 = on1 ? nz(sc1, 0.0) - sv1 : -1e9
sr2 = on2 ? nz(sc2, 0.0) - sv2 : -1e9
sr3 = on3 ? nz(sc3, 0.0) - sv3 : -1e9
sr4 = on4 ? nz(sc4, 0.0) - sv4 : -1e9
sr5 = on5 ? nz(sc5, 0.0) - sv5 : -1e9
sr6 = on6 ? nz(sc6, 0.0) - sv6 : -1e9
sr7 = on7 ? nz(sc7, 0.0) - sv7 : -1e9
sr8 = on8 ? nz(sc8, 0.0) - sv8 : -1e9
sr9 = on9 ? nz(sc9, 0.0) - sv9 : -1e9
sr10 = on10 ? nz(sc10, 0.0) - sv10 : -1e9
sr11 = on11 ? nz(sc11, 0.0) - sv11 : -1e9
sr12 = on12 ? nz(sc12, 0.0) - sv12 : -1e9
sr13 = on13 ? nz(sc13, 0.0) - sv13 : -1e9
sr14 = on14 ? nz(sc14, 0.0) - sv14 : -1e9
sr15 = on15 ? nz(sc15, 0.0) - sv15 : -1e9
sr16 = on16 ? nz(sc16, 0.0) - sv16 : -1e9
sr17 = on17 ? nz(sc17, 0.0) - sv17 : -1e9
sr18 = on18 ? nz(sc18, 0.0) - sv18 : -1e9
sr19 = on19 ? nz(sc19, 0.0) - sv19 : -1e9
sr20 = on20 ? nz(sc20, 0.0) - sv20 : -1e9
srBest = math.max(sr1, math.max(sr2, math.max(sr3, math.max(sr4, math.max(sr5, math.max(sr6, math.max(sr7, math.max(sr8, math.max(sr9, math.max(sr10, math.max(sr11, math.max(sr12, math.max(sr13, math.max(sr14, math.max(sr15, math.max(sr16, math.max(sr17, math.max(sr18, math.max(sr19, sr20)))))))))))))))))))
savBest = srBest == sr1 ? sym1 : srBest == sr2 ? sym2 : srBest == sr3 ? sym3 : srBest == sr4 ? sym4 : srBest == sr5 ? sym5 : srBest == sr6 ? sym6 : srBest == sr7 ? sym7 : srBest == sr8 ? sym8 : srBest == sr9 ? sym9 : srBest == sr10 ? sym10 : srBest == sr11 ? sym11 : srBest == sr12 ? sym12 : srBest == sr13 ? sym13 : srBest == sr14 ? sym14 : srBest == sr15 ? sym15 : srBest == sr16 ? sym16 : srBest == sr17 ? sym17 : srBest == sr18 ? sym18 : srBest == sr19 ? sym19 : sym20
migrTxt = srBest < -1e8 ? "aucune savane surveillée" : srBest > 0 ? savBest + " (excédent +" + str.tostring(srBest, "#.##") + ")" : "aucune savane grasse — rester à l'abri"

// Les savanes surveillées, pour la ruche des abeilles (les éteintes ne comptent pas).
nSurv = (on1 ? 1 : 0) + (on2 ? 1 : 0) + (on3 ? 1 : 0) + (on4 ? 1 : 0) + (on5 ? 1 : 0) + (on6 ? 1 : 0) + (on7 ? 1 : 0) + (on8 ? 1 : 0) + (on9 ? 1 : 0) + (on10 ? 1 : 0) + (on11 ? 1 : 0) + (on12 ? 1 : 0) + (on13 ? 1 : 0) + (on14 ? 1 : 0) + (on15 ? 1 : 0) + (on16 ? 1 : 0) + (on17 ? 1 : 0) + (on18 ? 1 : 0) + (on19 ? 1 : 0) + (on20 ? 1 : 0)

// ============================================================================
// L'ESSAIM : LES INSECTES SENTINELLES
// Ils ne chassent jamais (les frais tueraient tout insecte-chasseur) : ils
// écoutent le sol et préviennent la colonie, gratuitement.
// ============================================================================
sdCourt = ta.stdev(v, 10)
sdLong = ta.stdev(v, 100)
orage = sdLong > 0 ? sdCourt / sdLong : 1.0
fourmisAlerte = ready and orage > 1.5
ruche = nSurv > 0 ? ((on1 ? nz(vo1, 0) : 0) + (on2 ? nz(vo2, 0) : 0) + (on3 ? nz(vo3, 0) : 0) + (on4 ? nz(vo4, 0) : 0) + (on5 ? nz(vo5, 0) : 0) + (on6 ? nz(vo6, 0) : 0) + (on7 ? nz(vo7, 0) : 0) + (on8 ? nz(vo8, 0) : 0) + (on9 ? nz(vo9, 0) : 0) + (on10 ? nz(vo10, 0) : 0) + (on11 ? nz(vo11, 0) : 0) + (on12 ? nz(vo12, 0) : 0) + (on13 ? nz(vo13, 0) : 0) + (on14 ? nz(vo14, 0) : 0) + (on15 ? nz(vo15, 0) : 0) + (on16 ? nz(vo16, 0) : 0) + (on17 ? nz(vo17, 0) : 0) + (on18 ? nz(vo18, 0) : 0) + (on19 ? nz(vo19, 0) : 0) + (on20 ? nz(vo20, 0) : 0)) / nSurv : 0.0
rucheMoy = ta.sma(ruche, lbSav)
abeillesAlerte = ready and rucheMoy > 0 and ruche > 1.4 * rucheMoy
meches = ta.sma((high - low - math.abs(close - open)) / math.max(high - low, syminfo.mintick), 50)
solTraitre = meches > 0.55

// ============================================================================
// TENDANCE DE FOND : suit l'unité de temps (bug G9 : figée à 252 bougies)
// ============================================================================
fond = close > nz(close[lbFond], close) ? 1 : -1

// ============================================================================
// LA CHARGE DU LION : DÉCISION FINALE
// CORRECTION MAJEURE G10 — LA NORMALISATION DE LA CONVICTION.
// La conviction collective |dir| vaut typiquement 0,30 : la meute n'utilisait
// donc que 30 % du levier que l'homéostasie lui accordait. Sur seize ans de
// forex, c'est très exactement la différence entre +5 000 € et un résultat qui
// ressemble au risque pris. On divise la conviction par sa propre amplitude
// moyenne — le signe et le classement des espèces sont intacts, seule
// l'échelle change — et on reborne à ±1 : le ciblage de volatilité reste le
// seul maître de la taille finale.
// ============================================================================
// LE FREIN RÉEL : le seul juge qui voit la commission du courtier.
pfReel = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : 1.0
// Jamais zéro : à exposition nulle, plus aucun trade ne se clôture, le
// facteur de profit se fige et la colonie resterait bridée pour l'éternité.
// On lui laisse le quart : de quoi se racheter, pas de quoi se ruiner.
// Second organe absent de la G9, et second frein sur le composé de NVIDIA.
// Il ne doit mordre que si la colonie perd VRAIMENT de l'argent — c'est son
// intitulé même. Un facteur de profit sous 1 alors que le profit net est
// POSITIF décrit une colonie qui gagne gros et rarement : la brider divise le
// composé sans rien protéger.
freinReel = not freinOnE or strategy.closedtrades < 30 or strategy.netprofit >= 0 ? 1.0 : pfReel >= 1.0 ? 1.0 : pfReel >= 0.7 ? 0.5 : 0.25
dirS = ta.sma(dir, respireE)
// J'AI REFAIT LA MÊME ERREUR UN CRAN PLUS HAUT, ET LA CAPTURE EURUSD LE MONTRE.
// La voix de la meute vaut 22 % sur la bougie — 61 contre 39. Je la passais
// dans une moyenne de 5 bougies avant de la juger, et il en sortait 5 %.
// L'alpha du terrain est le Renard, un retour à la moyenne sur 7 bougies : il
// change d'avis tous les deux jours, par construction. Moyenner son vote sur
// cinq jours, c'est exactement moyenner un contrarien avec un suiveur — le
// désaccord est écrasé au lieu d'être mesuré. J'avais écrit la règle deux
// paragraphes plus bas et je venais de la violer moi-même.
// Le lissage était en plus REDONDANT : la respiration interdit déjà d'agir
// ailleurs que toutes les respireE bougies. Filtrer le signal sur la même
// fenêtre que la fréquence d'action, c'est filtrer deux fois.
// La voix se juge donc telle qu'elle est. dirS, lui, garde son lissage : il
// vient de la G9 et le profil actions en dépend.
dirVoteS = ta.sma(dirVote, respireE)
dirJuge = voixE ? dirVote : dirS
convRef = math.max(nz(ta.sma(math.abs(dirJuge), lbSav), 0.3), 0.05)
dirN = math.max(-1.0, math.min(1.0, dirJuge / convRef))
dirUse = convNormE ? dirN : dirJuge
// LA PROIE MINIMALE SE JUGE SUR LA CONVICTION BRUTE, PAS SUR LA NORMALISÉE.
// La normalisation divise la conviction par son amplitude habituelle : un jour
// de désaccord total (conviction brute 4 %) ressort à 14 % après division, ce
// qui suffisait à franchir la proie minimale du profil forex (12 %). Le seuil
// censé dire « ne chasse pas sur une conviction faible » était donc franchi
// PAR la faiblesse elle-même. On teste le brut, on dimensionne avec le
// normalisé : la normalisation règle la TAILLE, elle ne crée pas la DÉCISION.
dirChasse = math.abs(dirJuge) >= proieMinE and quorumOk ? dirUse : 0.0
// LE RÉGIME DÉSERT : la savane est déclarée stérile, et la meute chasse
// quand même — réduite, mais c'est bien ELLE, avec ses poids du moment.
// Aucune espèce n'est désignée d'avance : celles qui se nourrissent tiennent
// la barre, celles qui jeûnent ont un poids nul. Si personne ne mange, dir
// vaut zéro tout seul et la colonie reste à l'abri sans qu'on ait à
// l'interdire. C'est la sélection qui décide, pas le code.
// Les bornes de SURVIE, elles, tiennent dans tous les cas : torpeur, bouclier
// immunitaire, frein réel, plancher d'extinction, ordre souverain.
desertOn = chasseDesertE and ready and not savaneOk
dirEff = dirChasse
mulDesert = desertOn ? bipDesertE : 1.0
fCible = ready and inDate and not eteint ? dirEff * levVol * torpeur * bouclier * mulDesert : 0.0
fCible := enableLongs or fCible < 0 ? fCible : 0.0
fCible := enableShorts or fCible > 0 ? fCible : 0.0
fCible := respectFondE and not (desertOn and bipLibreE) and fCible * fond < 0 ? 0.0 : fCible
fCible := savaneOk or desertOn ? fCible : 0.0
fCible := pacteAbri ? 0.0 : fCible
// L'essaim et les anticorps ne mordent que si le souverain les a armés.
fCible := fourmisOn and fourmisAlerte ? fCible * 0.7 : fCible
fCible := abeillesOn and abeillesAlerte ? fCible * 0.7 : fCible
fCible := immAcqOn ? fCible * immAcqF : fCible
fCible := freinReel * fCible

// ============================================================================
// CORRECTION : RÉÉQUILIBRAGE AVEC ZONE MORTE ET RESPIRATION
// ============================================================================
// LE COMPTE EST TENU DANS LA DEVISE DE COTATION (currency.NONE dans l'en-tête).
// C'est indispensable : cette ligne divise le capital par le prix, donc les
// deux DOIVENT être dans la même devise. Avec un compte en euros sur l'EURJPY,
// on divisait des euros par des yens et chaque position sortait 185 fois trop
// petite — le facteur JPY/EUR. Sur NVIDIA (compte EUR, cotation USD) le
// facteur valait 1,08 et l'erreur passait inaperçue ; sur l'EURJPY elle rendait
// la colonie inerte. currency.NONE aligne les deux, sur tous les instruments.
qtyCible = fCible * strategy.equity / close
diffQty = qtyCible - strategy.position_size
seuilQty = math.max(rebalPct / 100 * math.abs(qtyCible), 0.02 * strategy.equity / close)
souffle = bar_index % respireE == 0
doPlus = barstate.isconfirmed and souffle and diffQty > seuilQty
doMoins = barstate.isconfirmed and souffle and -diffQty > seuilQty

// ============================================================================
// AFFICHAGE SUR LE GRAPHIQUE
// ============================================================================
bgcolor(not ready ? na : desertOn ? color.new(color.yellow, 90) : not savaneOk ? color.new(color.orange, 92) : vivantes == 0 ? color.new(color.red, 90) : dir > 0.2 ? color.new(color.teal, 94) : dir < -0.2 ? color.new(color.red, 94) : na)
plotshape(doPlus, "Poussée haussière", shape.triangleup, location.belowbar, color.new(color.teal, 0), size = size.tiny)
plotshape(doMoins, "Poussée baissière", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.tiny)
plotshape(naissance, "Naissance d'une espèce", shape.diamond, location.bottom, color.new(color.purple, 0), size = size.tiny)
plotshape(choc, "Choc immunitaire", shape.xcross, location.top, color.new(color.red, 0), size = size.tiny)

// ============================================================================
// LE POSTE DE COMMANDEMENT : TABLEAU COMPLET
// ============================================================================
expoActu = strategy.position_size * close / strategy.equity
var float eauCum = 0.0
eauCum := barstate.isconfirmed ? eauCum + math.abs(expoActu) * (swapE / 100) * (timeframe.in_seconds() / 31536000.0) * strategy.equity : eauCum
retPresent = strategy.equity / math.max(nz(strategy.equity[miroirWin], strategy.initial_capital), 1e-9) - 1
nFen = math.max(1.0, (bar_index - 300.0) / miroirWin)
retRythme = math.pow(math.max(strategy.equity / strategy.initial_capital, 1e-9), 1.0 / nFen) - 1
decroche = ready and strategy.closedtrades > 10 and retPresent < retRythme - 0.10
pousseTxt = (fCible >= 0 ? "+" : "") + str.tostring(100 * fCible, "#.#") + " % / " + (expoActu >= 0 ? "+" : "") + str.tostring(100 * expoActu, "#.#") + " %"
pousseCol = fCible > 0.01 ? color.new(color.teal, 70) : fCible < -0.01 ? color.new(color.red, 70) : color.new(color.gray, 85)
winRate = strategy.closedtrades > 0 ? 100.0 * strategy.wintrades / strategy.closedtrades : 0.0
pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
desert = timeframe.in_seconds() < 14400
// ============================================================================
// ALARME DE PROFIL : DES RÉGLAGES D'ACTION POSÉS SUR UNE DEVISE
// Capture EURUSD en profil Manuel : les réglages par défaut de ces groupes SONT
// le profil NVIDIA, et appliqués tels quels à une paire de devises ils donnent
//   volatilité cible 100 % sur un actif qui respire à 4,7 %  -> levier x21,
//     plafonné à x10 : dix fois le capital sur un change ;
//   seuil de savane 0,99 quand le score de la paire vaut 0,01 : le territoire
//     est déclaré stérile en permanence, plus rien ne passe par la voie
//     normale, tout part dans le régime désert ;
//   frais de sélection 0,1 % : dix fois le spread réel, ce qui affame toutes
//     les espèces rapides — les seules qui gagnent sur ce terrain ;
//   filtre de fond respecté : longs INTERDITS pendant que la paire monte.
// Résultat : -3 194, facteur de profit 0,73, 38,6 % de perte depuis le sommet.
// Ce n'est pas un défaut du moteur, c'est le mauvais jeu de réglages. Mais un
// piège qui ne se voit que dans une infobulle, sur un téléphone, n'est pas un
// avertissement : c'est un piège. Il se voit donc maintenant en rouge, en haut
// du tableau, avec le nom du profil qu'il faut prendre.
classeAct = classe == "actions" or classe == "indices"
profManuel = prof == "Manuel (mes réglages ci-dessous)"
alarmeProfil = not legacy and profManuel and not classeAct
alarmeLev = alarmeProfil and levVol >= expoMaxE - 0.01
alarmeSav = alarmeProfil and ready and scoreLocal < seuLoc / 3
alarmeFond = alarmeProfil and respectFondE
alarmeTxt = "⚠ RÉGLAGES D'ACTION SUR UN ACTIF DE CLASSE « " + classe + " » — prenez le profil « " + profAuto + " »" + (alarmeLev ? " · levier collé au plafond ×" + str.tostring(expoMaxE, "#.#") + " sur une volatilité de " + str.tostring(100 * sigA, "#.#") + " %" : "") + (alarmeSav ? " · savane jugée stérile en permanence (score " + str.tostring(scoreLocal, "#.##") + " contre un seuil de " + str.tostring(seuLoc, "#.##") + ")" : "") + (alarmeFond ? " · filtre de fond actif : " + (fond > 0 ? "shorts" : "longs") + " interdits, alors qu'une devise n'a pas de dérive structurelle" : "")
diagTxt = alarmeProfil ? alarmeTxt : eteint ? "☠ ÉTEINT : plancher de survie franchi, plus aucune exposition" : pacteAbri ? "l'Homme a ordonné l'abri — la savane attend son retour" : not ready ? "amorçage : encore " + str.tostring(math.max(0, 301 - bar_index)) + " bougies" : desert ? "⚠ DÉSERT : frais > proies sur cette unité de temps — passez en 1D" : vivantes == 0 ? "extinction : tout le monde à l'abri" : not quorumOk ? "meute DIVISÉE : " + str.tostring(100 * wPour / math.max(wTot, 1e-12), "#") + " % pour / " + str.tostring(100 * wContre / math.max(wTot, 1e-12), "#") + " % contre — écart " + str.tostring(100 * quorum, "#") + " % < quorum " + str.tostring(quorumMinE, "#") + " %, elle ne charge pas sur un pile ou face" : math.abs(dirJuge) < proieMinE ? "meute à l'affût : " + (voixE ? "partage des camps trop serré (" : "proie trop maigre (conviction brute ") + str.tostring(100 * math.abs(dirJuge), "#") + " % < " + str.tostring(100 * proieMinE, "#") + " %)" : desertOn ? "🏜 DÉSERT : savane stérile, la meute chasse quand même à " + str.tostring(100 * bipDesertE, "#") + " % — " + str.tostring(vivantes) + " espèces se nourrissent, écart " + str.tostring(100 * quorum, "#") + " %" : not savaneOk ? "savane locale stérile — migration conseillée : " + migrTxt : str.tostring(vivantes) + "/" + str.tostring(bipOnE ? 17 : 16) + " vivantes · " + str.tostring(naissances) + " naissances · la meute charge, cap " + (dir > 0.05 ? "haussier" : dir < -0.05 ? "baissier" : "neutre")
diagCol = alarmeProfil ? color.new(color.red, 55) : eteint ? color.new(color.red, 60) : ready and not desert and (savaneOk or desertOn) and vivantes > 0 ? color.new(color.teal, 70) : color.new(color.orange, 80)
alphaNom = (bestFit == fit1 ? "Guépard " + str.tostring(L1) : bestFit == fit2 ? "Loup " + str.tostring(L2) : bestFit == fit3 ? "Ours " + str.tostring(L3) : bestFit == fit4 ? "Éléphant " + str.tostring(L4) : bestFit == fit5 ? "Baleine " + str.tostring(L5) : bestFit == fit6 ? "Colibri " + str.tostring(L6) : bestFit == fit7 ? "Renard " + str.tostring(L7) : bestFit == fit8 ? "Chouette " + str.tostring(L8) : bestFit == fit9 ? "Aigle " + str.tostring(lbFond) : bestFit == fit10 ? "Crocodile 55" : bestFit == fit11 ? "Hyène 20" : bestFit == fit12 ? "Panthère " + str.tostring(L12) : bestFit == fit13 ? "Lynx " + str.tostring(L13) : bestFit == fit14 ? "Bison " + str.tostring(L14) : bestFit == fit15 ? "Serpent " + str.tostring(L15) : bipOnE and bestFit == fit17 ? "Bip-Bip " + str.tostring(L17) : "Vautour 40") + "b · forme " + str.tostring(10000 * bestFit, "#.#") + " pb" + (bestFit > 0 ? " — il mange le premier" : " — toute la meute a faim")
partCont = wTot > 0 ? 100 * (w6 + w7 + w8 + w11 + w15 + w16) / wTot : 0
fondTxt = (fond > 0 ? "haussière ▲" : "baissière ▼") + " sur " + str.tostring(lbFond) + " bougies" + (respectFondE ? " · " + (fond > 0 ? "shorts interdits" : "longs interdits") : " · filtre désactivé") + " · contrariennes " + str.tostring(partCont, "#") + " % (max " + str.tostring(contMaxE, "#") + " %)"
immTxt = immun > 0 ? "BOUCLIER : convalescence " + str.tostring(immun, "#") + " bougies" : "au repos, seuil " + str.tostring(chocSeuil, "#.#") + " écarts-types"
immCol = immun > 0 ? color.new(color.red, 70) : color.new(color.gray, 85)
meteoTxt = "score " + str.tostring(scoreLocal, "#.##") + " (seuil " + str.tostring(seuLoc, "#.##") + " · fenêtre " + str.tostring(lbSav) + " bougies) · entropie " + str.tostring(100 * entropie, "#.#") + " % (max " + str.tostring(100 * entMaxE, "#.#") + " %)" + (savaneOk ? " ✓ propice" : " ✗ stérile")
meteoCol = savaneOk ? color.new(color.teal, 70) : color.new(color.orange, 70)
profTxt = (alarmeProfil ? alarmeTxt + " ‖ " : "") + prof + " · classe " + classe + (legacy ? " · HÉRITAGE G9" : "") + " · seuil " + str.tostring(savaneMinE, "#.##") + " · entropie max " + str.tostring(entMaxE, "#.###") + " · vol cible " + str.tostring(targetVolE, "#") + " % · levier max ×" + str.tostring(expoMaxE, "#.#") + " · proie " + str.tostring(proieMinE, "#.##") + " · frais sél. " + str.tostring(fraisE, "#.###") + " % · lion ^" + str.tostring(hierarchieE, "#.#") + " · contrariennes " + str.tostring(contMaxE, "#") + " % · fond " + (respectFondE ? "respecté" : "libre") + " · respiration " + str.tostring(respireE) + " · borne " + str.tostring(ddMaxE, "#") + " %"
profCol = alarmeProfil ? color.new(color.red, 55) : legacy ? color.new(color.gray, 80) : pFx or pMet ? color.new(color.blue, 75) : pAct ? color.new(color.orange, 82) : color.new(color.gray, 85)
bipTxt = (chasseDesertE ? "désert : la meute chasse à " + str.tostring(100 * bipDesertE, "#") + " %" + (desertOn ? " — EN COURS" : " — savane grasse, pleine puissance") : "désert : chasse interdite, la colonie s'abrite") + " · Bip-Bip " + (not bipOnE ? "désarmé (16 espèces)" : str.tostring(L17) + "b g" + str.tostring(g17) + " " + (sig17 > 0 ? "▲" : "▼") + " " + str.tostring(10000 * fit17, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w17 / wTot : 0, "#") + " % de la meute")
bipCol = desertOn ? color.new(color.orange, 68) : chasseDesertE ? color.new(color.teal, 80) : color.new(color.gray, 88)
convTxt = "quorum " + str.tostring(100 * quorum, "#") + " % (min " + str.tostring(quorumMinE, "#") + " %) — " + str.tostring(100 * wPour / math.max(wTot, 1e-12), "#") + " % pour / " + str.tostring(100 * wContre / math.max(wTot, 1e-12), "#") + " % contre" + (quorumOk ? " ✓" : " ✗ DIVISÉE") + " · " + (voixE ? "VOIX DE LA MEUTE " + str.tostring(100 * dirVote, "#.#") + " % sur la bougie (lissée 5 b : " + str.tostring(100 * dirVoteS, "#.#") + " % — non utilisée pour décider) · moyenne des signaux " + str.tostring(100 * dirS, "#.#") + " %, écartée" : "brute " + str.tostring(100 * dirS, "#.#") + " %") + (convNormE ? " → normalisée " + str.tostring(100 * dirUse, "#.#") + " % (amplitude de référence " + str.tostring(100 * convRef, "#.#") + " %)" : " (normalisation désactivée : la meute n'utilise qu'une fraction du levier autorisé)")
convCol = not quorumOk ? color.new(color.orange, 70) : convNormE ? color.new(color.teal, 80) : color.new(color.gray, 85)
e1 = "Guépard " + str.tostring(L1) + "b g" + str.tostring(g1) + " " + (sig1 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit1, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w1 / wTot : 0, "#") + " %"
e2 = "Loup " + str.tostring(L2) + "b g" + str.tostring(g2) + " " + (sig2 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit2, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w2 / wTot : 0, "#") + " %"
e3 = "Ours " + str.tostring(L3) + "b g" + str.tostring(g3) + " " + (sig3 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit3, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w3 / wTot : 0, "#") + " %"
e4 = "Éléphant " + str.tostring(L4) + "b g" + str.tostring(g4) + " " + (sig4 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit4, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w4 / wTot : 0, "#") + " %"
e5 = "Baleine " + str.tostring(L5) + "b g" + str.tostring(g5) + " " + (sig5 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit5, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w5 / wTot : 0, "#") + " %"
e6 = "Colibri " + str.tostring(L6) + "b g" + str.tostring(g6) + " " + (sig6 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit6, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w6 / wTot : 0, "#") + " %"
e7 = "Renard " + str.tostring(L7) + "b g" + str.tostring(g7) + " " + (sig7 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit7, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w7 / wTot : 0, "#") + " %"
e8 = "Chouette " + str.tostring(L8) + "b g" + str.tostring(g8) + " " + (sig8 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit8, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w8 / wTot : 0, "#") + " %"
e9 = "Aigle " + str.tostring(lbFond) + "b (dollar inversé) " + (sig9 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit9, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w9 / wTot : 0, "#") + " %"
e10 = "Crocodile 55b (embuscade) " + (sig10 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit10, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w10 / wTot : 0, "#") + " %"
e11 = "Hyène 20b (charognard) " + (sig11 > 0 ? "▲ festin" : "— rôde") + " · " + str.tostring(10000 * fit11, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w11 / wTot : 0, "#") + " %"
e12 = "Panthère " + str.tostring(L12) + "b g" + str.tostring(g12) + " " + (sig12 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit12, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w12 / wTot : 0, "#") + " %"
e13 = "Lynx " + str.tostring(L13) + "b g" + str.tostring(g13) + " " + (sig13 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit13, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w13 / wTot : 0, "#") + " %"
e14 = "Bison " + str.tostring(L14) + "b g" + str.tostring(g14) + " " + (sig14 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit14, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w14 / wTot : 0, "#") + " %"
e15 = "Serpent " + str.tostring(L15) + "b g" + str.tostring(g15) + " " + (sig15 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit15, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w15 / wTot : 0, "#") + " %"
e16 = "Vautour 40b (grands charniers) " + (sig16 > 0 ? "▲ festin" : "— plane") + " · " + str.tostring(10000 * fit16, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w16 / wTot : 0, "#") + " %"
c1c = fit1 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c2c = fit2 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c3c = fit3 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c4c = fit4 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c5c = fit5 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c6c = fit6 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c7c = fit7 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c8c = fit8 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c9c = fit9 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c10c = fit10 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c11c = fit11 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c12c = fit12 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c13c = fit13 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
