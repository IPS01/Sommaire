sym19 = input.symbol("TVC:UKOIL", "", inline = "s19", group = "Les savanes lointaines")
seu19 = input.float(0.0, "seuil", minval = 0.0, maxval = 3.0, step = 0.05, inline = "s19", group = "Les savanes lointaines")
