//@version=6
// ============================================================================
//
//   LE ROI DU CHANGE — moteur dédié FOREX, quinze espèces
//
//   CE CODE N'EST PAS UNE VARIANTE DU ROI DE LA SAVANE. C'est un moteur écrit
//   pour un seul terrain, et chacun de ses réglages sort d'un backtest mesuré,
//   pas d'un raisonnement.
//
//   COMMENT IL A ÉTÉ CONSTRUIT
//   Banc d'essai : portage du moteur en Python, 20 tests unitaires (dont le
//   test anti-regard-vers-le-futur), nourri de 6 926 séances EURUSD réelles
//   (1999-2026, Réserve fédérale H.10) plus un panier de huit devises.
//   Protocole : toute configuration est calibrée sur 1999-2015 SEULEMENT, puis
//   rejouée sur 2016-2026 — jamais vues — en DEUX moitiés séparées. Une
//   configuration n'est retenue que si elle gagne sur les deux.
//
//   CE QUI A ÉTÉ ESSAYÉ ET REJETÉ (tout est vérifiable, rien n'est théorique)
//   • Retour à la moyenne 20-100 bougies ......... facteur de profit 0,42
//   • Suivi de tendance court, réglage optimisé .. +25 316 en calibration,
//        puis 0 configuration sur 16 ne survit hors échantillon
//   • Momentum relatif entre 8 devises ........... +16 938 en calibration,
//        puis 0 configuration sur 10 ne survit hors échantillon
//   • Espèce de cassure (la Gazelle) ............. dégrade la meute partout
//   • Réagir plus vite (1 bougie au lieu de 12) .. -1 595 au lieu de +5 943
//   Trois conceptions différentes, toutes brillantes sur le passé qu'on avait
//   optimisé, toutes mortes sur le futur. C'est la leçon centrale de ce
//   fichier : un backtest qui brille sur ses propres données ne prouve rien.
//
//   CE QUI SURVIT, ET QUI EST ICI
//   La MEUTE — quinze espèces qui chassent différemment et se partagent le
//   capital selon leur forme récente. Testée sur les deux moitiés :
//        2016 - juin 2021 ....... +3 876
//        juin 2021 - 2026 ....... +2 853
//   soit +6 729 sur dix ans à partir de 10 000, facteur de profit 1,52,
//   ~150 ordres, pire perte 41 %.
//
//   POURQUOI QUINZE ET PAS UNE SEULE
//   Le banc a retiré des familles entières pour voir ce qui tenait :
//        tendance seule .................. casse
//        contrariennes seules ............ casse
//        tendance + contrariennes ........ casse
//        sans les fossiles ............... casse
//        les quinze ...................... TIENT
//   Aucune famille ne gagne seule. C'est leur DÉSACCORD qui produit le
//   résultat. Et les fossiles sont indispensables : l'Aigle lit l'indice
//   dollar, une information que l'EURUSD ne contient pas.
//
//   CE QUE CE MOTEUR NE FERA PAS
//   Il ne fera pas 300 000 avec 10 000. L'EURUSD a parcouru 79,7 % d'amplitude
//   entre 1999 et 2007 ; il n'en parcourt plus que 20 à 27 % depuis 2016, avec
//   30 % de volatilité en moins. Le terrain s'est rétréci d'un facteur trois.
//   Ce moteur en tire ~5 % par an. C'est peu, c'est vrai, et c'est mesuré.
//
//   STRUCTURE ANTI-COLLAGE : aucune boucle, aucune fonction utilisateur, et
//   UNE SEULE ligne indentée dans tout le fichier — la toute dernière.
//   APRÈS COLLAGE, VÉRIFIEZ : une seule ligne indentée, et c'est la dernière.
// ============================================================================

strategy("Le Roi du Change [forex, quinze espèces]", shorttitle = "Roi du Change", overlay = true, initial_capital = 10000, currency = currency.NONE, commission_type = strategy.commission.percent, commission_value = 0.005, slippage = 1, calc_on_every_tick = false, process_orders_on_close = true, pyramiding = 150, margin_long = 5, margin_short = 5, max_bars_back = 1000)

// ============================================================================
// RÉGLAGES — les valeurs par défaut SONT celles validées par le banc.
// Les modifier, c'est quitter la seule configuration qui ait passé le test.
// ============================================================================
enableLongs = input.bool(true, "Autoriser les achats", group = "Direction")
enableShorts = input.bool(true, "Autoriser les ventes", group = "Direction")

fitMem = input.int(63, "Mémoire de la forme (demi-vie, bougies)", minval = 10, maxval = 500, group = "Sélection naturelle", tooltip = "La forme d'une espèce est la moyenne exponentielle de ses gains. 63 = un trimestre : validé.")
frais = input.float(0.05, "Frais de sélection (%)", minval = 0.0, maxval = 0.5, step = 0.005, group = "Sélection naturelle", tooltip = "VOLONTAIREMENT SURESTIMÉ. Le spread réel de l'EURUSD est proche de 0,01 %. En facturant 0,05 % aux espèces, on affame celles qui ne vivent que de bruit et on ne garde que celles dont l'avantage paie vraiment la friction. Le banc a testé 0,005 à 0,07 : 0,05 est le seul qui tienne sur les deux moitiés.")
divBonus = input.float(0.5, "Bonus de niche (récompense de la différence)", minval = 0.0, maxval = 1.0, step = 0.1, group = "Sélection naturelle")
contMax = input.float(90.0, "Part maximale des contrariennes (%)", minval = 0.0, maxval = 100.0, step = 5.0, group = "Sélection naturelle", tooltip = "90 % sur devises, contre 80 % sur actions. Une devise n'a pas de dérive haussière structurelle : rien n'interdit aux contrariennes de dominer, et sur l'EURUSD elles sont les mieux nourries. Le plafond ne sert plus qu'à éviter l'unanimité totale.")
hierarchie = input.float(3.0, "Part du lion (hiérarchie de la meute)", minval = 1.0, maxval = 4.0, step = 0.5, group = "La meute")
proieMin = input.float(0.06, "Proie minimale (conviction requise)", minval = 0.0, maxval = 0.5, step = 0.01, group = "La meute", tooltip = "En dessous de cette conviction collective, la meute reste à l'affût sans dépenser un centime de frais.")
convNorm = input.bool(true, "Normaliser la conviction (utiliser tout le budget de risque)", group = "La meute", tooltip = "La conviction collective vaut typiquement 0,30 : sans normalisation la meute n'utilise que 30 % du levier autorisé. Normalisée par sa propre amplitude moyenne, elle couvre la plage ±1 et le ciblage de volatilité redevient le maître de la taille.")

targetVol = input.float(40.0, "Volatilité cible du portefeuille (% par an)", minval = 2, maxval = 200, step = 1, group = "Homéostasie", tooltip = "Le banc a mesuré : 25 %/x4 donne +4 241 ; 40 %/x6 donne +5 943 ; 80 %/x10 donne +8 585 mais avec 50 % de perte maximale. 40 % est le point où le gain justifie encore le risque.")
volWin = input.int(63, "Fenêtre de mesure de volatilité", minval = 20, group = "Homéostasie")
expoMax = input.float(6.0, "Exposition maximale (× capital)", minval = 0.5, maxval = 20, step = 0.5, group = "Homéostasie")
rebalPct = input.float(25.0, "Zone morte de rééquilibrage (% d'écart)", minval = 5, maxval = 50, step = 1, group = "Homéostasie")
respire = input.int(12, "Respiration : rééquilibrage toutes les X bougies", minval = 1, maxval = 30, group = "Homéostasie", tooltip = "MESURE DÉCISIVE. Réagir toutes les bougies : -1 595. Toutes les 5 : +948. Toutes les 8 : +5 961. Toutes les 12 : +5 943. Toutes les 20 : -309. La vitesse ne paie pas — elle paie le spread.")

ddMax = input.float(50.0, "Borne : perte maximale depuis le sommet (%)", minval = 5, maxval = 50, step = 1, group = "Survie", tooltip = "L'exposition décroît à mesure que la perte s'approche de cette borne. Atteinte, la chasse tombe à son plancher de 15 % — jamais à zéro : à exposition nulle l'équité se fige, le sommet reste haut, et la colonie ne pourrait plus jamais se refaire.")
plancher = input.float(50.0, "Extinction définitive sous (% du capital initial)", minval = 10.0, maxval = 95.0, step = 5.0, group = "Survie")
chocSeuil = input.float(4.0, "Choc immunitaire (mouvement en écarts-types)", minval = 2.0, maxval = 8.0, step = 0.5, group = "Survie")
chocDuree = input.int(1, "Convalescence après choc (bougies)", minval = 1, maxval = 100, group = "Survie")
pacteAbri = input.bool(false, "ORDRE SOUVERAIN : toute la colonie à l'abri", group = "Survie")

starveMax = input.int(150, "Famine mortelle (bougies en forme négative)", minval = 30, maxval = 1000, group = "Évolution")
soinParent = input.float(25.0, "Soin parental (% de la vigueur héritée)", minval = 0.0, maxval = 100.0, step = 5.0, group = "Évolution")

bouOn = input.bool(false, "LA BOUSSOLE : armer la force relative des huit devises", group = "La boussole (force des devises)", tooltip = "Elle construit la force de chaque monnaie contre le panier des huit, les classe, et donne à la meute l'écart de rang entre les deux monnaies de VOTRE paire — détectées automatiquement. Mesure honnête du banc, sur les deux moitiés hors échantillon : elle ne casse jamais la meute (7 réglages testés sur 7 tiennent), mais son apport n'est pas fiable — +2 006 à 15 bougies, +308 à 20, -3 836 à 50. La médiane est légèrement négative. Elle est donc DÉSARMÉE par défaut : armez-la pour expérimenter, pas parce qu'un chiffre vous a plu.")
bouLook = input.int(20, "Boussole : fenêtre de mesure de la force", minval = 5, maxval = 250, group = "La boussole (force des devises)")
symEU = input.symbol("OANDA:EURUSD", "EUR/USD", group = "La boussole (force des devises)")
symGU = input.symbol("OANDA:GBPUSD", "GBP/USD", group = "La boussole (force des devises)")
symAU = input.symbol("OANDA:AUDUSD", "AUD/USD", group = "La boussole (force des devises)")
symNU = input.symbol("OANDA:NZDUSD", "NZD/USD", group = "La boussole (force des devises)")
symUJ = input.symbol("OANDA:USDJPY", "USD/JPY", group = "La boussole (force des devises)")
symUC = input.symbol("OANDA:USDCHF", "USD/CHF", group = "La boussole (force des devises)")
symUD = input.symbol("OANDA:USDCAD", "USD/CAD", group = "La boussole (force des devises)")
symDollar = input.symbol("TVC:DXY", "L'Aigle : indice dollar", group = "Le regard extérieur", tooltip = "INDISPENSABLE. Le banc a retiré les fossiles : le moteur casse (-1 144 sur la première moitié). L'Aigle lit l'indice dollar, une information que la paire seule ne contient pas. Sur une paire sans USD, mettez l'indice de la devise dominante.")

startDate = input.time(timestamp("1 Jan 2016 00:00 +0000"), "Début", group = "Période de backtest")
endDate = input.time(timestamp("1 Jan 2035 00:00 +0000"), "Fin", group = "Période de backtest")
inDate = time >= startDate and time <= endDate

// ============================================================================
// MESURES DE BASE
// ============================================================================
v = math.log(close / nz(close[1], close))
sdBar = ta.stdev(v, 50)
lamF = math.pow(0.5, 1.0 / fitMem)
fr = frais / 100
ready = bar_index > 300
lbAn = timeframe.ismonthly ? 12 : timeframe.isweekly ? 52 : 252
barsAn = timeframe.ismonthly ? 12.0 : timeframe.isweekly ? 52.0 : timeframe.isdaily ? 252.0 : 252.0 * 86400.0 / math.max(60.0, timeframe.in_seconds())

// ============================================================================
// LE GÉNOME : rythme de chaque espèce (mutable, borné par son habitat)
// ============================================================================
var int L1 = 10
var int L2 = 21
var int L3 = 63
var int L4 = 126
var int L5 = 252
var int L6 = 2
var int L7 = 5
var int L8 = 10
var int L11 = 8
var int L12 = 30
var int L13 = 150
var int L14 = 3
var int L15 = 3
var int g1 = 1
var int g2 = 1
var int g3 = 1
var int g4 = 1
var int g5 = 1
var int g6 = 1
var int g7 = 1
var int g8 = 1
var int g11 = 1
var int g12 = 1
var int g13 = 1
var int g14 = 1
var int g15 = 1
var float stv1 = 0.0
var float stv2 = 0.0
var float stv3 = 0.0
var float stv4 = 0.0
var float stv5 = 0.0
var float stv6 = 0.0
var float stv7 = 0.0
var float stv8 = 0.0
var float stv11 = 0.0
var float stv12 = 0.0
var float stv13 = 0.0
var float stv14 = 0.0
var float stv15 = 0.0

// ============================================================================
// L'INSTINCT : conviction = mouvement / bruit, bornée à ±1
// LES SUIVEUSES DE TENDANCE
// ============================================================================
d1 = sdBar * math.sqrt(L1)
d2 = sdBar * math.sqrt(L2)
d3 = sdBar * math.sqrt(L3)
d4 = sdBar * math.sqrt(L4)
d5 = sdBar * math.sqrt(L5)
d11 = sdBar * math.sqrt(L11)
d12 = sdBar * math.sqrt(L12)
d13 = sdBar * math.sqrt(L13)
sig1 = d1 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L1], close)) / d1)) : 0.0
sig2 = d2 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L2], close)) / d2)) : 0.0
sig3 = d3 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L3], close)) / d3)) : 0.0
sig4 = d4 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L4], close)) / d4)) : 0.0
sig5 = d5 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L5], close)) / d5)) : 0.0
sig11 = d11 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L11], close)) / d11)) : 0.0
sig12 = d12 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L12], close)) / d12)) : 0.0
sig13 = d13 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L13], close)) / d13)) : 0.0
// LE BIP-BIP : momentum ultra-court, gain 3,5 avant saturation. Le banc l'a
// testé absent : la meute perd 5 900 de performance. Il reste.
d15 = sdBar * math.sqrt(L15)
sig15 = d15 > 0 ? math.max(-1.0, math.min(1.0, 3.5 * math.log(close / nz(close[L15], close)) / d15)) : 0.0

// LES CONTRARIENNES — sur devises, ce sont elles qui se nourrissent le mieux
d6 = sdBar * math.sqrt(L6)
d7 = sdBar * math.sqrt(L7)
d8 = sdBar * math.sqrt(L8)
d14 = sdBar * math.sqrt(L14)
sig6 = d6 > 0 ? -math.max(-1.0, math.min(1.0, math.log(close / nz(close[L6], close)) / d6)) : 0.0
sig7 = d7 > 0 ? -math.max(-1.0, math.min(1.0, math.log(close / nz(close[L7], close)) / d7)) : 0.0
sig8 = d8 > 0 ? -math.max(-1.0, math.min(1.0, math.log(close / nz(close[L8], close)) / d8)) : 0.0
sig14 = d14 > 0 ? -math.max(-1.0, math.min(1.0, math.log(close / nz(close[L14], close)) / d14)) : 0.0

// LES FOSSILES — génome figé, et indispensables : sans eux le moteur casse.
cAigle = request.security(symDollar, timeframe.period, close)
vAigle = math.log(cAigle / nz(cAigle[1], cAigle))
sdAigle = ta.stdev(vAigle, 50)
dAigle = sdAigle * math.sqrt(lbAn)
sig9 = dAigle > 0 ? -math.max(-1.0, math.min(1.0, math.log(cAigle / nz(cAigle[lbAn], cAigle)) / dAigle)) : 0.0
hCroco = ta.highest(close, 55)
lCroco = ta.lowest(close, 55)
sig10 = (hCroco - lCroco) > 0 ? math.max(-1.0, math.min(1.0, (close - (hCroco + lCroco) / 2) / ((hCroco - lCroco) / 2))) : 0.0

// ============================================================================
// LA BOUSSOLE : force relative des huit devises, paire détectée toute seule
// Chaque monnaie est valorisée contre l'USD, on prend son rendement sur
// bouLook bougies, on retire la moyenne du panier — il reste sa force PROPRE.
// Le classement se fait sans boucle : le rang d'une monnaie, c'est le nombre
// de monnaies plus fortes qu'elle. Puis on lit le rang des deux monnaies de
// la paire affichée, via syminfo : rien à régler à la main.
// ============================================================================
cEU = request.security(symEU, timeframe.period, close)
cGU = request.security(symGU, timeframe.period, close)
cAU = request.security(symAU, timeframe.period, close)
cNU = request.security(symNU, timeframe.period, close)
cUJ = request.security(symUJ, timeframe.period, close)
cUC = request.security(symUC, timeframe.period, close)
cUD = request.security(symUD, timeframe.period, close)
vEUR = nz(cEU, 1.0)
vGBP = nz(cGU, 1.0)
vAUD = nz(cAU, 1.0)
vNZD = nz(cNU, 1.0)
vJPY = 1.0 / math.max(nz(cUJ, 1.0), 1e-9)
vCHF = 1.0 / math.max(nz(cUC, 1.0), 1e-9)
vCAD = 1.0 / math.max(nz(cUD, 1.0), 1e-9)
rEUR = math.log(vEUR / nz(vEUR[bouLook], vEUR))
rGBP = math.log(vGBP / nz(vGBP[bouLook], vGBP))
rAUD = math.log(vAUD / nz(vAUD[bouLook], vAUD))
rNZD = math.log(vNZD / nz(vNZD[bouLook], vNZD))
rJPY = math.log(vJPY / nz(vJPY[bouLook], vJPY))
rCHF = math.log(vCHF / nz(vCHF[bouLook], vCHF))
rCAD = math.log(vCAD / nz(vCAD[bouLook], vCAD))
rUSD = 0.0
moyPanier = (rEUR + rGBP + rAUD + rNZD + rJPY + rCHF + rCAD + rUSD) / 8.0
fEUR = rEUR - moyPanier
fGBP = rGBP - moyPanier
fAUD = rAUD - moyPanier
fNZD = rNZD - moyPanier
fJPY = rJPY - moyPanier
fCHF = rCHF - moyPanier
fCAD = rCAD - moyPanier
fUSD = rUSD - moyPanier
// rang = combien de monnaies sont PLUS FORTES (0 = la plus forte de toutes)
kEUR = (fGBP > fEUR ? 1 : 0) + (fAUD > fEUR ? 1 : 0) + (fNZD > fEUR ? 1 : 0) + (fJPY > fEUR ? 1 : 0) + (fCHF > fEUR ? 1 : 0) + (fCAD > fEUR ? 1 : 0) + (fUSD > fEUR ? 1 : 0)
kGBP = (fEUR > fGBP ? 1 : 0) + (fAUD > fGBP ? 1 : 0) + (fNZD > fGBP ? 1 : 0) + (fJPY > fGBP ? 1 : 0) + (fCHF > fGBP ? 1 : 0) + (fCAD > fGBP ? 1 : 0) + (fUSD > fGBP ? 1 : 0)
kAUD = (fEUR > fAUD ? 1 : 0) + (fGBP > fAUD ? 1 : 0) + (fNZD > fAUD ? 1 : 0) + (fJPY > fAUD ? 1 : 0) + (fCHF > fAUD ? 1 : 0) + (fCAD > fAUD ? 1 : 0) + (fUSD > fAUD ? 1 : 0)
kNZD = (fEUR > fNZD ? 1 : 0) + (fGBP > fNZD ? 1 : 0) + (fAUD > fNZD ? 1 : 0) + (fJPY > fNZD ? 1 : 0) + (fCHF > fNZD ? 1 : 0) + (fCAD > fNZD ? 1 : 0) + (fUSD > fNZD ? 1 : 0)
kJPY = (fEUR > fJPY ? 1 : 0) + (fGBP > fJPY ? 1 : 0) + (fAUD > fJPY ? 1 : 0) + (fNZD > fJPY ? 1 : 0) + (fCHF > fJPY ? 1 : 0) + (fCAD > fJPY ? 1 : 0) + (fUSD > fJPY ? 1 : 0)
kCHF = (fEUR > fCHF ? 1 : 0) + (fGBP > fCHF ? 1 : 0) + (fAUD > fCHF ? 1 : 0) + (fNZD > fCHF ? 1 : 0) + (fJPY > fCHF ? 1 : 0) + (fCAD > fCHF ? 1 : 0) + (fUSD > fCHF ? 1 : 0)
kCAD = (fEUR > fCAD ? 1 : 0) + (fGBP > fCAD ? 1 : 0) + (fAUD > fCAD ? 1 : 0) + (fNZD > fCAD ? 1 : 0) + (fJPY > fCAD ? 1 : 0) + (fCHF > fCAD ? 1 : 0) + (fUSD > fCAD ? 1 : 0)
kUSD = (fEUR > fUSD ? 1 : 0) + (fGBP > fUSD ? 1 : 0) + (fAUD > fUSD ? 1 : 0) + (fNZD > fUSD ? 1 : 0) + (fJPY > fUSD ? 1 : 0) + (fCHF > fUSD ? 1 : 0) + (fCAD > fUSD ? 1 : 0)
// DETECTION AUTOMATIQUE DE LA PAIRE : syminfo donne la monnaie de base et la
// monnaie de cotation du graphique affiche. Une monnaie inconnue du panier
// prend le rang median (3,5), ce qui la rend neutre.
devBase = str.upper(syminfo.basecurrency)
devQuote = str.upper(syminfo.currency)
kBase = devBase == "EUR" ? kEUR : devBase == "GBP" ? kGBP : devBase == "AUD" ? kAUD : devBase == "NZD" ? kNZD : devBase == "JPY" ? kJPY : devBase == "CHF" ? kCHF : devBase == "CAD" ? kCAD : devBase == "USD" ? kUSD : 3.5
kQuote = devQuote == "EUR" ? kEUR : devQuote == "GBP" ? kGBP : devQuote == "AUD" ? kAUD : devQuote == "NZD" ? kNZD : devQuote == "JPY" ? kJPY : devQuote == "CHF" ? kCHF : devQuote == "CAD" ? kCAD : devQuote == "USD" ? kUSD : 3.5
bouConnue = bouOn and kBase != 3.5 and kQuote != 3.5
sig16 = bouConnue ? (kQuote - kBase) / 7.0 : 0.0

// ============================================================================
// LA CHASSE VIRTUELLE : gain de chaque espèce, frais de sélection déduits
// ============================================================================
p1 = nz(sig1[1], 0.0) * v - math.abs(sig1 - nz(sig1[1], sig1)) * 0.5 * fr
p2 = nz(sig2[1], 0.0) * v - math.abs(sig2 - nz(sig2[1], sig2)) * 0.5 * fr
p3 = nz(sig3[1], 0.0) * v - math.abs(sig3 - nz(sig3[1], sig3)) * 0.5 * fr
p4 = nz(sig4[1], 0.0) * v - math.abs(sig4 - nz(sig4[1], sig4)) * 0.5 * fr
p5 = nz(sig5[1], 0.0) * v - math.abs(sig5 - nz(sig5[1], sig5)) * 0.5 * fr
p6 = nz(sig6[1], 0.0) * v - math.abs(sig6 - nz(sig6[1], sig6)) * 0.5 * fr
p7 = nz(sig7[1], 0.0) * v - math.abs(sig7 - nz(sig7[1], sig7)) * 0.5 * fr
p8 = nz(sig8[1], 0.0) * v - math.abs(sig8 - nz(sig8[1], sig8)) * 0.5 * fr
p9 = nz(sig9[1], 0.0) * v - math.abs(sig9 - nz(sig9[1], sig9)) * 0.5 * fr
p10 = nz(sig10[1], 0.0) * v - math.abs(sig10 - nz(sig10[1], sig10)) * 0.5 * fr
p11 = nz(sig11[1], 0.0) * v - math.abs(sig11 - nz(sig11[1], sig11)) * 0.5 * fr
p12 = nz(sig12[1], 0.0) * v - math.abs(sig12 - nz(sig12[1], sig12)) * 0.5 * fr
p13 = nz(sig13[1], 0.0) * v - math.abs(sig13 - nz(sig13[1], sig13)) * 0.5 * fr
p14 = nz(sig14[1], 0.0) * v - math.abs(sig14 - nz(sig14[1], sig14)) * 0.5 * fr
p15 = nz(sig15[1], 0.0) * v - math.abs(sig15 - nz(sig15[1], sig15)) * 0.5 * fr
p16 = nz(sig16[1], 0.0) * v - math.abs(sig16 - nz(sig16[1], sig16)) * 0.5 * fr
// Desarmee, la Boussole n'existe pas : le moteur redevient rigoureusement
// celui des quinze especes validees.
pEco = (p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9 + p10 + p11 + p12 + p13 + p14 + p15 + (bouConnue ? p16 : 0.0)) / (bouConnue ? 16.0 : 15.0)

// ============================================================================
// LA FORME : vigueur de chaque espèce (mémoire exponentielle)
// ============================================================================
var float fit1 = 0.0
var float fit2 = 0.0
var float fit3 = 0.0
var float fit4 = 0.0
