c15c = fit15 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c16c = not bouConnue ? color.new(color.gray, 94) : fit16 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
e16 = not bouOn ? "désarmée" : not bouConnue ? "paire hors panier (" + devBase + "/" + devQuote + ") — neutralisée" : devBase + " rang " + str.tostring(kBase + 1, "#") + "/8 · " + devQuote + " rang " + str.tostring(kQuote + 1, "#") + "/8 " + (sig16 > 0 ? "▲" : sig16 < 0 ? "▼" : "—") + " · " + str.tostring(10000 * fit16, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w16 / wTot : 0, "#") + " %"

var table info = table.new(position.top_right, 2, 25, border_width = 1)
table.cell(info, 0, 0, "État de la meute", text_size = size.small, bgcolor = color.new(color.orange, 80))
table.cell(info, 1, 0, diagTxt, text_size = size.small, bgcolor = diagCol)
table.cell(info, 0, 1, "Exposition cible / réelle", text_size = size.small, bgcolor = color.new(color.blue, 80))
table.cell(info, 1, 1, (fCible >= 0 ? "+" : "") + str.tostring(100 * fCible, "#.#") + " % / " + (expoActu >= 0 ? "+" : "") + str.tostring(100 * expoActu, "#.#") + " %", text_size = size.small, bgcolor = fCible > 0.01 ? color.new(color.teal, 70) : fCible < -0.01 ? color.new(color.red, 70) : color.new(color.gray, 85))
table.cell(info, 0, 2, "Tendance", text_size = size.small, bgcolor = c11c)
