table.cell(info, 0, 17, "Boussole (force des devises)", text_size = size.small, bgcolor = c16c)
table.cell(info, 1, 17, e16, text_size = size.small, bgcolor = c16c)
table.cell(info, 0, 18, "Le lion (alpha)", text_size = size.small, bgcolor = color.new(color.orange, 75))
table.cell(info, 1, 18, alphaNom, text_size = size.small, bgcolor = color.new(color.orange, 85))
table.cell(info, 0, 19, "Conviction de la meute", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 19, convTxt, text_size = size.small, bgcolor = color.new(color.blue, 85))
table.cell(info, 0, 20, "Contrariennes", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 20, str.tostring(partCont, "#") + " % de la meute (max " + str.tostring(contMax, "#") + " %)", text_size = size.small)
table.cell(info, 0, 21, "Volatilité réalisée → levier", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 21, str.tostring(100 * sigA, "#.#") + " % → ×" + str.tostring(levVol, "#.##") + " (plafond ×" + str.tostring(expoMax, "#.#") + ")", text_size = size.small)
table.cell(info, 0, 22, "Trades / réussite / PF", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 22, str.tostring(strategy.closedtrades) + " / " + str.tostring(winRate, "#.#") + " % / " + (na(pf) ? "—" : str.tostring(pf, "#.##")), text_size = size.small)
table.cell(info, 0, 23, "Profit net", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 23, str.tostring(strategy.netprofit, "#.##"), text_size = size.small)
table.cell(info, 0, 24, "Température (borne " + str.tostring(ddMax, "#") + " %)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 24, tempTxt, text_size = size.small, bgcolor = tempCol)

// ============================================================================
// ALERTES
// ============================================================================
alertcondition(doPlus, "Change : poussée haussière", "Le Roi du Change augmente son exposition haussière")
alertcondition(doMoins, "Change : poussée baissière", "Le Roi du Change réduit ou inverse son exposition")
alertcondition(naissance, "Change : naissance d'une espèce", "Une espèce est morte de faim, son enfant muté vient de naître")
alertcondition(choc, "Change : choc immunitaire", "Mouvement anormal détecté, bouclier levé")
alertcondition(dirChasse != 0 and dirChasse[1] == 0, "Change : la meute charge", "Conviction suffisante : la meute charge")
alertcondition(dirChasse == 0 and dirChasse[1] != 0, "Change : retour à l'affût", "Conviction insuffisante : la meute cesse de chasser")
alertcondition(torpeurLibre < 0.5 and torpeurLibre[1] >= 0.5, "Change : torpeur profonde", "La perte depuis le sommet dépasse la moitié de la borne")
alertcondition(eteint and not eteint[1], "Change : EXTINCTION", "Plancher de survie franchi : plus aucune exposition")

// ============================================================================
// LA CORRECTION DE POUSSÉE — UN SEUL BLOC, UNE SEULE LIGNE INDENTÉE, ET C'EST
// LA DERNIÈRE DU FICHIER. Rien ne la suit, donc rien ne peut s'y imbriquer par
// accident de collage. doPlus et doMoins ne peuvent être vrais en même temps.
// ============================================================================
if doPlus or doMoins
    strategy.order(doPlus ? "Change+" : "Change-", doPlus ? strategy.long : strategy.short, qty = math.abs(diffQty), comment = "cap " + str.tostring(100 * fCible, "#") + "%", alert_message = "RoiDuChange " + (doPlus ? "HAUSSE" : "BAISSE") + " vers " + str.tostring(100 * fCible, "#.#") + "% " + syminfo.ticker)
