//@version=6
// ============================================================================
// TENDANCE JOURNALIÈRE — Momentum temporel + ciblage de volatilité
//
// LA SEULE STRATÉGIE DONT L'AVANTAGE EST PROUVÉ PUBLIQUEMENT :
// le « time series momentum » (Moskowitz, Ooi & Pedersen 2012, vérifié sur
// plus d'un siècle et des dizaines de marchés) : ce qui a monté sur 3, 6 et
// 12 mois a une probabilité > 50 % de continuer. Petit avantage par trade,
// significatif par accumulation. Exploité avec de l'argent réel par les
// fonds CTA depuis 50 ans. Fonctionne en JOURNALIER (1D) — là où le
// mouvement visé écrase les frais.
//
// ARCHITECTURE (pilotage continu conservé) :
//   1) SIGNAL — vote de tendance sur 3 horizons : 3 mois (63 j), 6 mois
//      (126 j), 12 mois (252 j). De -3 à +3, gradué, pas binaire.
//   2) TAILLE — ciblage de volatilité : exposition = (vol cible / vol
//      réalisée) × vote/3. Marché calme = position pleine, marché agité =
//      position réduite. C'est la formule des fonds professionnels.
//   3) CORRECTION — la position est rééquilibrée vers la cible à chaque
//      bougie, avec zone morte anti-frais. Pas de stop qui claque : quand
//      la tendance faiblit, la position fond ; quand elle s'inverse, la
//      position s'inverse.
//
// HONNÊTETÉ : avantage prouvé ≠ gain garanti. Cette stratégie perd pendant
// les retournements brutaux et les longues phases sans tendance ; son
// avantage se mesure sur des années, pas sur des semaines. C'est le prix
// de la seule chose qui marche vraiment. À utiliser en 1D.
//
// STRUCTURE ANTI-COLLAGE : aucune boucle, aucune fonction utilisateur —
// les 2 seules lignes indentées sont les 2 dernières du fichier.
// ============================================================================

strategy("Tendance Journalière [Momentum temporel + ciblage de volatilité]", shorttitle = "Tendance 1D", overlay = true, initial_capital = 10000, currency = currency.EUR, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 2, calc_on_every_tick = false, process_orders_on_close = true, pyramiding = 99, margin_long = 5, margin_short = 5)

// ---------------------------------------------------------------- PARAMÈTRES
enableLongs = input.bool(true, "Autoriser les achats (long)", group = "Direction")
enableShorts = input.bool(true, "Autoriser les ventes (short)", group = "Direction")
lb1 = input.int(63, "Horizon court (jours)", minval = 20, group = "Tendance (momentum temporel)")
lb2 = input.int(126, "Horizon moyen (jours)", minval = 40, group = "Tendance (momentum temporel)")
lb3 = input.int(252, "Horizon long (jours)", minval = 60, group = "Tendance (momentum temporel)")
targetVol = input.float(15.0, "Volatilité cible du portefeuille (% par an)", minval = 2, maxval = 40, step = 1, group = "Ciblage de volatilité", tooltip = "L'exposition est dimensionnée pour que le portefeuille vive à ce niveau de risque : position pleine quand le marché est calme, réduite quand il s'agite. 10-20 % = standard des fonds professionnels.")
volWin = input.int(63, "Fenêtre de mesure de volatilité (jours)", minval = 20, group = "Ciblage de volatilité")
expoMax = input.float(3.0, "Exposition maximale (× capital)", minval = 0.5, maxval = 10, step = 0.5, group = "Ciblage de volatilité")
rebalPct = input.float(20.0, "Zone morte de rééquilibrage (% d'écart)", minval = 5, maxval = 50, step = 1, group = "Ciblage de volatilité", tooltip = "On ne corrige la position que si elle s'écarte de la cible de plus de X % — les frais ne doivent payer que les vraies corrections.")

startDate = input.time(timestamp("1 Jan 2010 00:00 +0000"), "Début", group = "Période de backtest")
endDate = input.time(timestamp("1 Jan 2035 00:00 +0000"), "Fin", group = "Période de backtest")

inDate = time >= startDate and time <= endDate

// ------------------------------- SIGNAL : VOTE DE TENDANCE SUR 3 HORIZONS
r = math.log(close / nz(close[1], close))
mom1 = close / close[lb1] - 1
mom2 = close / close[lb2] - 1
mom3 = close / close[lb3] - 1
vote = (mom1 > 0 ? 1 : -1) + (mom2 > 0 ? 1 : -1) + (mom3 > 0 ? 1 : -1)
ready = bar_index > lb3 + 10

// --------------------------- TAILLE : CIBLAGE DE VOLATILITÉ (PROFESSIONNEL)
sigA = ta.stdev(r, volWin) * math.sqrt(252)
levVol = sigA > 0 ? math.min(expoMax, (targetVol / 100) / sigA) : 0.0
fCible = ready and inDate ? vote / 3.0 * levVol : 0.0
fCible := enableLongs or fCible < 0 ? fCible : 0.0
fCible := enableShorts or fCible > 0 ? fCible : 0.0

// --------------------------- CORRECTION : RÉÉQUILIBRAGE AVEC ZONE MORTE
qtyCible = fCible * strategy.equity / close
diffQty = qtyCible - strategy.position_size
seuilQty = math.max(rebalPct / 100 * math.abs(qtyCible), 0.02 * strategy.equity / close)
doPlus = barstate.isconfirmed and diffQty > seuilQty
doMoins = barstate.isconfirmed and -diffQty > seuilQty

// ------------------------------------------------------------------ AFFICHAGE
bgcolor(not ready ? na : vote == 3 ? color.new(color.teal, 88) : vote == -3 ? color.new(color.red, 88) : vote > 0 ? color.new(color.teal, 95) : vote < 0 ? color.new(color.red, 95) : na)
plotshape(doPlus, "Renforcement haussier", shape.triangleup, location.belowbar, color.new(color.teal, 0), size = size.tiny)
plotshape(doMoins, "Renforcement baissier", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.tiny)

// ------------------------------------------- TABLEAU : POSTE DE PILOTAGE
expoActu = strategy.position_size * close / strategy.equity
voteTxt = (mom1 > 0 ? "▲" : "▼") + " 3 mois, " + (mom2 > 0 ? "▲" : "▼") + " 6 mois, " + (mom3 > 0 ? "▲" : "▼") + " 12 mois"
pousseTxt = (fCible >= 0 ? "+" : "") + str.tostring(100 * fCible, "#.#") + " % / " + (expoActu >= 0 ? "+" : "") + str.tostring(100 * expoActu, "#.#") + " %"
pousseCol = fCible > 0.01 ? color.new(color.teal, 70) : fCible < -0.01 ? color.new(color.red, 70) : color.new(color.gray, 85)
volTxt = str.tostring(100 * sigA, "#.#") + " % / cible " + str.tostring(targetVol, "#.#") + " % → levier ×" + str.tostring(levVol, "#.##")
winRate = strategy.closedtrades > 0 ? 100.0 * strategy.wintrades / strategy.closedtrades : 0.0
pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
diagTxt = not ready ? "amorçage : encore " + str.tostring(math.max(0, lb3 + 11 - bar_index)) + " bougies (passez en 1D !)" : vote == 0 ? "tendances contradictoires : exposition nulle" : "pilotage actif — tendance " + (vote > 0 ? "haussière " : "baissière ") + str.tostring(math.abs(vote)) + "/3"
diagCol = ready and vote != 0 ? color.new(color.teal, 70) : color.new(color.orange, 80)

var table info = table.new(position.top_right, 2, 9, border_width = 1)
table.cell(info, 0, 0, "État du pilote", text_size = size.small, bgcolor = color.new(color.orange, 80))
table.cell(info, 1, 0, diagTxt, text_size = size.small, bgcolor = diagCol)
table.cell(info, 0, 1, "Tendance (3 horizons)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 1, voteTxt, text_size = size.small)
table.cell(info, 0, 2, "Exposition cible / réelle", text_size = size.small, bgcolor = color.new(color.blue, 80))
table.cell(info, 1, 2, pousseTxt, text_size = size.small, bgcolor = pousseCol)
table.cell(info, 0, 3, "Volatilité réalisée (annuelle)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 3, volTxt, text_size = size.small)
table.cell(info, 0, 4, "Performance 12 mois de l'actif", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 4, str.tostring(100 * mom3, "#.#") + " %", text_size = size.small)
table.cell(info, 0, 5, "Trades / réussite", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 5, str.tostring(strategy.closedtrades) + " / " + str.tostring(winRate, "#.#") + " %", text_size = size.small)
table.cell(info, 0, 6, "Profit factor", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 6, na(pf) ? "—" : str.tostring(pf, "#.##"), text_size = size.small)
table.cell(info, 0, 7, "Profit net", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 7, str.tostring(strategy.netprofit, "#.##"), text_size = size.small)
table.cell(info, 0, 8, "Base scientifique", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 8, "Time Series Momentum (1880-2012+)", text_size = size.small)

// ------- CORRECTIONS DE POUSSÉE (les 2 seules lignes indentées, fin du fichier)
if doPlus
    strategy.order("Pousse+", strategy.long, qty = diffQty, comment = "cible " + str.tostring(100 * fCible, "#") + "%", alert_message = "Tendance1D HAUSSE exposition vers " + str.tostring(100 * fCible, "#.#") + "% " + syminfo.ticker)
if doMoins
    strategy.order("Pousse-", strategy.short, qty = -diffQty, comment = "cible " + str.tostring(100 * fCible, "#") + "%", alert_message = "Tendance1D BAISSE exposition vers " + str.tostring(100 * fCible, "#.#") + "% " + syminfo.ticker)
