//@version=6
// ============================================================================
// STRATÉGIE TRIPLE CONFLUENCE — Tendance + Momentum + Volatilité
// ----------------------------------------------------------------------------
// Compatible TradingView (Pine Script v6)
//
// Principe : on ne prend une position que lorsque 3 signaux indépendants
// sont alignés, ce qui filtre la majorité des faux signaux :
//   1) TENDANCE  : le prix est du bon côté de l'EMA 200 (filtre long terme)
//   2) SIGNAL    : le Supertrend bascule dans le sens de la tendance
//   3) MOMENTUM  : le RSI confirme (au-dessus de 50 pour un achat,
//                  en dessous de 50 pour une vente)
//   + filtre ADX optionnel pour éviter les marchés sans tendance (range)
//
// Gestion du risque intégrée :
//   - Taille de position calculée pour risquer un % fixe du capital
//   - Stop-loss basé sur l'ATR (s'adapte à la volatilité)
//   - Take-profit à un multiple du risque (ratio gain/risque réglable)
//   - Sortie anticipée optionnelle si le Supertrend se retourne
//
// AVERTISSEMENT : aucune stratégie n'est gagnante sur tous les marchés ni
// à toutes les périodes. Backtestez sur votre actif / unité de temps,
// puis validez en paper trading avant tout argent réel.
// ============================================================================

strategy("Triple Confluence [Tendance+Momentum+Volatilité]",
     shorttitle   = "Triple Confluence",
     overlay      = true,
     initial_capital        = 10000,
     currency               = currency.EUR,
     commission_type        = strategy.commission.percent,
     commission_value       = 0.05,
     slippage               = 2,
     calc_on_every_tick     = false,
     process_orders_on_close = true,
     pyramiding             = 0)

// ----------------------------------------------------------------------------
// PARAMÈTRES
// ----------------------------------------------------------------------------
grpDir   = "Direction"
enableLongs  = input.bool(true,  "Autoriser les achats (long)",  group = grpDir)
enableShorts = input.bool(false, "Autoriser les ventes (short)", group = grpDir)

grpTrend = "1) Filtre de tendance"
emaLen   = input.int(200, "Période EMA de tendance", minval = 10, group = grpTrend)

grpSig   = "2) Signal Supertrend"
stFactor = input.float(3.0, "Facteur Supertrend", minval = 0.5, step = 0.1, group = grpSig)
stAtrLen = input.int(10, "Période ATR du Supertrend", minval = 1, group = grpSig)

grpMom   = "3) Momentum RSI"
rsiLen   = input.int(14, "Période RSI", minval = 2, group = grpMom)
rsiMid   = input.float(50, "Seuil RSI (confirmation)", minval = 30, maxval = 70, group = grpMom)

grpAdx   = "Filtre ADX (anti-range)"
useAdx   = input.bool(true, "Activer le filtre ADX", group = grpAdx)
adxLen   = input.int(14, "Période ADX", minval = 1, group = grpAdx)
adxMin   = input.float(20, "ADX minimum", minval = 5, maxval = 50, group = grpAdx)

grpRisk  = "Gestion du risque"
riskPct  = input.float(1.0, "Risque par trade (% du capital)", minval = 0.1, maxval = 10, step = 0.1, group = grpRisk)
atrLen   = input.int(14, "Période ATR (stop)", minval = 1, group = grpRisk)
atrMult  = input.float(2.0, "Multiplicateur ATR du stop", minval = 0.5, step = 0.1, group = grpRisk)
rrRatio  = input.float(2.0, "Ratio gain/risque (take-profit)", minval = 0.5, step = 0.1, group = grpRisk)
useTrail = input.bool(true, "Sortie anticipée si le Supertrend se retourne", group = grpRisk)

grpDate  = "Période de backtest"
startDate = input.time(timestamp("1 Jan 2018 00:00 +0000"), "Début", group = grpDate)
endDate   = input.time(timestamp("1 Jan 2035 00:00 +0000"), "Fin",   group = grpDate)

// ----------------------------------------------------------------------------
// INDICATEURS
// ----------------------------------------------------------------------------
emaTrend = ta.ema(close, emaLen)
[stLine, stDir] = ta.supertrend(stFactor, stAtrLen)   // stDir < 0 : haussier, > 0 : baissier
rsiVal   = ta.rsi(close, rsiLen)
atrVal   = ta.atr(atrLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

inDate    = time >= startDate and time <= endDate
adxOk     = not useAdx or adxVal >= adxMin

trendUp   = close > emaTrend
trendDown = close < emaTrend

flipUp    = ta.change(stDir) < 0    // Supertrend passe haussier
flipDown  = ta.change(stDir) > 0    // Supertrend passe baissier

longSignal  = enableLongs  and inDate and adxOk and trendUp   and flipUp   and rsiVal > rsiMid
shortSignal = enableShorts and inDate and adxOk and trendDown and flipDown and rsiVal < rsiMid

// ----------------------------------------------------------------------------
// TAILLE DE POSITION (risque fixe en % du capital)
// ----------------------------------------------------------------------------
stopDist  = atrMult * atrVal
riskCash  = strategy.equity * riskPct / 100
posSize   = stopDist > 0 ? riskCash / stopDist : 0

// ----------------------------------------------------------------------------
// ENTRÉES / SORTIES
// ----------------------------------------------------------------------------
if longSignal and strategy.position_size == 0 and posSize > 0
    slLong = close - stopDist
    tpLong = close + stopDist * rrRatio
    strategy.entry("Long", strategy.long, qty = posSize,
         alert_message = "TripleConfluence ACHAT " + syminfo.ticker + " @ " + str.tostring(close, format.mintick))
    strategy.exit("Long TP/SL", "Long", stop = slLong, limit = tpLong,
         alert_message = "TripleConfluence SORTIE LONG " + syminfo.ticker)

if shortSignal and strategy.position_size == 0 and posSize > 0
    slShort = close + stopDist
    tpShort = close - stopDist * rrRatio
    strategy.entry("Short", strategy.short, qty = posSize,
         alert_message = "TripleConfluence VENTE " + syminfo.ticker + " @ " + str.tostring(close, format.mintick))
    strategy.exit("Short TP/SL", "Short", stop = slShort, limit = tpShort,
         alert_message = "TripleConfluence SORTIE SHORT " + syminfo.ticker)

// Sortie anticipée : le Supertrend se retourne contre la position
if useTrail
    if strategy.position_size > 0 and stDir > 0
        strategy.close("Long", comment = "Retournement ST",
             alert_message = "TripleConfluence SORTIE LONG (retournement) " + syminfo.ticker)
    if strategy.position_size < 0 and stDir < 0
        strategy.close("Short", comment = "Retournement ST",
             alert_message = "TripleConfluence SORTIE SHORT (retournement) " + syminfo.ticker)

// ----------------------------------------------------------------------------
// AFFICHAGE
// ----------------------------------------------------------------------------
plot(emaTrend, "EMA tendance", color = color.new(color.orange, 0), linewidth = 2)
plot(stLine, "Supertrend",
     color = stDir < 0 ? color.new(color.teal, 0) : color.new(color.red, 0),
     style = plot.style_linebr)

bgcolor(trendUp ? color.new(color.teal, 94) : trendDown ? color.new(color.red, 94) : na)

plotshape(longSignal,  "Signal achat", shape.triangleup,   location.belowbar, color.new(color.teal, 0), size = size.small, text = "BUY")
plotshape(shortSignal, "Signal vente", shape.triangledown, location.abovebar, color.new(color.red, 0),  size = size.small, text = "SELL")

// ----------------------------------------------------------------------------
// TABLEAU DE PERFORMANCE (coin supérieur droit)
// ----------------------------------------------------------------------------
var table perf = table.new(position.top_right, 2, 5, border_width = 1)
if barstate.islast
    winRate = strategy.closedtrades > 0 ? 100 * strategy.wintrades / strategy.closedtrades : 0
    pf      = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    table.cell(perf, 0, 0, "Trades clôturés", text_size = size.small, bgcolor = color.new(color.gray, 80))
    table.cell(perf, 1, 0, str.tostring(strategy.closedtrades), text_size = size.small)
    table.cell(perf, 0, 1, "Taux de réussite", text_size = size.small, bgcolor = color.new(color.gray, 80))
    table.cell(perf, 1, 1, str.tostring(winRate, "#.#") + " %", text_size = size.small)
    table.cell(perf, 0, 2, "Profit factor", text_size = size.small, bgcolor = color.new(color.gray, 80))
    table.cell(perf, 1, 2, na(pf) ? "—" : str.tostring(pf, "#.##"), text_size = size.small)
    table.cell(perf, 0, 3, "Profit net", text_size = size.small, bgcolor = color.new(color.gray, 80))
    table.cell(perf, 1, 3, str.tostring(strategy.netprofit, "#.##"), text_size = size.small)
    table.cell(perf, 0, 4, "Drawdown max", text_size = size.small, bgcolor = color.new(color.gray, 80))
    table.cell(perf, 1, 4, str.tostring(strategy.max_drawdown, "#.##"), text_size = size.small)
