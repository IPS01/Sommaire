//@version=6
// ============================================================================
// PRÉVISION TRIGO-STATISTIQUE — modèle calculé, aucun indicateur classique
//
// Le prix est décomposé mathématiquement en trois parties :
//   prix = TENDANCE + CYCLE + BRUIT
//
//   1) TENDANCE : régression linéaire des moindres carrés calculée à la main
//      (covariance / variance sur fenêtre glissante) + t-stat de la pente.
//   2) CYCLE : transformée de Fourier glissante (trigonométrie) — le résidu
//      est projeté sur cos/sin à 6 périodes candidates ; la période dominante
//      donne amplitude et PHASE, donc la position dans le cycle et la date
//      (en bougies) du prochain pic et du prochain creux.
//   3) BRUIT : écart-type de ce que le modèle n'explique pas.
//
// ANTICIPATION : le modèle est projeté h bougies en avant
//   prévision = tendance(t+h) + cycle(t+h)
// On ne trade que si le mouvement anticipé dépasse le bruit (score z) ET si
// le cycle explique une part minimale de la variance (qualité du modèle).
//
// Sans blocs ni fonctions utilisateur (robuste au copier-coller) : seules
// les 2 dernières lignes du fichier sont indentées.
// HONNÊTETÉ : aucun modèle ne prédit l'avenir à coup sûr. Quand le marché
// n'est pas cyclique, la qualité chute et la stratégie reste à l'écart.
// Backtestez puis validez en paper trading avant tout argent réel.
// ============================================================================

strategy("Prévision Trigo-Statistique [tendance + cycle + bruit]", shorttitle = "Prévision TS", overlay = true, initial_capital = 10000, currency = currency.EUR, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 2, calc_on_every_tick = false, process_orders_on_close = true, pyramiding = 0)

// ---------------------------------------------------------------- PARAMÈTRES
enableLongs  = input.bool(true, "Autoriser les achats (long)",  group = "Direction et décision")
enableShorts = input.bool(true, "Autoriser les ventes (short)", group = "Direction et décision")
zMin         = input.float(1.5, "Significativité minimale de la prévision (z)", minval = 0.5, step = 0.1, group = "Direction et décision", tooltip = "Le mouvement anticipé doit dépasser z fois le bruit du modèle. Plus haut = plus sélectif.")
qMin         = input.float(0.10, "Qualité minimale du modèle (part de variance expliquée par le cycle)", minval = 0.0, maxval = 0.9, step = 0.05, group = "Direction et décision", tooltip = "0.10 = le cycle dominant doit expliquer au moins 10 % de la variance du résidu, sinon on ne trade pas.")

N = input.int(128, "Fenêtre d'analyse (bougies)", minval = 40, maxval = 500, group = "Modèle mathématique")
h = input.int(5, "Horizon de prévision (bougies)", minval = 1, maxval = 30, group = "Modèle mathématique")
P1 = input.int(8,  "Période candidate 1", minval = 4, group = "Modèle mathématique")
P2 = input.int(13, "Période candidate 2", minval = 4, group = "Modèle mathématique")
P3 = input.int(21, "Période candidate 3", minval = 4, group = "Modèle mathématique")
P4 = input.int(34, "Période candidate 4", minval = 4, group = "Modèle mathématique")
P5 = input.int(55, "Période candidate 5", minval = 4, group = "Modèle mathématique")
P6 = input.int(89, "Période candidate 6", minval = 4, group = "Modèle mathématique")

riskPct  = input.float(1.0, "Risque par trade (% du capital)", minval = 0.1, maxval = 10, step = 0.1, group = "Gestion du risque")
stopMult = input.float(2.0, "Stop en multiples du bruit sur l'horizon", minval = 0.5, step = 0.1, group = "Gestion du risque", tooltip = "Stop = k × écart-type du bruit × racine(h). Le take-profit est le prix prévu par le modèle.")

startDate = input.time(timestamp("1 Jan 2018 00:00 +0000"), "Début", group = "Période de backtest")
endDate   = input.time(timestamp("1 Jan 2035 00:00 +0000"), "Fin",   group = "Période de backtest")

inDate = time >= startDate and time <= endDate

// ---------------------- 1) TENDANCE : MOINDRES CARRÉS CALCULÉS À LA MAIN
// Sur une fenêtre de N bougies régulièrement espacées, la variance du temps
// est exactement (N²-1)/12 : la pente se calcule donc par covariance/variance.
varT  = (N * N - 1) / 12.0
mT    = bar_index - (N - 1) / 2.0
mY    = ta.sma(close, N)
covTY = ta.sma(bar_index * close, N) - mT * mY
slope = covTY / varT
fit   = mY + slope * (N - 1) / 2.0
resid = close - fit
residSd = ta.stdev(resid, N)
tSlope  = residSd > 0 ? slope * math.sqrt(N * varT) / residSd : 0.0

// ---------------- 2) CYCLE : FOURIER GLISSANT (PROJECTION SUR COS / SIN)
// Pour chaque période P : a = 2·moyenne(résidu·cos), b = 2·moyenne(résidu·sin)
// Amplitude = √(a²+b²). La période la plus forte devient le cycle dominant.
w1 = 2 * math.pi / P1
w2 = 2 * math.pi / P2
w3 = 2 * math.pi / P3
w4 = 2 * math.pi / P4
w5 = 2 * math.pi / P5
w6 = 2 * math.pi / P6
a1 = 2 * ta.sma(resid * math.cos(w1 * bar_index), N)
b1 = 2 * ta.sma(resid * math.sin(w1 * bar_index), N)
a2 = 2 * ta.sma(resid * math.cos(w2 * bar_index), N)
b2 = 2 * ta.sma(resid * math.sin(w2 * bar_index), N)
a3 = 2 * ta.sma(resid * math.cos(w3 * bar_index), N)
b3 = 2 * ta.sma(resid * math.sin(w3 * bar_index), N)
a4 = 2 * ta.sma(resid * math.cos(w4 * bar_index), N)
b4 = 2 * ta.sma(resid * math.sin(w4 * bar_index), N)
a5 = 2 * ta.sma(resid * math.cos(w5 * bar_index), N)
b5 = 2 * ta.sma(resid * math.sin(w5 * bar_index), N)
a6 = 2 * ta.sma(resid * math.cos(w6 * bar_index), N)
b6 = 2 * ta.sma(resid * math.sin(w6 * bar_index), N)
amp1 = math.sqrt(a1 * a1 + b1 * b1)
amp2 = math.sqrt(a2 * a2 + b2 * b2)
amp3 = math.sqrt(a3 * a3 + b3 * b3)
amp4 = math.sqrt(a4 * a4 + b4 * b4)
amp5 = math.sqrt(a5 * a5 + b5 * b5)
amp6 = math.sqrt(a6 * a6 + b6 * b6)
ampDom = math.max(amp1, math.max(amp2, math.max(amp3, math.max(amp4, math.max(amp5, amp6)))))
pDom = ampDom == amp1 ? P1 : ampDom == amp2 ? P2 : ampDom == amp3 ? P3 : ampDom == amp4 ? P4 : ampDom == amp5 ? P5 : P6
aDom = ampDom == amp1 ? a1 : ampDom == amp2 ? a2 : ampDom == amp3 ? a3 : ampDom == amp4 ? a4 : ampDom == amp5 ? a5 : a6
bDom = ampDom == amp1 ? b1 : ampDom == amp2 ? b2 : ampDom == amp3 ? b3 : ampDom == amp4 ? b4 : ampDom == amp5 ? b5 : b6
wDom = 2 * math.pi / pDom
cycNow = aDom * math.cos(wDom * bar_index) + bDom * math.sin(wDom * bar_index)
cycFut = aDom * math.cos(wDom * (bar_index + h)) + bDom * math.sin(wDom * (bar_index + h))

// --------------------------- 3) BRUIT ET QUALITÉ DU MODÈLE (STATISTIQUES)
noiseSd = ta.stdev(resid - cycNow, N)
quality = residSd > 0 ? math.max(0.0, 1.0 - (noiseSd * noiseSd) / (residSd * residSd)) : 0.0

// -------- PHASE (TRIGONOMÉTRIE) : DANS COMBIEN DE BOUGIES LE PIC / CREUX ?
// résidu ≈ A·cos(θ − φ) avec θ = ω·t et φ = atan2(b, a). Le pic arrive quand
// θ − φ retombe sur 0 (mod 2π), le creux quand il retombe sur π.
phi = aDom > 0 ? math.atan(bDom / aDom) : aDom < 0 ? math.atan(bDom / aDom) + math.pi : bDom > 0 ? math.pi / 2 : -math.pi / 2
theta = wDom * bar_index
dPeak = (phi - theta) - 2 * math.pi * math.floor((phi - theta) / (2 * math.pi))
dTrough = (phi + math.pi - theta) - 2 * math.pi * math.floor((phi + math.pi - theta) / (2 * math.pi))
barsPeak = dPeak / wDom
barsTrough = dTrough / wDom

// ----------------------------- ANTICIPATION : PRÉVISION À h BOUGIES ET SCORE
prevision = fit + slope * h + cycFut
delta = prevision - close
zPred = noiseSd > 0 ? delta / (noiseSd * math.sqrt(h)) : 0.0

// ------------------------------------------- TAILLE DE POSITION ET NIVEAUX
ready = bar_index > N + 10
stopDist = stopMult * noiseSd * math.sqrt(h)
riskCash = strategy.equity * riskPct / 100
posSize = stopDist > 0 ? riskCash / stopDist : 0.0
longEntry  = enableLongs  and inDate and ready and strategy.position_size == 0 and posSize > 0 and quality >= qMin and zPred >= zMin
shortEntry = enableShorts and inDate and ready and strategy.position_size == 0 and posSize > 0 and quality >= qMin and zPred <= -zMin

// ------------------- SORTIES : STOP GELÉ, OBJECTIF = PRIX PRÉVU PAR LE MODÈLE
// Si la prévision s'inverse pendant le trade, le stop est remonté au prix
// courant, ce qui ferme la position au prochain contact.
var float slL = na
var float tpL = na
var float slS = na
var float tpS = na
slL := longEntry ? close - stopDist : strategy.position_size > 0 and zPred < 0 ? close : nz(slL, close)
tpL := longEntry ? math.max(prevision, close + stopDist) : tpL
slS := shortEntry ? close + stopDist : strategy.position_size < 0 and zPred > 0 ? close : nz(slS, close)
tpS := shortEntry ? math.min(prevision, close - stopDist) : tpS
strategy.exit("Long TP/SL", "Long", stop = slL, limit = tpL, alert_message = "PrevisionTS SORTIE LONG " + syminfo.ticker)
strategy.exit("Short TP/SL", "Short", stop = slS, limit = tpS, alert_message = "PrevisionTS SORTIE SHORT " + syminfo.ticker)

// ------------------------------------------------------------------ AFFICHAGE
plot(fit, "Tendance (régression)", color = color.new(color.orange, 20), linewidth = 1)
plot(fit + cycNow, "Modèle (tendance + cycle)", color = cycFut > cycNow ? color.new(color.teal, 0) : color.new(color.red, 0), linewidth = 2)
plot(ready ? prevision : na, "Prévision (décalée de +h bougies)", color = color.new(color.purple, 0), linewidth = 1, style = plot.style_circles, offset = h)
bgcolor(ready and quality >= qMin ? color.new(color.blue, 94) : na)
plotshape(longEntry, "Signal achat", shape.triangleup, location.belowbar, color.new(color.teal, 0), size = size.small)
plotshape(shortEntry, "Signal vente", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.small)

// ------------------------------------------- TABLEAU : ANALYSE + ANTICIPATION
predTxt = str.tostring(prevision, format.mintick) + " (" + (delta >= 0 ? "+" : "") + str.tostring(100 * delta / close, "#.##") + " %)"
zTxt = str.tostring(zPred, "#.##") + (zPred >= zMin ? " ▲" : zPred <= -zMin ? " ▼" : " —")
qTxt = str.tostring(100 * quality, "#.#") + " %" + (quality >= qMin ? " ✓" : " ✗")
winRate = strategy.closedtrades > 0 ? 100.0 * strategy.wintrades / strategy.closedtrades : 0.0
pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
zCol = zPred >= zMin ? color.new(color.teal, 70) : zPred <= -zMin ? color.new(color.red, 70) : color.new(color.gray, 85)
qCol = quality >= qMin ? color.new(color.teal, 70) : color.new(color.gray, 85)

var table info = table.new(position.top_right, 2, 10, border_width = 1)
table.cell(info, 0, 0, "Cycle dominant", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 0, str.tostring(pDom) + " bougies", text_size = size.small)
table.cell(info, 0, 1, "Qualité du modèle (seuil " + str.tostring(100 * qMin, "#") + " %)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 1, qTxt, text_size = size.small, bgcolor = qCol)
table.cell(info, 0, 2, "Prévision à +" + str.tostring(h) + " bougies", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 2, predTxt, text_size = size.small)
table.cell(info, 0, 3, "Score z (seuil " + str.tostring(zMin, "#.#") + ")", text_size = size.small, bgcolor = color.new(color.blue, 80))
table.cell(info, 1, 3, zTxt, text_size = size.small, bgcolor = zCol)
table.cell(info, 0, 4, "Prochain pic du cycle", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 4, "dans " + str.tostring(barsPeak, "#") + " bougies", text_size = size.small)
table.cell(info, 0, 5, "Prochain creux du cycle", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 5, "dans " + str.tostring(barsTrough, "#") + " bougies", text_size = size.small)
table.cell(info, 0, 6, "Pente de tendance (t-stat)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 6, str.tostring(tSlope, "#.##"), text_size = size.small)
table.cell(info, 0, 7, "Trades / réussite", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 7, str.tostring(strategy.closedtrades) + " / " + str.tostring(winRate, "#.#") + " %", text_size = size.small)
table.cell(info, 0, 8, "Profit factor", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 8, na(pf) ? "—" : str.tostring(pf, "#.##"), text_size = size.small)
table.cell(info, 0, 9, "Profit net", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 9, str.tostring(strategy.netprofit, "#.##"), text_size = size.small)

// --------------------- ENTRÉES (les 2 seules lignes indentées, en fin de fichier)
if longEntry
    strategy.entry("Long", strategy.long, qty = posSize, comment = "z " + str.tostring(zPred, "#.#"), alert_message = "PrevisionTS ACHAT " + syminfo.ticker + " @ " + str.tostring(close, format.mintick))
if shortEntry
    strategy.entry("Short", strategy.short, qty = posSize, comment = "z " + str.tostring(-zPred, "#.#"), alert_message = "PrevisionTS VENTE " + syminfo.ticker + " @ " + str.tostring(close, format.mintick))
