//@version=6
// ============================================================================
// ÉCOSYSTÈME DARWINIEN COMPLET — la théorie de la vie appliquée au capital
//
// PRINCIPE : on ne teste pas, on n'optimise pas — on fait vivre des
// variantes et LE RÉEL TUE LES FAIBLES. L'organisme possède désormais
// tous les mécanismes fondamentaux du vivant :
//
//   VARIATION — 8 espèces aux rythmes différents (5 suiveuses de
//     tendance, 3 contrariennes), instinct gradué : conviction =
//     mouvement / bruit, bornée à ±100 %.
//   SÉLECTION — chaque espèce chasse virtuellement en continu, frais
//     déduits ; sa forme (moyenne exponentielle des gains) décide de sa
//     part de nourriture (le capital). Qui perd maigrit, qui gagne mange.
//   NICHES ÉCOLOGIQUES — bonus de nourriture aux espèces décorrélées de
//     la meute : chasser ailleurs vaut plus (diversification interne).
//   REPRODUCTION SEXUÉE — une espèce affamée trop longtemps meurt ; son
//     enfant naît du CROISEMENT des rythmes des DEUX meilleures espèces
//     (moyenne géométrique) puis muté (facteur déterministe).
//   SOIN PARENTAL — le nouveau-né hérite de 25 % de la vigueur du
//     champion : il n'entre pas dans le monde affamé.
//   PLAFOND DES PRÉDATRICES — les contrariennes ne peuvent jamais rafler
//     plus de la moitié du capital : sans ce garde-fou elles finissent par
//     vendre à découvert une hausse historique et la colonie meurt.
//   RESPECT DE LA DÉRIVE — aucune exposition contre la tendance de fond
//     (252 bougies) : combattre la dérive structurelle d'un actif est mortel.
//   SYSTÈME IMMUNITAIRE — un choc > 4 écarts-types (krach, annonce)
//     déclenche un bouclier : exposition réduite de moitié 10 bougies.
//   HOMÉOSTASIE — ciblage de volatilité, annualisé d'après la durée
//     réelle des bougies (valable du 1 min au mensuel).
//   RESPIRATION — la position n'est corrigée qu'une fois par semaine :
//     les frais ne paient que les vraies décisions, pas les frémissements.
//   RÉGULATION THERMIQUE — la perte depuis le sommet est une température:
//     torpeur progressive, hibernation à la borne, GUÉRISON lente (demi-vie
//     500 jours), et PLANCHER DE SURVIE : sous 60 % du capital initial,
//     extinction définitive. Le point de non-retour existe.
//   EXTINCTION — si toutes les espèces meurent, tout le monde à l'abri.
//   ÉTAT CIVIL — âge, génération, naissances totales, doyenne ; chaque
//     naissance est marquée d'un losange violet sur le graphique.
//
// STRUCTURE ANTI-COLLAGE : aucune boucle, aucune fonction utilisateur —
// les 2 seules lignes indentées sont les 2 dernières du fichier.
// HONNÊTETÉ : la sélection favorise les survivants, elle ne garantit pas
// de gain — même la nature a ses extinctions. Terrain conseillé : 1D.
// ============================================================================

strategy("Écosystème Darwinien Complet [vie, mort, croisement, immunité]", shorttitle = "Darwin Complet", overlay = true, initial_capital = 10000, currency = currency.EUR, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 2, calc_on_every_tick = false, process_orders_on_close = true, pyramiding = 99, margin_long = 5, margin_short = 5, max_bars_back = 500)

// ---------------------------------------------------------------- PARAMÈTRES
enableLongs = input.bool(true, "Autoriser les achats (long)", group = "Direction")
enableShorts = input.bool(true, "Autoriser les ventes (short)", group = "Direction")
fitMem = input.int(63, "Mémoire de la forme (demi-vie, bougies)", minval = 10, maxval = 500, group = "Sélection naturelle", tooltip = "La forme d'une espèce est la moyenne exponentielle de ses gains. Court = sélection nerveuse, long = sélection patiente.")
frais = input.float(0.1, "Frais par unité d'exposition retournée (%)", minval = 0.0, maxval = 1.0, step = 0.01, group = "Sélection naturelle", tooltip = "Chaque espèce paie ses frais virtuels sur ses changements de position : la sélection intègre le coût du réel.")
divBonus = input.float(0.5, "Bonus de niche (récompense de la différence)", minval = 0.0, maxval = 1.0, step = 0.1, group = "Sélection naturelle", tooltip = "Les espèces décorrélées de la meute reçoivent jusqu'à ce bonus de nourriture en plus : chasser ailleurs protège la colonie.")
contMax = input.float(50.0, "Part maximale des contrariennes (%)", minval = 0.0, maxval = 100.0, step = 5.0, group = "Sélection naturelle", tooltip = "Les contrariennes ne peuvent jamais détenir plus que cette part du capital. Sans ce plafond, elles finissent par vendre à découvert une hausse historique — la colonie meurt en chassant l'éléphant à mains nues. Si toutes les espèces de tendance sont affamées, la colonie se met au repos.")
respectFond = input.bool(true, "Ne jamais chasser contre la tendance de fond (252 bougies)", group = "Sélection naturelle", tooltip = "Interdit toute exposition opposée à la tendance longue de l'actif. Les actions ont une dérive haussière structurelle : la combattre est mortel.")
hierarchie = input.float(2.0, "Part du lion (hiérarchie de la meute)", minval = 1.0, maxval = 4.0, step = 0.5, group = "La meute (le lion)", tooltip = "1 = démocratie : nourriture proportionnelle à la forme. 2 = meute : l'alpha mange une part disproportionnée (forme au carré). 4 = tyrannie de l'alpha.")
proieMin = input.float(0.2, "Proie minimale (conviction requise pour charger)", minval = 0.0, maxval = 0.8, step = 0.05, group = "La meute (le lion)", tooltip = "Le lion ne grignote pas : en dessous de cette conviction collective, la meute reste à l'affût sans dépenser un centime de frais. Au-dessus, elle charge. 0 = désactivé.")
starveMax = input.int(150, "Famine mortelle (bougies en forme négative)", minval = 30, maxval = 1000, group = "Évolution (croisement + mutation)", tooltip = "Au-delà, l'espèce meurt. Son enfant naît du croisement des deux meilleures (moyenne géométrique des rythmes), muté, avec 25 % de la vigueur du champion en héritage.")
soinParent = input.float(25.0, "Soin parental (% de la vigueur du champion héritée)", minval = 0.0, maxval = 100.0, step = 5.0, group = "Évolution (croisement + mutation)")
targetVol = input.float(15.0, "Volatilité cible du portefeuille (% par an)", minval = 2, maxval = 40, step = 1, group = "Homéostasie")
volWin = input.int(63, "Fenêtre de mesure de volatilité (bougies)", minval = 20, group = "Homéostasie")
expoMax = input.float(3.0, "Exposition maximale (× capital)", minval = 0.5, maxval = 10, step = 0.5, group = "Homéostasie")
rebalPct = input.float(25.0, "Zone morte de rééquilibrage (% d'écart)", minval = 5, maxval = 50, step = 1, group = "Homéostasie")
respire = input.int(5, "Respiration : rééquilibrage toutes les X bougies", minval = 1, maxval = 21, group = "Homéostasie", tooltip = "L'organisme ne corrige sa position qu'à ce rythme (5 = hebdomadaire en journalier). Entre deux respirations, il tient sa position : les frais ne paient que les vraies décisions, pas les frémissements.")
ddMax = input.float(20.0, "Borne mortelle : perte maximale depuis le sommet (%)", minval = 5, maxval = 50, step = 1, group = "Régulation thermique (survie)")
guerJours = input.int(500, "Guérison : demi-vie de la mémoire du sommet (jours)", minval = 30, maxval = 3000, group = "Régulation thermique (survie)", tooltip = "La blessure s'estompe lentement. ATTENTION : une valeur trop courte débranche la protection — la perte n'est jamais enregistrée et la torpeur ne se déclenche jamais.")
plancher = input.float(60.0, "Plancher de survie : extinction définitive sous (% du capital initial)", minval = 10.0, maxval = 95.0, step = 5.0, group = "Régulation thermique (survie)", tooltip = "Sous ce niveau, l'espèce est déclarée éteinte : plus aucune exposition, définitivement. En biologie comme en bourse, il existe un point de non-retour.")
chocSeuil = input.float(4.0, "Choc immunitaire (mouvement en écarts-types)", minval = 2.0, maxval = 8.0, step = 0.5, group = "Système immunitaire", tooltip = "Un mouvement d'une bougie au-delà de ce seuil déclenche le bouclier : exposition réduite de moitié pendant la convalescence.")
chocDuree = input.int(10, "Convalescence après choc (bougies)", minval = 1, maxval = 100, group = "Système immunitaire")

startDate = input.time(timestamp("1 Jan 2010 00:00 +0000"), "Début", group = "Période de backtest")
endDate = input.time(timestamp("1 Jan 2035 00:00 +0000"), "Fin", group = "Période de backtest")

inDate = time >= startDate and time <= endDate

// ------------------------------------------------ LE TERRAIN DE CHASSE
v = math.log(close / nz(close[1], close))
sdBar = ta.stdev(v, 50)
lamF = math.pow(0.5, 1.0 / fitMem)
fr = frais / 100
ready = bar_index > 300

// ------------------------- LE GÉNOME : RYTHME DE CHAQUE ESPÈCE (mutable)
var int L1 = 10
var int L2 = 21
var int L3 = 63
var int L4 = 126
var int L5 = 252
var int L6 = 2
var int L7 = 5
var int L8 = 10
var int g1 = 1
var int g2 = 1
var int g3 = 1
var int g4 = 1
var int g5 = 1
var int g6 = 1
var int g7 = 1
var int g8 = 1
var int age1 = 0
var int age2 = 0
var int age3 = 0
var int age4 = 0
var int age5 = 0
var int age6 = 0
var int age7 = 0
var int age8 = 0
var float stv1 = 0.0
var float stv2 = 0.0
var float stv3 = 0.0
var float stv4 = 0.0
var float stv5 = 0.0
var float stv6 = 0.0
var float stv7 = 0.0
var float stv8 = 0.0

// ---------------- L'INSTINCT GRADUÉ : conviction = mouvement / bruit (±1)
d1 = sdBar * math.sqrt(L1)
d2 = sdBar * math.sqrt(L2)
d3 = sdBar * math.sqrt(L3)
d4 = sdBar * math.sqrt(L4)
d5 = sdBar * math.sqrt(L5)
d6 = sdBar * math.sqrt(L6)
d7 = sdBar * math.sqrt(L7)
d8 = sdBar * math.sqrt(L8)
sig1 = d1 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L1], close)) / d1)) : 0.0
sig2 = d2 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L2], close)) / d2)) : 0.0
sig3 = d3 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L3], close)) / d3)) : 0.0
sig4 = d4 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L4], close)) / d4)) : 0.0
sig5 = d5 > 0 ? math.max(-1.0, math.min(1.0, math.log(close / nz(close[L5], close)) / d5)) : 0.0
sig6 = d6 > 0 ? -math.max(-1.0, math.min(1.0, math.log(close / nz(close[L6], close)) / d6)) : 0.0
sig7 = d7 > 0 ? -math.max(-1.0, math.min(1.0, math.log(close / nz(close[L7], close)) / d7)) : 0.0
sig8 = d8 > 0 ? -math.max(-1.0, math.min(1.0, math.log(close / nz(close[L8], close)) / d8)) : 0.0

// ---------------- LA CHASSE VIRTUELLE : GAIN DE CHAQUE ESPÈCE, FRAIS DÉDUITS
p1 = nz(sig1[1], 0.0) * v - math.abs(sig1 - nz(sig1[1], sig1)) * 0.5 * fr
p2 = nz(sig2[1], 0.0) * v - math.abs(sig2 - nz(sig2[1], sig2)) * 0.5 * fr
p3 = nz(sig3[1], 0.0) * v - math.abs(sig3 - nz(sig3[1], sig3)) * 0.5 * fr
p4 = nz(sig4[1], 0.0) * v - math.abs(sig4 - nz(sig4[1], sig4)) * 0.5 * fr
p5 = nz(sig5[1], 0.0) * v - math.abs(sig5 - nz(sig5[1], sig5)) * 0.5 * fr
p6 = nz(sig6[1], 0.0) * v - math.abs(sig6 - nz(sig6[1], sig6)) * 0.5 * fr
p7 = nz(sig7[1], 0.0) * v - math.abs(sig7 - nz(sig7[1], sig7)) * 0.5 * fr
p8 = nz(sig8[1], 0.0) * v - math.abs(sig8 - nz(sig8[1], sig8)) * 0.5 * fr
pEco = (p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8) / 8

// ---------------- LA FORME : VIGUEUR DE CHAQUE ESPÈCE (mémoire exponentielle)
var float fit1 = 0.0
var float fit2 = 0.0
var float fit3 = 0.0
var float fit4 = 0.0
var float fit5 = 0.0
var float fit6 = 0.0
var float fit7 = 0.0
var float fit8 = 0.0
fit1 := barstate.isconfirmed ? lamF * fit1 + (1 - lamF) * p1 : fit1
fit2 := barstate.isconfirmed ? lamF * fit2 + (1 - lamF) * p2 : fit2
fit3 := barstate.isconfirmed ? lamF * fit3 + (1 - lamF) * p3 : fit3
fit4 := barstate.isconfirmed ? lamF * fit4 + (1 - lamF) * p4 : fit4
fit5 := barstate.isconfirmed ? lamF * fit5 + (1 - lamF) * p5 : fit5
fit6 := barstate.isconfirmed ? lamF * fit6 + (1 - lamF) * p6 : fit6
fit7 := barstate.isconfirmed ? lamF * fit7 + (1 - lamF) * p7 : fit7
fit8 := barstate.isconfirmed ? lamF * fit8 + (1 - lamF) * p8 : fit8

// ---------------- NICHES : LA DIFFÉRENCE EST RÉCOMPENSÉE (décorrélation)
q1 = nz(ta.correlation(p1, pEco, 100), 1.0)
q2 = nz(ta.correlation(p2, pEco, 100), 1.0)
q3 = nz(ta.correlation(p3, pEco, 100), 1.0)
q4 = nz(ta.correlation(p4, pEco, 100), 1.0)
q5 = nz(ta.correlation(p5, pEco, 100), 1.0)
q6 = nz(ta.correlation(p6, pEco, 100), 1.0)
q7 = nz(ta.correlation(p7, pEco, 100), 1.0)
q8 = nz(ta.correlation(p8, pEco, 100), 1.0)

// ---------------- LA MEUTE : LE LION MANGE LE PREMIER (forme ^ hiérarchie)
// hiérarchie = 1 : démocratie. 2 : l'alpha rafle une part disproportionnée.
// La forme est normalisée par la meilleure avant l'exposant (stabilité).
bestRef = math.max(fit1, math.max(fit2, math.max(fit3, math.max(fit4, math.max(fit5, math.max(fit6, math.max(fit7, fit8)))))))
fitRef = math.max(bestRef, 1e-12)
w1 = math.pow(math.max(0.0, fit1) / fitRef, hierarchie) * (1.0 + divBonus * (1.0 - q1))
w2 = math.pow(math.max(0.0, fit2) / fitRef, hierarchie) * (1.0 + divBonus * (1.0 - q2))
w3 = math.pow(math.max(0.0, fit3) / fitRef, hierarchie) * (1.0 + divBonus * (1.0 - q3))
w4 = math.pow(math.max(0.0, fit4) / fitRef, hierarchie) * (1.0 + divBonus * (1.0 - q4))
w5 = math.pow(math.max(0.0, fit5) / fitRef, hierarchie) * (1.0 + divBonus * (1.0 - q5))
w6r = math.pow(math.max(0.0, fit6) / fitRef, hierarchie) * (1.0 + divBonus * (1.0 - q6))
w7r = math.pow(math.max(0.0, fit7) / fitRef, hierarchie) * (1.0 + divBonus * (1.0 - q7))
w8r = math.pow(math.max(0.0, fit8) / fitRef, hierarchie) * (1.0 + divBonus * (1.0 - q8))

// PLAFOND DES CONTRARIENNES : elles ne peuvent pas rafler tout le capital.
// Sans ce garde-fou, quand toutes les espèces de tendance sont affamées, les
// contrariennes vendent à découvert une hausse historique et la colonie meurt.
wT = w1 + w2 + w3 + w4 + w5
wCr = w6r + w7r + w8r
cC = contMax / 100
scaleC = wCr > 0 and cC < 1 ? math.min(1.0, cC * wT / math.max(1e-12, (1 - cC) * wCr)) : 1.0
w6 = w6r * scaleC
w7 = w7r * scaleC
w8 = w8r * scaleC
wTot = wT + w6 + w7 + w8
dir = wTot > 0 ? (w1 * sig1 + w2 * sig2 + w3 * sig3 + w4 * sig4 + w5 * sig5 + w6 * sig6 + w7 * sig7 + w8 * sig8) / wTot : 0.0
vivantes = (w1 > 0 ? 1 : 0) + (w2 > 0 ? 1 : 0) + (w3 > 0 ? 1 : 0) + (w4 > 0 ? 1 : 0) + (w5 > 0 ? 1 : 0) + (w6 > 0 ? 1 : 0) + (w7 > 0 ? 1 : 0) + (w8 > 0 ? 1 : 0)

// ------- ÉVOLUTION : FAMINE, MORT, CROISEMENT DES 2 MEILLEURES, MUTATION
// L'enfant hérite de la moyenne géométrique des rythmes des deux parents
// champions, multipliée par un facteur de mutation déterministe, et de
// 25 % de la vigueur du champion (soin parental). Génération +1.
bestFit = math.max(fit1, math.max(fit2, math.max(fit3, math.max(fit4, math.max(fit5, math.max(fit6, math.max(fit7, fit8)))))))
bestL = bestFit == fit1 ? L1 : bestFit == fit2 ? L2 : bestFit == fit3 ? L3 : bestFit == fit4 ? L4 : bestFit == fit5 ? L5 : bestFit == fit6 ? L6 : bestFit == fit7 ? L7 : L8
m2f1 = bestFit == fit1 ? -1e9 : fit1
m2f2 = bestFit == fit2 ? -1e9 : fit2
m2f3 = bestFit == fit3 ? -1e9 : fit3
m2f4 = bestFit == fit4 ? -1e9 : fit4
m2f5 = bestFit == fit5 ? -1e9 : fit5
m2f6 = bestFit == fit6 ? -1e9 : fit6
m2f7 = bestFit == fit7 ? -1e9 : fit7
m2f8 = bestFit == fit8 ? -1e9 : fit8
scndFit = math.max(m2f1, math.max(m2f2, math.max(m2f3, math.max(m2f4, math.max(m2f5, math.max(m2f6, math.max(m2f7, m2f8)))))))
scndL = scndFit == m2f1 ? L1 : scndFit == m2f2 ? L2 : scndFit == m2f3 ? L3 : scndFit == m2f4 ? L4 : scndFit == m2f5 ? L5 : scndFit == m2f6 ? L6 : scndFit == m2f7 ? L7 : L8
croise = math.sqrt(math.max(2, bestL) * math.max(2, scndL))
heritage = math.max(bestFit, 0.0) * soinParent / 100
stv1 := barstate.isconfirmed ? (fit1 <= 0 ? stv1 + 1 : 0.0) : stv1
stv2 := barstate.isconfirmed ? (fit2 <= 0 ? stv2 + 1 : 0.0) : stv2
stv3 := barstate.isconfirmed ? (fit3 <= 0 ? stv3 + 1 : 0.0) : stv3
stv4 := barstate.isconfirmed ? (fit4 <= 0 ? stv4 + 1 : 0.0) : stv4
stv5 := barstate.isconfirmed ? (fit5 <= 0 ? stv5 + 1 : 0.0) : stv5
stv6 := barstate.isconfirmed ? (fit6 <= 0 ? stv6 + 1 : 0.0) : stv6
stv7 := barstate.isconfirmed ? (fit7 <= 0 ? stv7 + 1 : 0.0) : stv7
stv8 := barstate.isconfirmed ? (fit8 <= 0 ? stv8 + 1 : 0.0) : stv8
mut1 = barstate.isconfirmed and stv1 > starveMax
mut2 = barstate.isconfirmed and stv2 > starveMax
mut3 = barstate.isconfirmed and stv3 > starveMax
mut4 = barstate.isconfirmed and stv4 > starveMax
mut5 = barstate.isconfirmed and stv5 > starveMax
mut6 = barstate.isconfirmed and stv6 > starveMax
mut7 = barstate.isconfirmed and stv7 > starveMax
mut8 = barstate.isconfirmed and stv8 > starveMax
fmut = 0.5 + math.abs(math.sin(bar_index * 12.9898)) * 1.0
L1 := mut1 ? math.max(5, math.min(20, math.round(croise * fmut))) : L1
L2 := mut2 ? math.max(15, math.min(40, math.round(croise * fmut * 1.13))) : L2
L3 := mut3 ? math.max(40, math.min(100, math.round(croise * fmut * 0.87))) : L3
L4 := mut4 ? math.max(90, math.min(200, math.round(croise * fmut * 1.29))) : L4
L5 := mut5 ? math.max(180, math.min(400, math.round(croise * fmut * 0.71))) : L5
L6 := mut6 ? math.max(2, math.min(6, math.round(croise * fmut * 0.2))) : L6
L7 := mut7 ? math.max(4, math.min(12, math.round(croise * fmut * 0.3))) : L7
L8 := mut8 ? math.max(8, math.min(30, math.round(croise * fmut * 0.4))) : L8
fit1 := mut1 ? heritage : fit1
fit2 := mut2 ? heritage : fit2
fit3 := mut3 ? heritage : fit3
fit4 := mut4 ? heritage : fit4
fit5 := mut5 ? heritage : fit5
fit6 := mut6 ? heritage : fit6
fit7 := mut7 ? heritage : fit7
fit8 := mut8 ? heritage : fit8
stv1 := mut1 ? 0.0 : stv1
stv2 := mut2 ? 0.0 : stv2
stv3 := mut3 ? 0.0 : stv3
stv4 := mut4 ? 0.0 : stv4
stv5 := mut5 ? 0.0 : stv5
stv6 := mut6 ? 0.0 : stv6
stv7 := mut7 ? 0.0 : stv7
stv8 := mut8 ? 0.0 : stv8
g1 := mut1 ? g1 + 1 : g1
g2 := mut2 ? g2 + 1 : g2
g3 := mut3 ? g3 + 1 : g3
g4 := mut4 ? g4 + 1 : g4
g5 := mut5 ? g5 + 1 : g5
g6 := mut6 ? g6 + 1 : g6
g7 := mut7 ? g7 + 1 : g7
g8 := mut8 ? g8 + 1 : g8
age1 := mut1 ? 0 : barstate.isconfirmed ? age1 + 1 : age1
age2 := mut2 ? 0 : barstate.isconfirmed ? age2 + 1 : age2
age3 := mut3 ? 0 : barstate.isconfirmed ? age3 + 1 : age3
age4 := mut4 ? 0 : barstate.isconfirmed ? age4 + 1 : age4
age5 := mut5 ? 0 : barstate.isconfirmed ? age5 + 1 : age5
age6 := mut6 ? 0 : barstate.isconfirmed ? age6 + 1 : age6
age7 := mut7 ? 0 : barstate.isconfirmed ? age7 + 1 : age7
age8 := mut8 ? 0 : barstate.isconfirmed ? age8 + 1 : age8
// -------- RÉ-ENSEMENCEMENT : APRÈS 100 BOUGIES D'EXTINCTION TOTALE, LA VIE
// REPART DES SPORES PRIMORDIALES (les 8 rythmes d'origine, dettes effacées)
var float extN = 0.0
extN := barstate.isconfirmed ? (ready and wTot == 0 ? extN + 1 : 0.0) : extN
resem = barstate.isconfirmed and extN > 100
L1 := resem ? 10 : L1
L2 := resem ? 21 : L2
L3 := resem ? 63 : L3
L4 := resem ? 126 : L4
L5 := resem ? 252 : L5
L6 := resem ? 2 : L6
L7 := resem ? 5 : L7
L8 := resem ? 8 : L8
fit1 := resem ? 0.0 : fit1
fit2 := resem ? 0.0 : fit2
fit3 := resem ? 0.0 : fit3
fit4 := resem ? 0.0 : fit4
fit5 := resem ? 0.0 : fit5
fit6 := resem ? 0.0 : fit6
fit7 := resem ? 0.0 : fit7
fit8 := resem ? 0.0 : fit8
stv1 := resem ? 0.0 : stv1
stv2 := resem ? 0.0 : stv2
stv3 := resem ? 0.0 : stv3
stv4 := resem ? 0.0 : stv4
stv5 := resem ? 0.0 : stv5
stv6 := resem ? 0.0 : stv6
stv7 := resem ? 0.0 : stv7
stv8 := resem ? 0.0 : stv8
extN := resem ? 0.0 : extN

naissance = mut1 or mut2 or mut3 or mut4 or mut5 or mut6 or mut7 or mut8 or resem
naissances = g1 + g2 + g3 + g4 + g5 + g6 + g7 + g8 - 8
doyenne = math.max(age1, math.max(age2, math.max(age3, math.max(age4, math.max(age5, math.max(age6, math.max(age7, age8)))))))

// ---------------- SYSTÈME IMMUNITAIRE : BOUCLIER APRÈS CHOC ANORMAL
var float immun = 0.0
choc = ready and math.abs(v) > chocSeuil * nz(sdBar[1], 1e9)
immun := choc and barstate.isconfirmed ? chocDuree : math.max(0.0, immun - (barstate.isconfirmed ? 1.0 : 0.0))
bouclier = immun > 0 ? 0.5 : 1.0

// ---------------- HOMÉOSTASIE : CIBLAGE DE VOLATILITÉ (toute unité de temps)
sigA = ta.stdev(v, volWin) * math.sqrt(31536000.0 / timeframe.in_seconds())
levVol = sigA > 0 ? math.min(expoMax, (targetVol / 100) / sigA) : 0.0

// ---------------- RÉGULATION THERMIQUE : TORPEUR, HIBERNATION, GUÉRISON
var float eqPeak = na
guerison = math.pow(0.5, timeframe.in_seconds() / (guerJours * 86400.0))
eqPeak := math.max(nz(eqPeak, strategy.equity) * guerison, strategy.equity)
dd = eqPeak > 0 ? 1.0 - strategy.equity / eqPeak : 0.0
torpeur = math.max(0.0, math.min(1.0, 1.0 - dd / (ddMax / 100)))

// PLANCHER DE SURVIE : point de non-retour, extinction définitive
var bool eteint = false
eteint := eteint or (ready and strategy.equity < plancher / 100 * strategy.initial_capital)

// TENDANCE DE FOND : on ne chasse jamais contre la dérive longue de l'actif
fond = close > nz(close[252], close) ? 1 : -1

// LA CHARGE DU LION : en dessous de la proie minimale, la meute reste à
// l'affût (exposition nulle, zéro frais) ; au-dessus, elle charge.
dirS = ta.sma(dir, respire)
dirChasse = math.abs(dirS) >= proieMin ? dirS : 0.0
fCible = ready and inDate and not eteint ? dirChasse * levVol * torpeur * bouclier : 0.0
fCible := enableLongs or fCible < 0 ? fCible : 0.0
fCible := enableShorts or fCible > 0 ? fCible : 0.0
fCible := respectFond and fCible * fond < 0 ? 0.0 : fCible

// ---------------- CORRECTION : RÉÉQUILIBRAGE AVEC ZONE MORTE
qtyCible = fCible * strategy.equity / close
diffQty = qtyCible - strategy.position_size
seuilQty = math.max(rebalPct / 100 * math.abs(qtyCible), 0.02 * strategy.equity / close)
souffle = bar_index % respire == 0
doPlus = barstate.isconfirmed and souffle and diffQty > seuilQty
doMoins = barstate.isconfirmed and souffle and -diffQty > seuilQty

// ------------------------------------------------------------------ AFFICHAGE
bgcolor(not ready ? na : vivantes == 0 ? color.new(color.red, 90) : dir > 0.2 ? color.new(color.teal, 94) : dir < -0.2 ? color.new(color.red, 94) : na)
plotshape(doPlus, "Poussée haussière", shape.triangleup, location.belowbar, color.new(color.teal, 0), size = size.tiny)
plotshape(doMoins, "Poussée baissière", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.tiny)
plotshape(naissance, "Naissance d'une espèce", shape.diamond, location.bottom, color.new(color.purple, 0), size = size.tiny)
plotshape(choc, "Choc immunitaire", shape.xcross, location.top, color.new(color.red, 0), size = size.tiny)

// ------------------------------------------- TABLEAU : L'ÉCOSYSTÈME EN DIRECT
expoActu = strategy.position_size * close / strategy.equity
pousseTxt = (fCible >= 0 ? "+" : "") + str.tostring(100 * fCible, "#.#") + " % / " + (expoActu >= 0 ? "+" : "") + str.tostring(100 * expoActu, "#.#") + " %"
pousseCol = fCible > 0.01 ? color.new(color.teal, 70) : fCible < -0.01 ? color.new(color.red, 70) : color.new(color.gray, 85)
winRate = strategy.closedtrades > 0 ? 100.0 * strategy.wintrades / strategy.closedtrades : 0.0
pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
desert = timeframe.in_seconds() < 14400
diagTxt = eteint ? "☠ ÉTEINT : plancher de survie franchi, plus aucune exposition" : not ready ? "amorçage : encore " + str.tostring(math.max(0, 301 - bar_index)) + " bougies" : desert ? "⚠ DÉSERT : frais > proies sur cette unité de temps — passez en 1D" : vivantes == 0 ? "extinction : tout le monde à l'abri" : math.abs(dirS) < proieMin ? "meute à l'affût : proie trop maigre (conviction " + str.tostring(100 * math.abs(dirS), "#") + " % < " + str.tostring(100 * proieMin, "#") + " %)" : str.tostring(vivantes) + "/8 vivantes · " + str.tostring(naissances) + " naissances · la meute charge, cap " + (dir > 0.05 ? "haussier" : dir < -0.05 ? "baissier" : "neutre")
alphaNom = (bestFit == fit1 ? "Guépard " + str.tostring(L1) : bestFit == fit2 ? "Loup " + str.tostring(L2) : bestFit == fit3 ? "Ours " + str.tostring(L3) : bestFit == fit4 ? "Éléphant " + str.tostring(L4) : bestFit == fit5 ? "Baleine " + str.tostring(L5) : bestFit == fit6 ? "Colibri " + str.tostring(L6) : bestFit == fit7 ? "Renard " + str.tostring(L7) : "Chouette " + str.tostring(L8)) + "b · forme " + str.tostring(10000 * bestFit, "#.#") + " pb" + (bestFit > 0 ? " — il mange le premier" : " — toute la meute a faim")
diagCol = eteint ? color.new(color.red, 60) : ready and not desert and vivantes > 0 ? color.new(color.teal, 70) : color.new(color.orange, 80)
fondTxt = (fond > 0 ? "haussière ▲" : "baissière ▼") + (respectFond ? " · shorts " + (fond > 0 ? "interdits" : "autorisés") : " · filtre désactivé") + " · contrariennes " + str.tostring(wTot > 0 ? 100 * (w6 + w7 + w8) / wTot : 0, "#") + " % (max " + str.tostring(contMax, "#") + " %)"
immTxt = immun > 0 ? "BOUCLIER : convalescence " + str.tostring(immun, "#") + " bougies" : "au repos, seuil " + str.tostring(chocSeuil, "#.#") + " écarts-types"
immCol = immun > 0 ? color.new(color.red, 70) : color.new(color.gray, 85)
e1 = "Guépard " + str.tostring(L1) + "b g" + str.tostring(g1) + " " + (sig1 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit1, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w1 / wTot : 0, "#") + " %"
e2 = "Loup " + str.tostring(L2) + "b g" + str.tostring(g2) + " " + (sig2 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit2, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w2 / wTot : 0, "#") + " %"
e3 = "Ours " + str.tostring(L3) + "b g" + str.tostring(g3) + " " + (sig3 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit3, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w3 / wTot : 0, "#") + " %"
e4 = "Éléphant " + str.tostring(L4) + "b g" + str.tostring(g4) + " " + (sig4 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit4, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w4 / wTot : 0, "#") + " %"
e5 = "Baleine " + str.tostring(L5) + "b g" + str.tostring(g5) + " " + (sig5 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit5, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w5 / wTot : 0, "#") + " %"
e6 = "Colibri " + str.tostring(L6) + "b g" + str.tostring(g6) + " " + (sig6 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit6, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w6 / wTot : 0, "#") + " %"
e7 = "Renard " + str.tostring(L7) + "b g" + str.tostring(g7) + " " + (sig7 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit7, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w7 / wTot : 0, "#") + " %"
e8 = "Chouette " + str.tostring(L8) + "b g" + str.tostring(g8) + " " + (sig8 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit8, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w8 / wTot : 0, "#") + " %"
c1c = fit1 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c2c = fit2 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c3c = fit3 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c4c = fit4 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c5c = fit5 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c6c = fit6 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c7c = fit7 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
c8c = fit8 > 0 ? color.new(color.teal, 80) : color.new(color.gray, 88)
tempTxt = str.tostring(100 * dd, "#.#") + " % de perte depuis le sommet · " + (torpeur >= 0.99 ? "métabolisme normal" : torpeur > 0.5 ? "fièvre : poussée réduite à " + str.tostring(100 * torpeur, "#") + " %" : torpeur > 0 ? "torpeur profonde : " + str.tostring(100 * torpeur, "#") + " %" : "HIBERNATION (guérison en cours)")
tempCol = torpeur >= 0.99 ? color.new(color.teal, 80) : torpeur > 0.5 ? color.new(color.orange, 75) : color.new(color.red, 70)

var table info = table.new(position.top_right, 2, 20, border_width = 1)
table.cell(info, 0, 19, "Le lion (alpha, part ^" + str.tostring(hierarchie, "#.#") + ")", text_size = size.small, bgcolor = color.new(color.orange, 75))
table.cell(info, 1, 19, alphaNom, text_size = size.small, bgcolor = color.new(color.orange, 85))
table.cell(info, 0, 18, "Tendance de fond (252 bougies)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 18, fondTxt, text_size = size.small, bgcolor = color.new(color.blue, 85))
table.cell(info, 0, 0, "État de l'écosystème", text_size = size.small, bgcolor = color.new(color.orange, 80))
table.cell(info, 1, 0, diagTxt, text_size = size.small, bgcolor = diagCol)
table.cell(info, 0, 1, "Exposition cible / réelle", text_size = size.small, bgcolor = color.new(color.blue, 80))
table.cell(info, 1, 1, pousseTxt, text_size = size.small, bgcolor = pousseCol)
table.cell(info, 0, 2, "Espèce (rythme · génération · forme · part)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 2, "vivante = verte, affamée = grise", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 0, 3, "Tendance", text_size = size.small, bgcolor = c1c)
table.cell(info, 1, 3, e1, text_size = size.small, bgcolor = c1c)
table.cell(info, 0, 4, "Tendance", text_size = size.small, bgcolor = c2c)
table.cell(info, 1, 4, e2, text_size = size.small, bgcolor = c2c)
table.cell(info, 0, 5, "Tendance", text_size = size.small, bgcolor = c3c)
table.cell(info, 1, 5, e3, text_size = size.small, bgcolor = c3c)
table.cell(info, 0, 6, "Tendance", text_size = size.small, bgcolor = c4c)
table.cell(info, 1, 6, e4, text_size = size.small, bgcolor = c4c)
table.cell(info, 0, 7, "Tendance", text_size = size.small, bgcolor = c5c)
table.cell(info, 1, 7, e5, text_size = size.small, bgcolor = c5c)
table.cell(info, 0, 8, "Contraire", text_size = size.small, bgcolor = c6c)
table.cell(info, 1, 8, e6, text_size = size.small, bgcolor = c6c)
table.cell(info, 0, 9, "Contraire", text_size = size.small, bgcolor = c7c)
table.cell(info, 1, 9, e7, text_size = size.small, bgcolor = c7c)
table.cell(info, 0, 10, "Contraire", text_size = size.small, bgcolor = c8c)
table.cell(info, 1, 10, e8, text_size = size.small, bgcolor = c8c)
table.cell(info, 0, 11, "Système immunitaire", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 11, immTxt, text_size = size.small, bgcolor = immCol)
table.cell(info, 0, 12, "État civil (naissances / doyenne)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 12, str.tostring(naissances) + " naissances · doyenne " + str.tostring(doyenne) + " bougies", text_size = size.small)
table.cell(info, 0, 13, "Volatilité réalisée → levier", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 13, str.tostring(100 * sigA, "#.#") + " % → ×" + str.tostring(levVol, "#.##"), text_size = size.small)
table.cell(info, 0, 14, "Trades / réussite", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 14, str.tostring(strategy.closedtrades) + " / " + str.tostring(winRate, "#.#") + " %", text_size = size.small)
table.cell(info, 0, 15, "Profit factor", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 15, na(pf) ? "—" : str.tostring(pf, "#.##"), text_size = size.small)
table.cell(info, 0, 16, "Profit net", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 16, str.tostring(strategy.netprofit, "#.##"), text_size = size.small)
table.cell(info, 0, 17, "Température (perte / borne " + str.tostring(ddMax, "#") + " %)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 17, tempTxt, text_size = size.small, bgcolor = tempCol)

// ------- CORRECTIONS DE POUSSÉE (les 2 seules lignes indentées, fin du fichier)
if doPlus
    strategy.order("Pousse+", strategy.long, qty = diffQty, comment = "cap " + str.tostring(100 * fCible, "#") + "%", alert_message = "Darwin HAUSSE exposition vers " + str.tostring(100 * fCible, "#.#") + "% " + syminfo.ticker)
if doMoins
    strategy.order("Pousse-", strategy.short, qty = -diffQty, comment = "cap " + str.tostring(100 * fCible, "#") + "%", alert_message = "Darwin BAISSE exposition vers " + str.tostring(100 * fCible, "#.#") + "% " + syminfo.ticker)
