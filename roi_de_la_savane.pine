[mo17, vo17] = request.security(sym17, timeframe.period, [close / nz(close[252], close) - 1, ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(252)])
[mo18, vo18] = request.security(sym18, timeframe.period, [close / nz(close[252], close) - 1, ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(252)])
[mo19, vo19] = request.security(sym19, timeframe.period, [close / nz(close[252], close) - 1, ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(252)])
[mo20, vo20] = request.security(sym20, timeframe.period, [close / nz(close[252], close) - 1, ta.stdev(math.log(close / nz(close[1], close)), 63) * math.sqrt(252)])
sc11 = nz(vo11, 0) > 0 ? math.abs(nz(mo11, 0)) / vo11 : 0.0
sc12 = nz(vo12, 0) > 0 ? math.abs(nz(mo12, 0)) / vo12 : 0.0
sc13 = nz(vo13, 0) > 0 ? math.abs(nz(mo13, 0)) / vo13 : 0.0
sc14 = nz(vo14, 0) > 0 ? math.abs(nz(mo14, 0)) / vo14 : 0.0
sc15 = nz(vo15, 0) > 0 ? math.abs(nz(mo15, 0)) / vo15 : 0.0
sc16 = nz(vo16, 0) > 0 ? math.abs(nz(mo16, 0)) / vo16 : 0.0
sc17 = nz(vo17, 0) > 0 ? math.abs(nz(mo17, 0)) / vo17 : 0.0
sc18 = nz(vo18, 0) > 0 ? math.abs(nz(mo18, 0)) / vo18 : 0.0
sc19 = nz(vo19, 0) > 0 ? math.abs(nz(mo19, 0)) / vo19 : 0.0
sc20 = nz(vo20, 0) > 0 ? math.abs(nz(mo20, 0)) / vo20 : 0.0
scBest = math.max(sc1, math.max(sc2, math.max(sc3, math.max(sc4, math.max(sc5, math.max(sc6, math.max(sc7, math.max(sc8, math.max(sc9, math.max(sc10, math.max(sc11, math.max(sc12, math.max(sc13, math.max(sc14, math.max(sc15, math.max(sc16, math.max(sc17, math.max(sc18, math.max(sc19, sc20)))))))))))))))))))
savBest = scBest == sc1 ? sym1 : scBest == sc2 ? sym2 : scBest == sc3 ? sym3 : scBest == sc4 ? sym4 : scBest == sc5 ? sym5 : scBest == sc6 ? sym6 : scBest == sc7 ? sym7 : scBest == sc8 ? sym8 : scBest == sc9 ? sym9 : scBest == sc10 ? sym10 : scBest == sc11 ? sym11 : scBest == sc12 ? sym12 : scBest == sc13 ? sym13 : scBest == sc14 ? sym14 : scBest == sc15 ? sym15 : scBest == sc16 ? sym16 : scBest == sc17 ? sym17 : scBest == sc18 ? sym18 : scBest == sc19 ? sym19 : sym20
// LE BASCULEMENT : la cible de migration OFFICIELLE, avec hystérésis.
// savBest clignote au gré des scores du jour ; migCible ne bascule que
// si un territoire dépasse la cible en titre de 15 % — un vrai passage
// de couronne, pas une humeur. Chaque basculement déclenche l'alerte.
var string migCible = ""
scMig = migCible == sym1 ? sc1 : migCible == sym2 ? sc2 : migCible == sym3 ? sc3 : migCible == sym4 ? sc4 : migCible == sym5 ? sc5 : migCible == sym6 ? sc6 : migCible == sym7 ? sc7 : migCible == sym8 ? sc8 : migCible == sym9 ? sc9 : migCible == sym10 ? sc10 : migCible == sym11 ? sc11 : migCible == sym12 ? sc12 : migCible == sym13 ? sc13 : migCible == sym14 ? sc14 : migCible == sym15 ? sc15 : migCible == sym16 ? sc16 : migCible == sym17 ? sc17 : migCible == sym18 ? sc18 : migCible == sym19 ? sc19 : migCible == sym20 ? sc20 : 0.0
bascule = barstate.isconfirmed and ready and savBest != migCible and (migCible == "" or scBest > scMig * 1.15)
migCible := bascule ? savBest : migCible

// ============================================================================
// L'ESSAIM : LES INSECTES SENTINELLES
// Ils ne chassent jamais (les frais tueraient tout insecte-chasseur — leçon
// du désert) : ils écoutent le sol et préviennent la colonie, gratuitement.
// ============================================================================
// LES FOURMIS — l'orage qui vient : bruit court rapporté au bruit de fond.
sdCourt = ta.stdev(v, 10)
sdLong = ta.stdev(v, 100)
orage = sdLong > 0 ? sdCourt / sdLong : 1.0
fourmisAlerte = ready and orage > 1.5
// LES ABEILLES — la tempête systémique : quand les 20 savanes tremblent
// ensemble, la diversification meurt au moment où l'on en a besoin.
ruche = (nz(vo1, 0) + nz(vo2, 0) + nz(vo3, 0) + nz(vo4, 0) + nz(vo5, 0) + nz(vo6, 0) + nz(vo7, 0) + nz(vo8, 0) + nz(vo9, 0) + nz(vo10, 0) + nz(vo11, 0) + nz(vo12, 0) + nz(vo13, 0) + nz(vo14, 0) + nz(vo15, 0) + nz(vo16, 0) + nz(vo17, 0) + nz(vo18, 0) + nz(vo19, 0) + nz(vo20, 0)) / 20
rucheMoy = ta.sma(ruche, 252)
abeillesAlerte = ready and rucheMoy > 0 and ruche > 1.4 * rucheMoy
// LES TERMITES — la santé du sol : proportion de mèches dans les bougies.
// Un sol plein de mèches est un sol où les stops glissent (slippage réel).
meches = ta.sma((high - low - math.abs(close - open)) / math.max(high - low, syminfo.mintick), 50)
solTraitre = meches > 0.55
// LES SAISONS — la nuit des résultats : la date de la prochaine annonce
// est fournie par TradingView (actions seulement, na ailleurs).
prochaineAnnonce = earnings.future_time
abriSaison = saisonsOn and not na(prochaineAnnonce) and prochaineAnnonce >= time and prochaineAnnonce - time <= joursAbri * 86400000

// ============================================================================
// TENDANCE DE FOND : ON NE CHASSE JAMAIS CONTRE LA DÉRIVE LONGUE DE L'ACTIF
// ============================================================================
fond = close > nz(close[252], close) ? 1 : -1

// ============================================================================
// LA CHARGE DU LION : DÉCISION FINALE (toutes les jauges multipliées)
// ============================================================================
dirS = ta.sma(dir, respire)
dirChasse = math.abs(dirS) >= proieMin ? dirS : 0.0
fCible = ready and inDate and not eteint ? dirChasse * levVol * torpeur * bouclier : 0.0
fCible := enableLongs or fCible < 0 ? fCible : 0.0
fCible := enableShorts or fCible > 0 ? fCible : 0.0
fCible := respectFond and fCible * fond < 0 ? 0.0 : fCible
fCible := savaneOk ? fCible : 0.0
fCible := pacteAbri ? 0.0 : fCible
// L'essaim et les anticorps ne mordent que si le souverain les a armés :
// par défaut ces trois lignes ne changent rien (garantie de la G8).
fCible := fourmisOn and fourmisAlerte ? fCible * 0.7 : fCible
fCible := abeillesOn and abeillesAlerte ? fCible * 0.7 : fCible
fCible := immAcqOn ? fCible * immAcqF : fCible
fCible := abriSaison ? 0.0 : fCible

// ============================================================================
// CORRECTION : RÉÉQUILIBRAGE AVEC ZONE MORTE ET RESPIRATION
// ============================================================================
qtyCible = fCible * strategy.equity / close
diffQty = qtyCible - strategy.position_size
seuilQty = math.max(rebalPct / 100 * math.abs(qtyCible), 0.02 * strategy.equity / close)
souffle = bar_index % respire == 0
doPlus = barstate.isconfirmed and souffle and diffQty > seuilQty
doMoins = barstate.isconfirmed and souffle and -diffQty > seuilQty

// ============================================================================
// AFFICHAGE SUR LE GRAPHIQUE
// ============================================================================
bgcolor(not ready ? na : not savaneOk ? color.new(color.orange, 92) : vivantes == 0 ? color.new(color.red, 90) : dir > 0.2 ? color.new(color.teal, 94) : dir < -0.2 ? color.new(color.red, 94) : na)
plotshape(doPlus, "Poussée haussière", shape.triangleup, location.belowbar, color.new(color.teal, 0), size = size.tiny)
plotshape(doMoins, "Poussée baissière", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.tiny)
plotshape(naissance, "Naissance d'une espèce", shape.diamond, location.bottom, color.new(color.purple, 0), size = size.tiny)
plotshape(choc, "Choc immunitaire", shape.xcross, location.top, color.new(color.red, 0), size = size.tiny)

// ============================================================================
// LE POSTE DE COMMANDEMENT : TABLEAU COMPLET
// ============================================================================
expoActu = strategy.position_size * close / strategy.equity
// L'EAU : le loyer du levier. Comptabilité pure — n'agit pas sur les ordres,
// mais rend le profit honnête : toute force empruntée se paie chaque nuit.
var float eauCum = 0.0
eauCum := barstate.isconfirmed ? eauCum + math.abs(expoActu) * (swapAnnuel / 100) * (timeframe.in_seconds() / 31536000.0) * strategy.equity : eauCum
// LE MIROIR : le présent tient-il la promesse du passé ? Gain de la fenêtre
// récente contre le rythme moyen de toute l'histoire, par fenêtre égale.
retPresent = strategy.equity / math.max(nz(strategy.equity[miroirWin], strategy.initial_capital), 1e-9) - 1
nFen = math.max(1.0, (bar_index - 300.0) / miroirWin)
retRythme = math.pow(math.max(strategy.equity / strategy.initial_capital, 1e-9), 1.0 / nFen) - 1
decroche = ready and strategy.closedtrades > 10 and retPresent < retRythme - 0.10
pousseTxt = (fCible >= 0 ? "+" : "") + str.tostring(100 * fCible, "#.#") + " % / " + (expoActu >= 0 ? "+" : "") + str.tostring(100 * expoActu, "#.#") + " %"
pousseCol = fCible > 0.01 ? color.new(color.teal, 70) : fCible < -0.01 ? color.new(color.red, 70) : color.new(color.gray, 85)
winRate = strategy.closedtrades > 0 ? 100.0 * strategy.wintrades / strategy.closedtrades : 0.0
pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
desert = timeframe.in_seconds() < 14400
diagTxt = eteint ? "☠ ÉTEINT : plancher de survie franchi, plus aucune exposition" : pacteAbri ? "l'Homme a ordonné l'abri — la savane attend son retour" : not ready ? "amorçage : encore " + str.tostring(math.max(0, 301 - bar_index)) + " bougies" : desert ? "⚠ DÉSERT : frais > proies sur cette unité de temps — passez en 1D" : not savaneOk ? "savane locale stérile — le roi conseille de migrer vers " + (migCible == "" ? savBest : migCible) : vivantes == 0 ? "extinction : tout le monde à l'abri" : math.abs(dirS) < proieMin ? "meute à l'affût : proie trop maigre (conviction " + str.tostring(100 * math.abs(dirS), "#") + " % < " + str.tostring(100 * proieMin, "#") + " %)" : str.tostring(vivantes) + "/17 vivantes · " + str.tostring(naissances) + " naissances · la meute charge, cap " + (dir > 0.05 ? "haussier" : dir < -0.05 ? "baissier" : "neutre")
diagCol = eteint ? color.new(color.red, 60) : ready and not desert and savaneOk and vivantes > 0 ? color.new(color.teal, 70) : color.new(color.orange, 80)
alphaNom = (bestFit == fit1 ? "Guépard " + str.tostring(L1) : bestFit == fit2 ? "Loup " + str.tostring(L2) : bestFit == fit3 ? "Ours " + str.tostring(L3) : bestFit == fit4 ? "Éléphant " + str.tostring(L4) : bestFit == fit5 ? "Baleine " + str.tostring(L5) : bestFit == fit6 ? "Colibri " + str.tostring(L6) : bestFit == fit7 ? "Renard " + str.tostring(L7) : bestFit == fit8 ? "Chouette " + str.tostring(L8) : bestFit == fit9 ? "Aigle 252" : bestFit == fit10 ? "Crocodile 55" : bestFit == fit11 ? "Hyène 20" : bestFit == fit12 ? "Panthère " + str.tostring(L12) : bestFit == fit13 ? "Lynx " + str.tostring(L13) : bestFit == fit14 ? "Bison " + str.tostring(L14) : bestFit == fit15 ? "Serpent " + str.tostring(L15) : bestFit == fit16 ? "Vautour 40" : "Albatros 252") + "b · forme " + str.tostring(10000 * bestFit, "#.#") + " pb" + (bestFit > 0 ? " — il mange le premier" : " — toute la meute a faim")
fondTxt = (fond > 0 ? "haussière ▲" : "baissière ▼") + (respectFond ? " · shorts " + (fond > 0 ? "interdits" : "autorisés") : " · filtre désactivé") + " · contrariennes " + str.tostring(wTot > 0 ? 100 * (w6 + w7 + w8) / wTot : 0, "#") + " % (max " + str.tostring(contMax, "#") + " %)"
immTxt = immun > 0 ? "BOUCLIER : convalescence " + str.tostring(immun, "#") + " bougies" : "au repos, seuil " + str.tostring(chocSeuil, "#.#") + " écarts-types"
immCol = immun > 0 ? color.new(color.red, 70) : color.new(color.gray, 85)
meteoTxt = "score " + str.tostring(scoreLocal, "#.##") + " (min " + str.tostring(savaneMin, "#.##") + ") · entropie " + str.tostring(100 * entropie, "#.#") + " %" + (savaneOk ? " ✓ propice à la chasse" : " ✗ stérile")
meteoCol = savaneOk ? color.new(color.teal, 70) : color.new(color.orange, 70)
e1 = "Guépard " + str.tostring(L1) + "b g" + str.tostring(g1) + " " + (sig1 > 0 ? "▲" : "▼") + " · " + str.tostring(10000 * fit1, "#.#") + " pb · " + str.tostring(wTot > 0 ? 100 * w1 / wTot : 0, "#") + " %"
