//@version=6
// ============================================================================
// APPRENTISSAGE DE MOTIFS — Moteur de probabilités conditionnelles
// ----------------------------------------------------------------------------
// Compatible TradingView (Pine Script v6)
//
// Mécanisme original conçu pour cette stratégie : un moteur d'apprentissage
// EN DIRECT, dans le script lui-même. Aucun indicateur classique.
//
// Comment elle "apprend" :
//   1) À chaque bougie, elle encode la configuration des N dernières bougies
//      (suite de hausses/baisses) en un "motif" (ex : ▲▼▲▲).
//   2) Elle tient une mémoire par motif : combien de fois ce motif est
//      apparu SUR CET ACTIF, et combien de fois la bougie suivante a monté.
//      La mémoire est à oubli exponentiel : les observations récentes
//      pèsent plus, la stratégie s'adapte si le marché change.
//   3) Avant de trader, elle exige une SIGNIFICATIVITÉ STATISTIQUE : la
//      probabilité observée doit s'écarter de 50 % au-delà du bruit
//      d'échantillonnage (test z sur proportion). Un motif vu 5 fois ne
//      suffit jamais ; un biais faible sur 100 observations non plus.
//   4) Pas de biais significatif dans l'historique de CET actif → à plat.
//
// Conséquence : posée sur deux marchés différents, elle ne se comporte pas
// pareil — elle a appris des habitudes différentes. Elle ne suit pas une
// règle écrite d'avance : elle construit la sienne à partir des données.
//
// HONNÊTETÉ OBLIGATOIRE : "apprendre le passé" n'est pas "prédire l'avenir".
// Les habitudes d'un marché peuvent disparaître (c'est pour cela qu'il y a
// l'oubli exponentiel, le test de significativité et un stop sur chaque
// trade). Backtestez sur votre actif/unité de temps, validez en paper
// trading avant tout argent réel. Méfiez-vous du sur-apprentissage : plus
// le motif est long, plus il faut d'historique pour que ce soit fiable.
// ============================================================================

strategy("Apprentissage de Motifs [Probabilités conditionnelles]",
     shorttitle   = "Motifs Apprenants",
     overlay      = true,
     initial_capital        = 10000,
     currency               = currency.EUR,
     commission_type        = strategy.commission.percent,
     commission_value       = 0.05,
     slippage               = 2,
     calc_on_every_tick     = false,
     process_orders_on_close = true,
     pyramiding             = 0)

// ----------------------------------------------------------------------------
// PARAMÈTRES
// ----------------------------------------------------------------------------
grpDir = "Direction"
enableLongs  = input.bool(true,  "Autoriser les achats (long)",  group = grpDir)
enableShorts = input.bool(false, "Autoriser les ventes (short)", group = grpDir)

grpLearn = "Moteur d'apprentissage"
patLen = input.int(4, "Longueur du motif (bougies)", minval = 2, maxval = 8, group = grpLearn,
     tooltip = "4 bougies = 16 motifs possibles. Plus c'est long, plus c'est précis mais plus il faut d'historique.")
memLambda = input.float(0.99, "Facteur de mémoire (oubli exponentiel)", minval = 0.90, maxval = 0.999, step = 0.001, group = grpLearn,
     tooltip = "0.99 ≈ mémoire effective d'environ 100 occurrences par motif. Plus proche de 1 = mémoire plus longue.")
minObs = input.float(30, "Observations minimales par motif", minval = 5, group = grpLearn)
zThresh = input.float(1.6, "Significativité requise (z)", minval = 0.5, step = 0.1, group = grpLearn,
     tooltip = "1.6 ≈ 90 % de confiance que le biais observé n'est pas du hasard. 2.0 ≈ 95 %.")

grpRisk = "Gestion du risque"
riskPct = input.float(1.0, "Risque par trade (% du capital)", minval = 0.1, maxval = 10, step = 0.1, group = grpRisk)
atrLen  = input.int(14, "Période ATR (stop)", minval = 1, group = grpRisk)
atrMult = input.float(2.0, "Multiplicateur ATR du stop", minval = 0.5, step = 0.1, group = grpRisk)

grpDate = "Période de backtest"
startDate = input.time(timestamp("1 Jan 2018 00:00 +0000"), "Début", group = grpDate)
endDate   = input.time(timestamp("1 Jan 2035 00:00 +0000"), "Fin",   group = grpDate)

// ----------------------------------------------------------------------------
// MÉMOIRE : un compteur d'occurrences et un compteur de hausses par motif
// ----------------------------------------------------------------------------
nPatterns = int(math.pow(2, patLen))
var array<float> obsCount = array.new_float(nPatterns, 0.0)   // occurrences (pondérées)
var array<float> upCount  = array.new_float(nPatterns, 0.0)   // hausses ensuite (pondérées)

// Encode le motif des `patLen` bougies se terminant à l'offset `off`
// (suite de hausses/baisses → identifiant entier unique)
patternId(int off) =>
    id = 0
    mult = 1
    for i = 0 to patLen - 1
        if close[off + i] > close[off + i + 1]
            id += mult
        mult *= 2
    id

// ----------------------------------------------------------------------------
// APPRENTISSAGE (à la clôture de chaque bougie, jamais en cours de bougie)
// ----------------------------------------------------------------------------
// Le motif qui précédait la bougie actuelle vient de révéler son issue :
// on met à jour la mémoire de CE motif (avec oubli exponentiel).
if bar_index > patLen + 1 and barstate.isconfirmed
    prevId = patternId(1)
    outcome = close > close[1] ? 1.0 : 0.0
    array.set(obsCount, prevId, array.get(obsCount, prevId) * memLambda + 1.0)
    array.set(upCount,  prevId, array.get(upCount,  prevId) * memLambda + outcome)

// ----------------------------------------------------------------------------
// LECTURE : que sait-on du motif ACTUEL sur cet actif ?
// ----------------------------------------------------------------------------
curId = bar_index > patLen ? patternId(0) : 0
nObs  = array.get(obsCount, curId)
pUp   = nObs > 0 ? array.get(upCount, curId) / nObs : 0.5
// Test z sur proportion : le biais observé dépasse-t-il le bruit du hasard ?
zStat = nObs > 0 ? (pUp - 0.5) / math.sqrt(0.25 / nObs) : 0.0

learned = nObs >= minObs
inDate  = time >= startDate and time <= endDate

longSignal  = enableLongs  and inDate and learned and zStat >  zThresh
shortSignal = enableShorts and inDate and learned and zStat < -zThresh

// ----------------------------------------------------------------------------
// TAILLE DE POSITION (risque fixe en % du capital)
// ----------------------------------------------------------------------------
atrVal   = ta.atr(atrLen)
stopDist = atrMult * atrVal
riskCash = strategy.equity * riskPct / 100
posSize  = stopDist > 0 ? riskCash / stopDist : 0.0

// ----------------------------------------------------------------------------
// ENTRÉES / SORTIES
// ----------------------------------------------------------------------------
if strategy.position_size == 0 and posSize > 0
    if longSignal
        strategy.entry("Long", strategy.long, qty = posSize,
             comment = "p=" + str.tostring(100 * pUp, "#.#") + "%",
             alert_message = "MotifsApprenants ACHAT " + syminfo.ticker + " p(hausse)=" + str.tostring(100 * pUp, "#.#") + "%")
        strategy.exit("Long SL", "Long", stop = close - stopDist,
             alert_message = "MotifsApprenants STOP LONG " + syminfo.ticker)
    else if shortSignal
        strategy.entry("Short", strategy.short, qty = posSize,
             comment = "p=" + str.tostring(100 * (1 - pUp), "#.#") + "%",
             alert_message = "MotifsApprenants VENTE " + syminfo.ticker + " p(baisse)=" + str.tostring(100 * (1 - pUp), "#.#") + "%")
        strategy.exit("Short SL", "Short", stop = close + stopDist,
             alert_message = "MotifsApprenants STOP SHORT " + syminfo.ticker)

// Sortie : dès que le motif courant ne montre plus d'avantage dans notre sens
if strategy.position_size > 0 and zStat <= 0
    strategy.close("Long", comment = "avantage disparu",
         alert_message = "MotifsApprenants SORTIE LONG " + syminfo.ticker)
if strategy.position_size < 0 and zStat >= 0
    strategy.close("Short", comment = "avantage disparu",
         alert_message = "MotifsApprenants SORTIE SHORT " + syminfo.ticker)

// ----------------------------------------------------------------------------
// AFFICHAGE
// ----------------------------------------------------------------------------
// Fond : intensité selon la force de l'avantage appris (teal = haussier,
// rouge = baissier, rien = pas d'avantage significatif)
edgeBg = learned and math.abs(zStat) > zThresh ?
     (zStat > 0 ? color.new(color.teal, 88) : color.new(color.red, 88)) : na
bgcolor(edgeBg)

plotshape(longSignal and strategy.position_size == 0,  "Signal achat", shape.triangleup,   location.belowbar, color.new(color.teal, 0), size = size.small)
plotshape(shortSignal and strategy.position_size == 0, "Signal vente", shape.triangledown, location.abovebar, color.new(color.red, 0),  size = size.small)

// ----------------------------------------------------------------------------
// TABLEAU : CE QUE LA STRATÉGIE A APPRIS + PERFORMANCE
// ----------------------------------------------------------------------------
patternStr() =>
    s = ""
    for i = 0 to patLen - 1
        s := (close[i] > close[i + 1] ? "▲" : "▼") + s
    s

var table info = table.new(position.top_right, 2, 8, border_width = 1)
if barstate.islast
    winRate = strategy.closedtrades > 0 ? 100 * strategy.wintrades / strategy.closedtrades : 0
    pf      = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    stateTxt = not learned ? "EN APPRENTISSAGE" : math.abs(zStat) > zThresh ? (zStat > 0 ? "BIAIS HAUSSIER" : "BIAIS BAISSIER") : "PAS D'AVANTAGE"
    stateCol = not learned ? color.new(color.orange, 70) : math.abs(zStat) > zThresh ? (zStat > 0 ? color.new(color.teal, 70) : color.new(color.red, 70)) : color.new(color.gray, 70)
    table.cell(info, 0, 0, "Motif actuel", text_size = size.small, bgcolor = color.new(color.gray, 85))
    table.cell(info, 1, 0, patternStr(), text_size = size.small)
    table.cell(info, 0, 1, "Verdict appris", text_size = size.small, bgcolor = stateCol)
    table.cell(info, 1, 1, stateTxt, text_size = size.small, bgcolor = stateCol)
    table.cell(info, 0, 2, "P(hausse) observée", text_size = size.small, bgcolor = color.new(color.gray, 85))
    table.cell(info, 1, 2, str.tostring(100 * pUp, "#.#") + " %", text_size = size.small)
    table.cell(info, 0, 3, "Observations (pondérées)", text_size = size.small, bgcolor = color.new(color.gray, 85))
    table.cell(info, 1, 3, str.tostring(nObs, "#.#"), text_size = size.small)
    table.cell(info, 0, 4, "Significativité (z)", text_size = size.small, bgcolor = color.new(color.gray, 85))
    table.cell(info, 1, 4, str.tostring(zStat, "#.##"), text_size = size.small)
    table.cell(info, 0, 5, "Trades clôturés", text_size = size.small, bgcolor = color.new(color.gray, 85))
    table.cell(info, 1, 5, str.tostring(strategy.closedtrades), text_size = size.small)
    table.cell(info, 0, 6, "Taux de réussite", text_size = size.small, bgcolor = color.new(color.gray, 85))
    table.cell(info, 1, 6, str.tostring(winRate, "#.#") + " %", text_size = size.small)
    table.cell(info, 0, 7, "Profit net", text_size = size.small, bgcolor = color.new(color.gray, 85))
    table.cell(info, 1, 7, str.tostring(strategy.netprofit, "#.##"), text_size = size.small)
