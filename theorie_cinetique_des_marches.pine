//@version=6
// ============================================================================
// THÉORIE CINÉTIQUE DES MARCHÉS — équation du mouvement du prix
//
// THÉORIE ORIGINALE (formulée ici, falsifiable) : le prix est un corps en
// mouvement. On ne prédit pas un corps en regardant sa trajectoire passée,
// mais en mesurant sa VITESSE, sa MASSE et les FORCES qui s'y appliquent.
//
// DÉFINITIONS (les trois grandeurs mesurées à chaque bougie) :
//   VITESSE  v(t) = rendement logarithmique de la bougie
//   MASSE    m(t) = volume échangé / |mouvement| — l'inertie : combien de
//            volume il faut pour déplacer le prix (marché lourd vs léger)
//   FORCE    F(t) = volume × (clôture − ouverture) / amplitude — l'effort
//            directionnel net des acheteurs contre les vendeurs
//
// ÉQUATION DU MOUVEMENT :   v(t+1) = γ·v(t) + β·F(t)/m(t)
//   γ (frottement/persistance) et β (efficacité de la force) ne sont PAS
//   des constantes universelles : chaque marché a sa physique, qui change.
//   Le robot les RÉ-ESTIME en continu par moindres carrés (fenêtre N),
//   puis INTÈGRE l'équation sur h bougies pour prédire la trajectoire —
//   comme un ordinateur de vol intègre l'équation du mouvement.
//
// PILOTAGE : exposition continue de Merton f* = prédiction/risque²,
// pondérée par la confiance statistique ET par l'auto-vérification (le
// robot note la corrélation entre ses prédictions passées et la réalité ;
// si sa physique cesse de coller au terrain, la poussée est coupée).
//
// STRUCTURE ANTI-COLLAGE : aucune boucle, aucune fonction utilisateur —
// les 2 seules lignes indentées sont les 2 dernières du fichier.
// HONNÊTETÉ : théorie inventée aujourd'hui, jugée par la télémétrie
// (fiabilité affichée + Strategy Tester), pas par la foi.
// ============================================================================

strategy("Théorie Cinétique des Marchés [v' = γ·v + β·F/m]", shorttitle = "Cinétique", overlay = true, initial_capital = 10000, currency = currency.EUR, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 2, calc_on_every_tick = false, process_orders_on_close = true, pyramiding = 99, margin_long = 5, margin_short = 5)

// ---------------------------------------------------------------- PARAMÈTRES
enableLongs = input.bool(true, "Autoriser les achats (long)", group = "Direction")
enableShorts = input.bool(true, "Autoriser les ventes (short)", group = "Direction")
h = input.int(5, "Horizon d'intégration (bougies)", minval = 1, maxval = 30, group = "Physique du marché")
nReg = input.int(250, "Fenêtre d'estimation de γ et β (bougies)", minval = 60, maxval = 1000, group = "Physique du marché", tooltip = "Les constantes physiques du marché (frottement γ, efficacité de force β) sont ré-estimées par moindres carrés sur cette fenêtre glissante.")
nMass = input.int(50, "Fenêtre de mesure de la masse (bougies)", minval = 10, group = "Physique du marché")
zPlein = input.float(1.5, "Pleine confiance à partir de z =", minval = 0.5, step = 0.1, group = "Décision", tooltip = "En dessous, la poussée est réduite en (z/zPlein)². Le pilote dose, il ne coupe pas.")
icPlein = input.float(0.10, "Pleine confiance à partir d'une fiabilité de", minval = 0.0, maxval = 0.5, step = 0.01, group = "Décision", tooltip = "Fiabilité = corrélation entre les prédictions passées du robot et les mouvements réels. En dessous de 0, poussée nulle : la physique estimée ne colle plus au terrain.")
kellyFrac = input.float(0.5, "Fraction de Merton utilisée (0.5 = prudence)", minval = 0.1, maxval = 1.0, step = 0.1, group = "Pilotage")
expoMax = input.float(3.0, "Exposition maximale (× capital)", minval = 0.5, maxval = 10, step = 0.5, group = "Pilotage")
riskCap = input.float(2.0, "Risque maximal par horizon (% du capital)", minval = 0.2, maxval = 10, step = 0.1, group = "Pilotage")
rebalPct = input.float(15.0, "Zone morte de rééquilibrage (% d'écart)", minval = 1, maxval = 50, step = 1, group = "Pilotage")

startDate = input.time(timestamp("1 Jan 2010 00:00 +0000"), "Début", group = "Période de backtest")
endDate = input.time(timestamp("1 Jan 2035 00:00 +0000"), "Fin", group = "Période de backtest")

inDate = time >= startDate and time <= endDate

// ------------------- MESURES : VITESSE, MASSE, FORCE (à chaque bougie)
v = math.log(close / nz(close[1], close))
rng = math.max(high - low, syminfo.mintick)
vol = nz(volume, 1.0)
force = vol * (close - open) / rng
inertie = math.max(ta.sma(vol, nMass), 1e-10) / math.max(ta.sma(math.abs(v), nMass), 1e-10)
acc = force / math.max(inertie, 1e-10)
ready = bar_index > nReg + h + 60

// --------- ESTIMATION DES CONSTANTES PHYSIQUES γ ET β (moindres carrés 2D)
// Régression glissante : v(t) sur v(t-1) et acc(t-1). Solution exacte du
// système 2x2 par covariances — le marché révèle sa propre physique.
x1 = v[1]
x2 = acc[1]
mx1 = ta.sma(x1, nReg)
mx2 = ta.sma(x2, nReg)
my = ta.sma(v, nReg)
c11 = ta.sma(x1 * x1, nReg) - mx1 * mx1
c22 = ta.sma(x2 * x2, nReg) - mx2 * mx2
c12 = ta.sma(x1 * x2, nReg) - mx1 * mx2
b1 = ta.sma(x1 * v, nReg) - mx1 * my
b2 = ta.sma(x2 * v, nReg) - mx2 * my
det = c11 * c22 - c12 * c12
gamma = det != 0 ? (b1 * c22 - b2 * c12) / det : 0.0
beta = det != 0 ? (c11 * b2 - c12 * b1) / det : 0.0
gammaC = math.max(-0.95, math.min(0.95, gamma))
resid = v - gamma * x1 - beta * x2
resSd = ta.stdev(resid, nReg)

// --------- ANTICIPATION : INTÉGRATION DE L'ÉQUATION DU MOUVEMENT SUR h
// Trajectoire cumulée : mouvement prévu = v·γ·G + β·a·G avec la somme
// géométrique G = (1 − γ^h) / (1 − γ) — l'élan s'amortit, la force propulse.
G = (1.0 - math.pow(gammaC, h)) / math.max(1.0 - gammaC, 0.05)
muH = v * gammaC * G + beta * acc * G
sigH = math.max(resSd, 1e-10) * math.sqrt(h)
cible = close * math.exp(muH)
z = muH / sigH

// --------- AUTO-VÉRIFICATION : LA PHYSIQUE COLLE-T-ELLE AU TERRAIN ?
realise = math.log(close / nz(close[h], close))
fiab = ta.correlation(muH[h], realise, nReg)
cIC = math.max(0.0, math.min(1.0, nz(fiab, 0.0) / math.max(icPlein, 0.01)))

// --------- DÉCISION : FRACTION DE MERTON × CONFIANCE × FIABILITÉ
fMerton = sigH > 0 ? muH / (sigH * sigH) : 0.0
confZ = math.min(1.0, (z / zPlein) * (z / zPlein))
fBrut = kellyFrac * fMerton * confZ * cIC
fRisk = sigH > 0 ? (riskCap / 100) / sigH : 0.0
fCap = math.min(expoMax, fRisk)
fCible = math.max(-fCap, math.min(fCap, fBrut))
fCible := enableLongs or fCible < 0 ? fCible : 0.0
fCible := enableShorts or fCible > 0 ? fCible : 0.0
fCible := inDate and ready ? fCible : 0.0

// --------- CORRECTION : RÉÉQUILIBRAGE VERS LA CIBLE (zone morte anti-frais)
qtyCible = fCible * strategy.equity / close
diffQty = qtyCible - strategy.position_size
seuilQty = math.max(rebalPct / 100 * math.abs(qtyCible), 0.02 * strategy.equity / close)
doPlus = barstate.isconfirmed and diffQty > seuilQty
doMoins = barstate.isconfirmed and -diffQty > seuilQty

// ------------------------------------------------------------------ AFFICHAGE
plot(ready ? cible : na, "Trajectoire prévue (décalée de +h)", color = color.new(color.purple, 0), linewidth = 1, style = plot.style_circles, offset = h)
bgcolor(ready and cIC > 0 ? color.new(color.teal, 95) : na)
plotshape(doPlus, "Poussée haussière", shape.triangleup, location.belowbar, color.new(color.teal, 0), size = size.tiny)
plotshape(doMoins, "Poussée baissière", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.tiny)

// ------------------------------------------- TABLEAU : POSTE DE PILOTAGE
delta = cible - close
expoActu = strategy.position_size * close / strategy.equity
predTxt = str.tostring(cible, format.mintick) + " (" + (delta >= 0 ? "+" : "") + str.tostring(100 * delta / close, "#.##") + " %)"
pousseTxt = (fCible >= 0 ? "+" : "") + str.tostring(100 * fCible, "#.#") + " % / " + (expoActu >= 0 ? "+" : "") + str.tostring(100 * expoActu, "#.#") + " %"
pousseCol = fCible > 0.01 ? color.new(color.teal, 70) : fCible < -0.01 ? color.new(color.red, 70) : color.new(color.gray, 85)
physTxt = "γ " + str.tostring(gammaC, "#.###") + "  β·a " + str.tostring(beta * acc * 10000, "#.##") + " pb"
fiabTxt = na(fiab) ? "en mesure..." : str.tostring(fiab, "#.###") + (cIC >= 1 ? " ✓ pleine" : cIC > 0 ? " ~ partielle" : " ✗ poussée coupée")
fiabCol = na(fiab) ? color.new(color.gray, 85) : cIC > 0 ? color.new(color.teal, 70) : color.new(color.red, 70)
winRate = strategy.closedtrades > 0 ? 100.0 * strategy.wintrades / strategy.closedtrades : 0.0
pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
diagTxt = not ready ? "amorçage : encore " + str.tostring(math.max(0, nReg + h + 61 - bar_index)) + " bougies" : cIC <= 0 ? "physique non fiable ici : le pilote attend" : math.abs(fCible) < 0.005 ? "trajectoire trop plate : poussée quasi nulle" : "pilotage actif"
diagCol = ready and cIC > 0 and math.abs(fCible) >= 0.005 ? color.new(color.teal, 70) : color.new(color.orange, 80)

var table info = table.new(position.top_right, 2, 11, border_width = 1)
table.cell(info, 0, 0, "État du pilote", text_size = size.small, bgcolor = color.new(color.orange, 80))
table.cell(info, 1, 0, diagTxt, text_size = size.small, bgcolor = diagCol)
table.cell(info, 0, 1, "Poussée cible / position réelle", text_size = size.small, bgcolor = color.new(color.blue, 80))
table.cell(info, 1, 1, pousseTxt, text_size = size.small, bgcolor = pousseCol)
table.cell(info, 0, 2, "Constantes physiques estimées", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 2, physTxt, text_size = size.small)
table.cell(info, 0, 3, "Fiabilité (préd. passées vs réel)", text_size = size.small, bgcolor = color.new(color.blue, 80))
table.cell(info, 1, 3, fiabTxt, text_size = size.small, bgcolor = fiabCol)
table.cell(info, 0, 4, "Vitesse actuelle", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 4, str.tostring(10000 * v, "#.#") + " pb/bougie", text_size = size.small)
table.cell(info, 0, 5, "Force nette de la bougie", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 5, force > 0 ? "acheteuse ▲" : force < 0 ? "vendeuse ▼" : "neutre", text_size = size.small)
table.cell(info, 0, 6, "Trajectoire prévue à +" + str.tostring(h), text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 6, predTxt, text_size = size.small)
table.cell(info, 0, 7, "Signification (z)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 7, str.tostring(z, "#.##"), text_size = size.small)
table.cell(info, 0, 8, "Trades / réussite", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 8, str.tostring(strategy.closedtrades) + " / " + str.tostring(winRate, "#.#") + " %", text_size = size.small)
table.cell(info, 0, 9, "Profit factor", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 9, na(pf) ? "—" : str.tostring(pf, "#.##"), text_size = size.small)
table.cell(info, 0, 10, "Profit net", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 10, str.tostring(strategy.netprofit, "#.##"), text_size = size.small)

// ------- CORRECTIONS DE POUSSÉE (les 2 seules lignes indentées, fin du fichier)
if doPlus
    strategy.order("Pousse+", strategy.long, qty = diffQty, comment = "cible " + str.tostring(100 * fCible, "#") + "%", alert_message = "Cinetique HAUSSE exposition vers " + str.tostring(100 * fCible, "#.#") + "% " + syminfo.ticker)
if doMoins
    strategy.order("Pousse-", strategy.short, qty = -diffQty, comment = "cible " + str.tostring(100 * fCible, "#") + "%", alert_message = "Cinetique BAISSE exposition vers " + str.tostring(100 * fCible, "#.#") + "% " + syminfo.ticker)
