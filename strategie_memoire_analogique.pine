//@version=6
// ============================================================================
// MÉMOIRE ANALOGIQUE — PILOTAGE CONTINU (guidage de fusée)
// Takens + Shannon + Merton/Kelly : du signal à la décision, en boucle fermée.
//
// PRINCIPE DU GUIDAGE : comme une fusée, le robot ne « parie » pas puis
// attend — il corrige sa poussée à CHAQUE bougie. L'exposition visée est
// la fraction de Merton (contrôle stochastique, 1969) :
//     f* = gain espéré / risque²   (μ/σ², recalculée en continu)
// pondérée par la confiance (expérience de l'état, significativité) et
// coupée si le marché est du bruit (Shannon). La position suit la cible :
// elle grossit quand la prévision se renforce, fond quand elle faiblit,
// s'inverse quand la mémoire change d'avis. Pas de stop qui claque : une
// correction permanente, avec une zone morte pour ne pas payer de frais
// sur des micro-ajustements.
//
// BOUCLE : 1) OBSERVER — état du marché sur 64 cases (3 directions,
// force, élan, volatilité). 2) PRÉDIRE — la mémoire par états (Takens
// discrétisé) donne moyenne, variance et effectif de « ce qui a suivi ».
// 3) DÉCIDER — fraction de Merton × confiance × filtre de Shannon.
// 4) CORRIGER — rééquilibrage de la position vers la cible.
// 5) APPRENDRE — chaque issue réelle met à jour la mémoire (oubli λ).
//
// STRUCTURE ANTI-COLLAGE : aucune boucle, aucune fonction utilisateur,
// aucun bloc — les 2 seules lignes indentées sont les 2 dernières.
// HONNÊTETÉ : de vraies mathématiques, pas une promesse de gain.
// ============================================================================

strategy("Mémoire Analogique — Pilotage Continu [Takens + Shannon + Merton]", shorttitle = "Pilotage Continu", overlay = true, initial_capital = 10000, currency = currency.EUR, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 2, calc_on_every_tick = false, process_orders_on_close = true, pyramiding = 99, margin_long = 5, margin_short = 5)

// ---------------------------------------------------------------- PARAMÈTRES
enableLongs = input.bool(true, "Autoriser les achats (long)", group = "Direction et décision")
enableShorts = input.bool(true, "Autoriser les ventes (short)", group = "Direction et décision")
tMin = input.float(1.5, "Pleine confiance à partir de t =", minval = 0.5, step = 0.1, group = "Direction et décision", tooltip = "En dessous, la poussée est réduite proportionnellement (t/tMin)² : signal faible = petite position, signal fort = pleine position. Le pilote dose, il ne coupe pas brutalement.")
essMin = input.float(30, "Pleine confiance à partir de N observations", minval = 5, step = 1, group = "Direction et décision", tooltip = "En dessous, la poussée est réduite proportionnellement à l'expérience de l'état actuel.")

h = input.int(5, "Horizon de prévision (bougies)", minval = 1, maxval = 30, group = "Mémoire par états (Takens)")
memLambda = input.float(0.999, "Facteur de mémoire (oubli)", minval = 0.95, maxval = 0.9999, step = 0.0005, group = "Mémoire par états (Takens)", tooltip = "0.999 = mémoire longue. Plus bas = adaptation plus rapide, usure des motifs oubliée plus vite.")
nVol = input.int(50, "Fenêtre de normalisation de volatilité", minval = 10, group = "Mémoire par états (Takens)")

wEnt = input.int(96, "Fenêtre d'entropie (bougies)", minval = 40, maxval = 300, group = "Ordre du marché (Shannon)")
entMax = input.float(0.985, "Entropie maximale tolérée (1 = filtre désactivé)", minval = 0.80, maxval = 1.0, step = 0.005, group = "Ordre du marché (Shannon)", tooltip = "Au-dessus du seuil, le marché est statistiquement du bruit : la poussée est coupée et la position fond vers zéro. Repère : le hasard pur mesure ~0.982 sur 96 bougies.")

kellyFrac = input.float(0.5, "Fraction de Merton utilisée (0.5 = prudence)", minval = 0.1, maxval = 1.0, step = 0.1, group = "Pilotage (Merton)")
expoMax = input.float(3.0, "Exposition maximale (× capital)", minval = 0.5, maxval = 20, step = 0.5, group = "Pilotage (Merton)", tooltip = "Plafond de la poussée, en multiples du capital. Le compte simulé autorise ×20 (marge 5 %) ; restez bien en dessous.")
riskCap = input.float(2.0, "Risque maximal par horizon (% du capital)", minval = 0.2, maxval = 10, step = 0.1, group = "Pilotage (Merton)", tooltip = "L'exposition est aussi plafonnée pour qu'une variation d'un écart-type sur h bougies ne coûte pas plus que ce pourcentage.")
rebalPct = input.float(15.0, "Zone morte de rééquilibrage (% d'écart)", minval = 1, maxval = 50, step = 1, group = "Pilotage (Merton)", tooltip = "On ne corrige la position que si elle s'écarte de la cible de plus de X % du capital investi visé — sinon les frais mangeraient les micro-ajustements.")

startDate = input.time(timestamp("1 Jan 2018 00:00 +0000"), "Début", group = "Période de backtest")
endDate = input.time(timestamp("1 Jan 2035 00:00 +0000"), "Fin", group = "Période de backtest")

inDate = time >= startDate and time <= endDate

// -------------------- OBSERVER : MOUVEMENTS NORMALISÉS (PLONGEMENT TAKENS)
r = math.log(close / nz(close[1], close))
sdS = ta.stdev(r, nVol)
rnS = sdS > 0 ? r / sdS : 0.0
outS = nz(sdS[h], 0.0) > 0 ? math.log(close / close[h]) / (sdS[h] * math.sqrt(h)) : 0.0
volLong = ta.stdev(r, 200)
elan = math.sum(r, 20)
ready = bar_index > 320

// --------------- ÉTAT DU MARCHÉ : 64 CASES (6 caractéristiques binaires)
sid = (rnS > 0 ? 1 : 0) + (rnS[1] > 0 ? 2 : 0) + (rnS[2] > 0 ? 4 : 0) + (math.abs(rnS) > 1 ? 8 : 0) + (elan > 0 ? 16 : 0) + (sdS > volLong ? 32 : 0)

// --------- APPRENDRE : MÉMOIRE PAR ÉTAT, MISE À JOUR CONTINUE (OUBLI λ)
var array<float> obsW = array.new_float(64, 0.0)
var array<float> sumO = array.new_float(64, 0.0)
var array<float> sumO2 = array.new_float(64, 0.0)
sidPast = nz(sid[h], 0)
upd = bar_index > 260 and barstate.isconfirmed ? 1.0 : 0.0
decayF = upd > 0 ? memLambda : 1.0
oPast = nz(outS, 0.0)
array.set(obsW, sidPast, array.get(obsW, sidPast) * decayF + upd)
array.set(sumO, sidPast, array.get(sumO, sidPast) * decayF + upd * oPast)
array.set(sumO2, sidPast, array.get(sumO2, sidPast) * decayF + upd * oPast * oPast)

// --------- PRÉDIRE : ISSUE MOYENNE, VARIANCE, SIGNIFICATIVITÉ DE L'ÉTAT
ess = array.get(obsW, sid)
m1 = ess > 0 ? array.get(sumO, sid) / ess : 0.0
vOut = ess > 0 ? math.max(array.get(sumO2, sid) / ess - m1 * m1, 0.0) : 0.0
sOut = math.sqrt(vOut)
seOut = ess > 1 and sOut > 0 ? sOut / math.sqrt(ess) : na
score = na(seOut) ? 0.0 : m1 / seOut
muH = m1 * sdS * math.sqrt(h)
sigH = math.max(sOut, 0.3) * sdS * math.sqrt(h)
cible = close * math.exp(muH)
zm = sOut > 0 ? m1 / sOut : 0.0
pWin = 1.0 / (1.0 + math.exp(-1.702 * zm))

// -------------------------- FILTRE : ENTROPIE DE SHANNON (ORDRE DU MARCHÉ)
up = close > close[1]
patId = (up ? 1 : 0) + (up[1] ? 2 : 0) + (up[2] ? 4 : 0)
c0 = math.sum(patId == 0 ? 1.0 : 0.0, wEnt)
c1 = math.sum(patId == 1 ? 1.0 : 0.0, wEnt)
c2 = math.sum(patId == 2 ? 1.0 : 0.0, wEnt)
c3 = math.sum(patId == 3 ? 1.0 : 0.0, wEnt)
c4 = math.sum(patId == 4 ? 1.0 : 0.0, wEnt)
c5 = math.sum(patId == 5 ? 1.0 : 0.0, wEnt)
c6 = math.sum(patId == 6 ? 1.0 : 0.0, wEnt)
c7 = math.sum(patId == 7 ? 1.0 : 0.0, wEnt)
tot = c0 + c1 + c2 + c3 + c4 + c5 + c6 + c7
t0 = c0 > 0 ? (c0 / tot) * math.log(c0 / tot) : 0.0
t1 = c1 > 0 ? (c1 / tot) * math.log(c1 / tot) : 0.0
t2 = c2 > 0 ? (c2 / tot) * math.log(c2 / tot) : 0.0
t3 = c3 > 0 ? (c3 / tot) * math.log(c3 / tot) : 0.0
t4 = c4 > 0 ? (c4 / tot) * math.log(c4 / tot) : 0.0
t5 = c5 > 0 ? (c5 / tot) * math.log(c5 / tot) : 0.0
t6 = c6 > 0 ? (c6 / tot) * math.log(c6 / tot) : 0.0
t7 = c7 > 0 ? (c7 / tot) * math.log(c7 / tot) : 0.0
entropie = tot > 0 ? -(t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7) / math.log(2.0) / 3.0 : 1.0
structure = ready and entropie <= entMax

// --------- DÉCIDER : FRACTION DE MERTON × CONFIANCE × FILTRE DE SHANNON
// f* = mu/sigma² (contrôle stochastique). Confiance = (t/tMin)² plafonné à 1
// × (N/essMin) plafonné à 1. Le tout borné par l'exposition max et le risque.
fMerton = sigH > 0 ? muH / (sigH * sigH) : 0.0
confT = math.min(1.0, (score / tMin) * (score / tMin))
confN = math.min(1.0, ess / essMin)
fBrut = kellyFrac * fMerton * confT * confN * (structure ? 1.0 : 0.0)
fRisk = sigH > 0 ? (riskCap / 100) / sigH : 0.0
fCap = math.min(expoMax, fRisk)
fCible = math.max(-fCap, math.min(fCap, fBrut))
fCible := enableLongs or fCible < 0 ? fCible : 0.0
fCible := enableShorts or fCible > 0 ? fCible : 0.0
fCible := inDate and ready ? fCible : 0.0

// --------- CORRIGER : RÉÉQUILIBRAGE VERS LA CIBLE (avec zone morte)
qtyCible = fCible * strategy.equity / close
diffQty = qtyCible - strategy.position_size
seuilQty = math.max(rebalPct / 100 * math.abs(qtyCible), 0.02 * strategy.equity / close)
doPlus = barstate.isconfirmed and diffQty > seuilQty
doMoins = barstate.isconfirmed and -diffQty > seuilQty

// ------------------------------------------------------------------ AFFICHAGE
plot(ready ? cible : na, "Prix prévu par la mémoire (décalé de +h)", color = color.new(color.purple, 0), linewidth = 1, style = plot.style_circles, offset = h)
bgcolor(structure ? color.new(color.teal, 94) : na)
plotshape(doPlus, "Poussée haussière", shape.triangleup, location.belowbar, color.new(color.teal, 0), size = size.tiny)
plotshape(doMoins, "Poussée baissière", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.tiny)

// ------------------------------------------- TABLEAU : LE POSTE DE PILOTAGE
delta = cible - close
expoActu = strategy.position_size * close / strategy.equity
predTxt = str.tostring(cible, format.mintick) + " (" + (delta >= 0 ? "+" : "") + str.tostring(100 * delta / close, "#.##") + " %)"
entTxt = str.tostring(100 * entropie, "#.#") + " %" + (structure ? " ✓ structuré" : " ✗ aléatoire → poussée nulle")
entCol = structure ? color.new(color.teal, 70) : color.new(color.red, 70)
pousseTxt = (fCible >= 0 ? "+" : "") + str.tostring(100 * fCible, "#.#") + " % / " + (expoActu >= 0 ? "+" : "") + str.tostring(100 * expoActu, "#.#") + " %"
pousseCol = fCible > 0.01 ? color.new(color.teal, 70) : fCible < -0.01 ? color.new(color.red, 70) : color.new(color.gray, 85)
confTxt = "t " + str.tostring(score, "#.##") + " → " + str.tostring(100 * confT, "#") + " %, N " + str.tostring(ess, "#") + " → " + str.tostring(100 * confN, "#") + " %"
etatTxt = (rnS[2] > 0 ? "▲" : "▼") + (rnS[1] > 0 ? "▲" : "▼") + (rnS > 0 ? "▲" : "▼") + (math.abs(rnS) > 1 ? " fort" : " calme") + (elan > 0 ? ", élan +" : ", élan -") + (sdS > volLong ? ", vol haute" : ", vol basse")
winRate = strategy.closedtrades > 0 ? 100.0 * strategy.wintrades / strategy.closedtrades : 0.0
pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
diagTxt = not ready ? "amorçage : encore " + str.tostring(math.max(0, 321 - bar_index)) + " bougies" : not structure ? "marché aléatoire (Shannon) : le pilote attend" : math.abs(fCible) < 0.005 ? "prévision trop faible : poussée quasi nulle" : "pilotage actif"
diagCol = ready and structure and math.abs(fCible) >= 0.005 ? color.new(color.teal, 70) : color.new(color.orange, 80)

var table info = table.new(position.top_right, 2, 12, border_width = 1)
table.cell(info, 0, 0, "État du pilote", text_size = size.small, bgcolor = color.new(color.orange, 80))
table.cell(info, 1, 0, diagTxt, text_size = size.small, bgcolor = diagCol)
table.cell(info, 0, 1, "Poussée cible / position réelle", text_size = size.small, bgcolor = color.new(color.blue, 80))
table.cell(info, 1, 1, pousseTxt, text_size = size.small, bgcolor = pousseCol)
table.cell(info, 0, 2, "État du marché (case " + str.tostring(sid) + "/63)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 2, etatTxt, text_size = size.small)
table.cell(info, 0, 3, "Entropie de Shannon (seuil " + str.tostring(100 * entMax, "#.#") + " %)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 3, entTxt, text_size = size.small, bgcolor = entCol)
table.cell(info, 0, 4, "Confiance (signal, expérience)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 4, confTxt, text_size = size.small)
table.cell(info, 0, 5, "P(hausse) selon la mémoire", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 5, str.tostring(100 * pWin, "#.#") + " %", text_size = size.small)
table.cell(info, 0, 6, "Prévision à +" + str.tostring(h) + " bougies", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 6, predTxt, text_size = size.small)
table.cell(info, 0, 7, "Fraction de Merton (μ/σ²)", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 7, str.tostring(fMerton, "#.##"), text_size = size.small)
table.cell(info, 0, 8, "Trades / réussite", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 8, str.tostring(strategy.closedtrades) + " / " + str.tostring(winRate, "#.#") + " %", text_size = size.small)
table.cell(info, 0, 9, "Profit factor", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 9, na(pf) ? "—" : str.tostring(pf, "#.##"), text_size = size.small)
table.cell(info, 0, 10, "Profit net", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 10, str.tostring(strategy.netprofit, "#.##"), text_size = size.small)
table.cell(info, 0, 11, "Exposition max / risque par horizon", text_size = size.small, bgcolor = color.new(color.gray, 85))
table.cell(info, 1, 11, "×" + str.tostring(expoMax, "#.#") + " / " + str.tostring(riskCap, "#.#") + " %", text_size = size.small)

// ------- CORRECTIONS DE POUSSÉE (les 2 seules lignes indentées, fin du fichier)
if doPlus
    strategy.order("Pousse+", strategy.long, qty = diffQty, comment = "cible " + str.tostring(100 * fCible, "#.#") + "%", alert_message = "PilotageContinu HAUSSE exposition vers " + str.tostring(100 * fCible, "#.#") + "% " + syminfo.ticker)
if doMoins
    strategy.order("Pousse-", strategy.short, qty = -diffQty, comment = "cible " + str.tostring(100 * fCible, "#.#") + "%", alert_message = "PilotageContinu BAISSE exposition vers " + str.tostring(100 * fCible, "#.#") + "% " + syminfo.ticker)
